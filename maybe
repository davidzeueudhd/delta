--[[
    GUI-TEST MIT COREGUI
    - Versucht, GUI in CoreGui zu erstellen
    - CoreGui wird oft nicht blockiert
]]

local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- GUI in CoreGui erstellen (statt PlayerGui)
local gui = Instance.new("ScreenGui")
gui.Name = "TestGUI"
gui.Parent = player:WaitForChild("PlayerGui")
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false

-- Haupt-Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 300, 0, 150)
frame.Position = UDim2.new(0.5, -150, 0.5, -75)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
frame.BackgroundTransparency = 0
frame.BorderSizePixel = 3
frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

-- Titel
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 50)
title.BackgroundTransparency = 1
title.Text = "🎯 COREGUI-TEST"
title.TextColor3 = Color3.fromRGB(0, 255, 0)
title.TextScaled = true
title.Font = Enum.Font.Bold
title.Parent = frame

-- Status
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 40)
status.Position = UDim2.new(0, 0, 0, 50)
status.BackgroundTransparency = 1
status.Text = "✅ CoreGui funktioniert!"
status.TextColor3 = Color3.fromRGB(255, 255, 255)
status.TextScaled = true
status.Font = Enum.Font.SourceSans
status.Parent = frame

-- Info
local info = Instance.new("TextLabel")
info.Size = UDim2.new(1, 0, 0, 30)
info.Position = UDim2.new(0, 0, 0, 90)
info.BackgroundTransparency = 1
info.Text = "Verschiebbar | Drücke F2 zum Schließen"
info.TextColor3 = Color3.fromRGB(150, 150, 150)
info.TextScaled = true
info.Font = Enum.Font.SourceSans
info.Parent = frame

-- F2 zum Schließen
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F2 then
        gui:Destroy()
    end
end)
