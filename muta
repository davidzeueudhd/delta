character = newChar
rootPart = character:WaitForChild("HumanoidRootPart")
print("✅ Respawned!")

-- ==============================
-- GRÜNER MARKER (bei dir)
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(5, 1, 5)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.2
    marker.Parent = Workspace
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 15
    glow.Brightness = 5
    
    game:GetService("Debris"):AddItem(marker, 30)
    return marker
end

-- ==============================
-- FAKE POSITION (100 STUDS)
-- ==============================
local fakePos = rootPart.Position + Vector3.new(100, 0, 100)
createMarker(fakePos, "🎯 ANDERE SEHEN DICH HIER")

-- ==============================
-- ECHTE MUTAGEN-METHODE (HOOK)
-- ==============================
local oldPosition = rootPart.Position
local fakeOffset = Vector3.new(100, 0, 100)  -- 100 Studs Versatz

-- Hook für CFrame
local hookCFrame = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "CFrame" and self == rootPart then
        return CFrame.new(oldPosition + fakeOffset)
    end
    return hookCFrame(self, key)
end)

-- Hook für Position
local hookPosition = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "Position" and self == rootPart then
        return oldPosition + fakeOffset
    end
    return hookPosition(self, key)
end)

-- Loop: Echte Position speichern und Fake senden
RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    oldPosition = rootPart.Position
end)

print("🔥 ECHTE MUTAGEN-METHODE LÄUFT!")
