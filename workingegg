local LocalPlayer = Players.LocalPlayer

-- ========== GESPEICHERTE EIER ==========
local SavedEggPosition = nil

-- ========== TELEPORT FUNKTION ==========
local function TeleportTo(pos)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    root.CFrame = CFrame.new(pos)
    return true
end

-- ========== EGG SETZEN ==========
local function SetEgg()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        SavedEggPosition = root.Position
        print("🥚 Ei gespeichert bei: " .. tostring(SavedEggPosition))
    end
end

-- ========== ZUM GESPEICHERTEN EI TELEPORTIEREN ==========
local function TeleportToSavedEgg()
    if not SavedEggPosition then
        print("❌ Kein Ei gespeichert! Geh zu einem Ei und klick 'SET EGG'.")
        return
    end
    TeleportTo(SavedEggPosition + Vector3.new(0, 2, 0))
    print("✅ Zum gespeicherten Ei teleportiert!")
end

-- ========== BASE SYSTEM ==========
local MyBase = nil

local function SetBase()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        MyBase = root.Position
        print("🏠 Base gesetzt bei: " .. tostring(MyBase))
    end
end

local function TeleportToBase()
    if not MyBase then
        print("❌ Base nicht gesetzt! Klick 'SET BASE' zuerst.")
        return
    end
    TeleportTo(MyBase + Vector3.new(0, 2, 0))
    print("🏠 Zur Base teleportiert!")
end

