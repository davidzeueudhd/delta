-- ============================================================
-- HILFSFUNKTIONEN
-- ============================================================

local function GetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function TeleportTo(pos)
    local root = GetRoot()
    if not root then return false end
    root.CFrame = CFrame.new(pos)
    return true
end

-- ============================================================
-- BESTES EI FINDEN (mit Biome-Fokus)
-- ============================================================

local function FindBestEgg()
    local root = GetRoot()
    if not root then return nil end
    
    local bestEgg = nil
    local bestScore = -math.huge
    local bestReason = ""

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            
            if not name:find("egg") and not name:find("nest") then
                goto continue
            end
            if name:find("treadmill") or name:find("laufband") then
                goto continue
            end
            
            local hasClick = obj:FindFirstChild("ClickDetector") ~= nil
            if not hasClick then
                goto continue
            end
            
            local score = 0
            local reason = "Normal"
            
            -- Biome-Bonus
            for i, biome in ipairs(CONFIG.TopBiomes) do
                if name:find(biome:lower()) then
                    score = score + (10 - i) * 100
                    reason = "Biome: " .. biome
                    break
                end
            end
            
            -- Raritäts-Bonus
            for keyword, points in pairs(CONFIG.RarityKeywords) do
                if name:find(keyword) then
                    score = score + points
                    reason = reason .. " + " .. keyword:upper()
                    break
                end
            end
            
            -- Value-Tag
            local valueTag = obj:FindFirstChild("Value")
            if valueTag and valueTag:IsA("IntValue") then
                score = score + valueTag.Value
                reason = reason .. " + Value:" .. valueTag.Value
            end
            
            -- Größen-Bonus
            if obj:IsA("BasePart") then
                local size = obj.Size
                score = score + (size.X * size.Y * size.Z) * 10
            end
            
            -- Entfernungs-Malus
            local dist = (obj.Position - root.Position).Magnitude
            score = score - math.floor(dist / 20)
            
            if name:find("nest") then
                score = score + 50
            end
            
            if score > bestScore then
                bestScore = score
                bestEgg = obj
                bestReason = reason
            end
            
            ::continue::
        end
    end
    
    if bestEgg then
        print("🥚 Bestes Ei: " .. bestEgg.Name .. " | " .. bestReason .. " | Score: " .. math.floor(bestScore))
    end
    
    return bestEgg
end

-- ============================================================
-- EIER EINSAMMELN (AUTOMATISCH)
-- ============================================================

local function GrabEgg(egg)
    if not egg or not egg:IsA("BasePart") then
        return false
    end
    
    local grabbed = false
    
    -- Methode 1: ClickDetector
    local clickDetector = egg:FindFirstChild("ClickDetector")
    if clickDetector then
        clickDetector:FireClick(LocalPlayer)
        grabbed = true
        print("✅ ClickDetector ausgelöst")
    end
    
    -- Methode 2: Touch (Character Teile berühren das Ei)
    if not grabbed then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
            grabbed = true
            print("✅ Touch ausgelöst")
        end
    end
    
    -- Methode 3: ProximityPrompt
    if not grabbed then
        local prompt = egg:FindFirstChild("ProximityPrompt")
        if prompt then
            prompt:InputHoldStart(LocalPlayer, Enum.UserInputType.MouseButton1)
            task.wait(0.2)
            prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            grabbed = true
            print("✅ ProximityPrompt ausgelöst")
        end
    end
    
    -- Methode 4: RemoteEvent (falls vorhanden)
    if not grabbed then
        local remote = game:GetService("ReplicatedStorage"):FindFirstChild("CollectEgg")
        if remote then
            remote:FireServer(egg)
            grabbed = true
            print("✅ RemoteEvent ausgelöst")
        end
    end
    
    return grabbed
end

-- ============================================================
-- BASE SYSTEM
-- ============================================================

local MyBase = nil
local BaseMarker = nil

local function SetBase()
    local root = GetRoot()
    if not root then return end
    MyBase = root.Position
    
    if BaseMarker then BaseMarker:Destroy() end
    
    local marker = Instance.new("Part")
    marker.Name = "BaseMarker"
    marker.Size = Vector3.new(6, 1, 6)
    marker.Position = MyBase
    marker.Anchored = true
    marker.CanCollide = false
    marker.Transparency = 0.2
    marker.Color = Color3.fromRGB(0, 255, 100)
    marker.Material = Enum.Material.Neon
    marker.Parent = workspace
    
    local glow = Instance.new("PointLight")
    glow.Color = Color3.fromRGB(0, 255, 100)
    glow.Brightness = 5
    glow.Range = 25
    glow.Parent = marker
    
    BaseMarker = marker
    print("🏠 Base gesetzt mit Marker!")
end

local function TeleportToBase()
    if not MyBase then
        print("❌ Base nicht gesetzt!")
        return false
    end
    return TeleportTo(MyBase + Vector3.new(0, 2, 0))
end

-- ============================================================
-- HAUPTFUNKTION: TELEPORT + EINSAMMELN + ZURÜCK
-- ============================================================

local function StealBestEgg()
    local egg = FindBestEgg()
    if not egg then
        print("❌ Kein Ei in Top-Biomen gefunden!")
        return false
    end
    
    print("🚀 Teleportiere zu: " .. egg.Name)
    local success = TeleportTo(egg.Position + Vector3.new(0, 2, 0))
    if not success then
        print("❌ Teleport fehlgeschlagen!")
        return false
    end
    
    -- Kurz warten, damit Charakter ankommt
    task.wait(0.3)
    
    -- Einsammeln versuchen
    print("🔄 Versuche Ei einzusammeln...")
    local grabbed = false
    for attempt = 1, CONFIG.GrabAttempts do
        if GrabEgg(egg) then
            grabbed = true
            print("✅ Ei eingesammelt (Versuch " .. attempt .. ")")
            break
        end
        task.wait(0.3)
    end
    
    if not grabbed then
        print("⚠️ Konnte Ei nicht automatisch einsammeln – bitte manuell klicken!")
    end
    
    -- Warten (konfigurierbare Verzögerung)
    print("⏳ Warte " .. CONFIG.AutoReturnDelay .. " Sekunde(n) vor Rückkehr...")
    task.wait(CONFIG.AutoReturnDelay)
    
    -- Zur Base teleportieren
    if MyBase then
        TeleportToBase()
        print("🏠 Zurück zur Base teleportiert!")
    else
        print("⚠️ Keine Base gesetzt – bleibe beim Ei.")
    end
    
    return true
end

-- ============================================================
-- AUTO-MODE (permanentes Scannen & Stehlen)
-- ============================================================

local autoMode = false
local autoConnection = nil
local isRunning = false

local function StartAutoMode()
    if autoConnection then
        autoConnection:Disconnect()
        autoConnection = nil
    end
    
    autoMode = true
    isRunning = false
    print("🔄 Auto-Mode AKTIVIERT!")
    print("📡 Ich suche permanent die besten Eier und stehle sie automatisch...")
    
    autoConnection = RunService.Heartbeat:Connect(function()
        if not autoMode then return end
        if isRunning then return end
        
        isRunning = true
        StealBestEgg()
        isRunning = false
    end)
end

local function StopAutoMode()
    autoMode = false
    if autoConnection then
        autoConnection:Disconnect()
        autoConnection = nil
    end
    print("⏹️ Auto-Mode DEAKTIVIERT!")
end

