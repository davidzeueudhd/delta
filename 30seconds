local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

print("⏳ 30 SEKUNDEN VERZÖGERUNG STARTET...")

-- ==============================
-- RESET 1x
-- ==============================
print("🔄 Reset...")
character.Humanoid.Health = 0
local newChar = player.CharacterAdded:Wait()
character = newChar
rootPart = character:WaitForChild("HumanoidRootPart")
print("✅ Respawned!")

-- ==============================
-- POSITIONSSPEICHER (30 Sekunden)
-- ==============================
local MAX_POSITIONS = 30  -- 30 Sekunden
local positions = {}
local counter = 0
local realPosition = rootPart.Position

-- Alle 1 Sekunde Position speichern
RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    if counter % 60 == 0 then  -- 60 Frames ≈ 1 Sekunde
        table.insert(positions, {
            position = rootPart.Position,
            cframe = rootPart.CFrame
        })
        
        -- Nur die letzten 30 Positionen behalten
        if #positions > MAX_POSITIONS then
            table.remove(positions, 1)
        end
        
        -- Aktuelle Position für Hooks speichern
        realPosition = rootPart.Position
    end
end)

-- ==============================
-- GRÜNER MARKER (Fake Position)
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(10, 2, 10)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.1
    marker.Parent = Workspace
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 400, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 30
    glow.Brightness = 20
    
    game:GetService("Debris"):AddItem(marker, 35)
    return marker
end

-- ==============================
-- FAKE POSITION (Position von vor 30 Sekunden)
-- ==============================
local fakeOffset = Vector3.new(0, 0, 0)

-- ==============================
-- HOOK 1: CFrame manipulieren (30 Sekunden alt)
-- ==============================
local hookCFrame = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "CFrame" and self == rootPart then
        if #positions >= 30 then
            local oldData = positions[1]  -- Älteste Position (vor 30 Sek.)
            if oldData then
                return oldData.cframe
            end
        end
        return CFrame.new(realPosition)
    end
    return hookCFrame(self, key)
end)

-- ==============================
-- HOOK 2: Position manipulieren (30 Sekunden alt)
-- ==============================
local hookPosition = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "Position" and self == rootPart then
        if #positions >= 30 then
            local oldData = positions[1]  -- Älteste Position (vor 30 Sek.)
            if oldData then
                return oldData.position
            end
        end
        return realPosition
    end
    return hookPosition(self, key)
end)

-- ==============================
-- ZUSÄTZLICHE SICHTBARE VERZÖGERUNG
-- ==============================
local showFakeMarker = false

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    -- Wenn wir 30 Positionen haben, zeige Marker an der alten Position
    if #positions >= 30 and not showFakeMarker then
        local oldData = positions[1]
        if oldData then
            createMarker(oldData.position, "⏳ ANDERE SEHEN DICH HIER (30 SEK. ALT)")
            showFakeMarker = true
            print("🟢 Marker an 30-Sekunden-alter Position!")
        end
    end
end)

-- ==============================
-- R-TASTE: ZEIGE AKTUELLE VERZÖGERUNG
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        if #positions >= 30 then
            local oldData = positions[1]
            if oldData then
                createMarker(oldData.position, "⏳ VOR 30 SEKUNDEN")
                print("🟢 Marker an 30-Sekunden-alter Position!")
            end
        else
            print("⚠️ Noch nicht genug Positionen (" .. #positions .. "/30)")
        end
    end
end)

