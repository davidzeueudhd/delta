--[[
    MUTAGEN-STYLE DESYNC (NUR DESYNC, KEINE STATS-ÄNDERUNG)
    - Kein GUI
    - Keine Veränderung von WalkSpeed oder JumpPower
    - Hook-basierte Desync-Methode
    - F-Taste zum Ein-/Ausschalten
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

-- Tabelle für Desync-Einstellungen
local desyncT = {
    enabled = true,          -- Standardmäßig aktiviert
    loc = CFrame.new()       -- Speichert die echte Position
}

-- Haupt-Desync-Loop
RunService.Heartbeat:Connect(function()
    if desyncT.enabled and localPlayer.Character then
        local character = localPlayer.Character
        local root = character:FindFirstChild("HumanoidRootPart")
        
        if root then
            -- 1. Echte Position speichern
            desyncT.loc = root.CFrame
            
            -- 2. Charakter um 10 Studs nach unten verschieben
            local newCframe = desyncT.loc * CFrame.new(0, -10, 0)
            root.CFrame = newCframe
            
            -- Kurze Pause, damit die Verschiebung registriert wird
            RunService.RenderStepped:Wait()
            
            -- 3. Sofort zur echten Position zurücksetzen
            root.CFrame = desyncT.loc
        end
    end
end)

-- Der entscheidende Hook (manipuliert die zurückgegebene Position)
local desynchook = nil
desynchook = hookmetamethod(game, "__index", newcclosure(function(self, key)
    if desyncT.enabled 
       and not checkcaller() 
       and key == "CFrame" 
       and localPlayer.Character 
       and self == localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        -- Gib die gespeicherte echte Position zurück
        return desyncT.loc
    end
    -- Ansonsten normales Verhalten
    return desynchook(self, key)
end))

-- F-Taste zum Ein- und Ausschalten
UserInputService.InputBegan:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        desyncT.enabled = not desyncT.enabled
        if desyncT.enabled then
            print("🟢 Desync AKTIVIERT")
        else
            print("🔴 Desync PAUSIERT")
        end
    end
end)

print("🧠 MUTAGEN-STYLE DESYNC GELADEN!")
print("📌 F = Desync AN/AUS")
print("⚠️ EXTREM RISKANT - NUR AUF WEGWERF-ACCOUNTS!")
