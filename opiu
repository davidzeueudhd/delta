--[[
    TANK GAME - CLEAN DESYNC + SPEED TOGGLE
    L = Reset + Desync
    P = Toggle Desync ON/OFF
    B = Toggle Speed 50 ON/OFF
    Green glow when Desync is ON
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")
local humanoid = character:WaitForChild("Humanoid")

-- ==============================
-- STATUS
-- ==============================
local desyncActive = false
local speedActive = false
local glowObject = nil

-- ==============================
-- GREEN GLOW
-- ==============================
local function addGreenGlow()
    if glowObject then return end
    
    local glow = Instance.new("Highlight")
    glow.Parent = character
    glow.FillColor = Color3.fromRGB(0, 255, 0)
    glow.FillTransparency = 0.3
    glow.OutlineColor = Color3.fromRGB(0, 255, 0)
    glow.OutlineTransparency = 0.5
    glowObject = glow
    print("🟢 Desync ON")
end

local function removeGreenGlow()
    if glowObject then
        glowObject:Destroy()
        glowObject = nil
        print("🔴 Desync OFF")
    end
end

-- ==============================
-- CLEAN DESYNC (smoother movement)
-- ==============================
local desyncOffset = Vector3.new(0, 0, 0)
local desyncConnection = nil
local targetOffset = Vector3.new(0, 0, 0)

local function startDesync()
    if desyncConnection then return end
    
    desyncConnection = RunService.Heartbeat:Connect(function()
        if not desyncActive then return end
        if not rootPart or not rootPart.Parent then return end
        
        -- Generate new target offset (smoother, less random)
        targetOffset = Vector3.new(
            math.random(-100, 100) / 100,
            math.random(-20, 20) / 100,
            math.random(-100, 100) / 100
        )
        
        -- Smooth interpolation (cleaner movement)
        desyncOffset = desyncOffset:Lerp(targetOffset, 0.25)
        
        -- Apply offset with minimal rotation
        rootPart.CFrame = rootPart.CFrame + desyncOffset
    end)
end

local function stopDesync()
    if desyncConnection then
        desyncConnection:Disconnect()
        desyncConnection = nil
    end
end

-- ==============================
-- TOGGLE DESYNC (P KEY)
-- ==============================
local function toggleDesync()
    desyncActive = not desyncActive
    
    if desyncActive then
        addGreenGlow()
        startDesync()
    else
        removeGreenGlow()
        stopDesync()
    end
end

-- ==============================
-- TOGGLE SPEED (B KEY)
-- ==============================
local function toggleSpeed()
    speedActive = not speedActive
    
    if speedActive then
        humanoid.WalkSpeed = 50
        print("🟢 Speed ON (50)")
    else
        humanoid.WalkSpeed = 16
        print("🔴 Speed OFF (16)")
    end
end

-- ==============================
-- RESET + DESYNC (L KEY)
-- ==============================
local function resetAndDesync()
    if not character then return end
    
    -- 1. Desync ausschalten
    if desyncActive then
        desyncActive = false
        removeGreenGlow()
        stopDesync()
    end
    
    -- 2. Character killen (respawn)
    character.Humanoid.Health = 0
    
    -- 3. Auf Respawn warten
    local newChar = player.CharacterAdded:Wait()
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    
    -- 4. Desync aktivieren
    desyncActive = true
    addGreenGlow()
    startDesync()
    
    print("🔄 Reset + Desync aktiviert!")
end

-- ==============================
-- KEYBINDS
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.L then
        resetAndDesync()
    end
    
    if input.KeyCode == Enum.KeyCode.P then
        toggleDesync()
    end
    
    if input.KeyCode == Enum.KeyCode.B then
        toggleSpeed()
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    print("🔄 Character respawned")
end)

print("🎯 CLEAN DESYNC + SPEED SCRIPT GELADEN!")
print("📌 L = Reset + Desync")
print("📌 P = Toggle Desync ON/OFF")
print("📌 B = Toggle Speed 50 ON/OFF")
print("📌 Green Glow wenn Desync ON")
