    glow.FillColor = Color3.fromRGB(0, 100, 255)
    glow.FillTransparency = 0.2
    glow.OutlineColor = Color3.fromRGB(0, 200, 255)
    glow.OutlineTransparency = 0.3
    glowObject = glow
