        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(math.random(1, 999999), {data = "crash", time = tick()})
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(math.random(1, 999999), {data = "crash", time = tick()})
            end
        end)
    end

    -- 2. CREATE PHYSICS PARTS (replicate to all)
