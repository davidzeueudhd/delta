--[[
    Roblox Script: Fly, Noclip & WalkSpeed Controller
    Features:
    - Fly (toggle with customizable speed)
    - Noclip (toggle)
    - WalkSpeed (adjustable up to 200)
    - Simple and clean GUI
    - Anti-detection measures (property spoofing, remote blocking)
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
--  SETTINGS
-- ============================================================
local Settings = {
    FlyEnabled = false,
    FlySpeed = 50,
    NoclipEnabled = false,
    WalkSpeed = 16,
}

-- ============================================================
--  ANTI-DETECTION (Property Spoofing, Remote Blocking)
-- ============================================================
local function setupAntiDetection()
    -- Block suspicious remote events that might be used by anti-cheat
    local function blockRemote(remote)
        if remote:IsA("RemoteEvent") then
            local oldFire = remote.FireServer
            remote.FireServer = function(...)
                -- Block known anti-cheat remotes
                if remote.Name:lower():find("antihack") or remote.Name:lower():find("anticheat") or remote.Name:lower():find("report") then
                    return
                end
                return oldFire(...)
            end
        end
    end

    -- Search and block suspicious remotes
    local function scanAndBlock(parent)
        for _, child in ipairs(parent:GetChildren()) do
            blockRemote(child)
            if child:IsA("Folder") or child:IsA("Model") then
                scanAndBlock(child)
            end
        end
    end

    -- Start scanning from ReplicatedStorage
    local replicatedStorage = game:GetService("ReplicatedStorage")
    if replicatedStorage then
        scanAndBlock(replicatedStorage)
    end

    -- Property spoofing: Override WalkSpeed checks
    local mt = getrawmetatable and getrawmetatable(game) or getmetatable(game)
    if mt then
        local oldNamecall = mt.__namecall
        mt.__namecall = function(self, ...)
            local args = {...}
            local method = tostring(args[1]) or ""
            -- If a script tries to read WalkSpeed, return the original value
            if method:lower():find("walkspeed") then
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
                if humanoid then
                    return 16 -- Return default value to avoid detection
                end
            end
            return oldNamecall and oldNamecall(self, ...)
        end
        setmetatable(game, mt)
    end
end

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil
local flyBodyGyro = nil

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Clean up old fly parts
    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyBodyGyro then flyBodyGyro:Destroy() end
    if flyConnection then flyConnection:Disconnect() end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(40000, 40000, 40000)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(40000, 40000, 40000)
    flyBodyGyro.Parent = root

    flyConnection = RunService.Heartbeat:Connect(function()
        if not Settings.FlyEnabled then return end
        if not root or not root.Parent then
            stopFly()
            return
        end

        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * Settings.FlySpeed
        end

        flyBodyVelocity.Velocity = moveDirection
        flyBodyGyro.CFrame = root.CFrame
    end)
end

local function stopFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
end

local function toggleFly()
    Settings.FlyEnabled = not Settings.FlyEnabled
    if Settings.FlyEnabled then
        startFly()
    else
        stopFly()
    end
end

-- ============================================================
--  NOCLIP SYSTEM
-- ============================================================
local function toggleNoclip()
    Settings.NoclipEnabled = not Settings.NoclipEnabled
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = not Settings.NoclipEnabled
            end
        end
    end
end

-- ============================================================
--  WALKSPEED SYSTEM
-- ============================================================
local function applyWalkSpeed(speed)
    Settings.WalkSpeed = speed
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speed
        end
    end
end

-- ============================================================
--  CHARACTER RESPAWN HANDLER
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Settings.FlyEnabled then startFly() end
    if Settings.NoclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
    applyWalkSpeed(Settings.WalkSpeed)
end)

