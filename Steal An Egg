        toggleNoclip()
        noclipBtn.BackgroundColor3 = Settings.NoclipEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        noclipBtn.Text = Settings.NoclipEnabled and "ON" or "OFF"
    end)

    -- Fly Speed Slider
    local speedDragging = false
    local function updateSpeed(input)
        local mouseX = input.Position.X
        local sliderPos = speedSlider.AbsolutePosition.X
        local sliderWidth = speedSlider.AbsoluteSize.X
        local rel = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(10 + rel * 190) -- range 10-200
        speedLabel.Text = "Fly Speed: " .. newSpeed
        speedFill.Size = UDim2.new(rel, 0, 1, 0)
        Settings.FlySpeed = newSpeed
    end

    speedSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            speedDragging = true
            updateSpeed(input)
        end
    end)

    speedSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            speedDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if speedDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSpeed(input)
        end
    end)

    -- WalkSpeed Slider
    local wsDragging = false
    local function updateWalkSpeed(input)
        local mouseX = input.Position.X
        local sliderPos = wsSlider.AbsolutePosition.X
        local sliderWidth = wsSlider.AbsoluteSize.X
        local rel = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(16 + rel * 184) -- range 16-200
        wsLabel.Text = "WalkSpeed: " .. newSpeed
        wsFill.Size = UDim2.new(rel, 0, 1, 0)
        applyWalkSpeed(newSpeed)
    end

    wsSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = true
            updateWalkSpeed(input)
        end
    end)

    wsSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if wsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateWalkSpeed(input)
        end
    end)

