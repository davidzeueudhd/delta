function EggManager:FindEggs()
    local eggs = {}
    
    -- Search all possible locations
    local locations = {Workspace, ReplicatedStorage, game:GetService("Lighting"), game:GetService("ServerStorage")}
    
    for _, location in ipairs(locations) do
        pcall(function()
            for _, part in ipairs(location:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("Model") or part:IsA("Folder") then
                    local name = part.Name or ""
                    local nameLower = name:lower()
                    
                    -- Check for egg indicators
                    local eggIndicators = {
                        "egg", "easter", "hatch", "collect", "rare", 
                        "mystery", "golden", "dragon", "phoenix", 
                        "godly", "mythical", "rainbow"
                    }
                    
                    local isEgg = false
                    for _, indicator in ipairs(eggIndicators) do
                        if nameLower:find(indicator) then
                            isEgg = true
                            break
                        end
                    end
                    
                    -- Check for egg-like colors
                    if not isEgg and part:IsA("BasePart") then
                        local colors = part.Color or Color3.new(1, 1, 1)
                        local isGold = colors.r > 0.8 and colors.g > 0.7 and colors.b < 0.3
                        local isRainbow = colors.r ~= colors.g and colors.g ~= colors.b
                        local isBright = colors.r + colors.g + colors.b > 2.5
                        
                        if isGold or isRainbow or isBright then
                            isEgg = true
                        end
                    end
                    
                    if isEgg then
                        table.insert(eggs, part)
                    end
                end
            end
        end)
    end
    
    return eggs
end

function EggManager:ForceRareSpawn()
    pcall(function()
        -- Try to find egg spawn points
        local spawnPoints = {}
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and (part.Name:lower():find("spawn") or part.Name:lower():find("egg")) then
                table.insert(spawnPoints, part)
            end
        end
        
        -- Create fake eggs if no eggs found
        if #spawnPoints > 0 then
            for _, spawnPoint in ipairs(spawnPoints) do
                if math.random() < 0.3 then -- 30% chance to spawn at each location
                    local egg = Instance.new("Part")
                    egg.Size = Vector3.new(2, 3, 2)
                    egg.Shape = Enum.PartType.Ball
                    egg.CFrame = spawnPoint.CFrame + Vector3.new(0, 2, 0)
                    egg.Anchored = true
                    egg.CanCollide = false
                    
                    -- Make it rare
                    local rareNames = RareEggNames[Config.EggRarity] or RareEggNames["Godly"]
                    egg.Name = rareNames[math.random(1, #rareNames)]
                    egg.Color = Color3.fromRGB(255, 215, 0)
                    egg.Material = Enum.Material.Neon
                    
                    -- Add click detector
                    local clickDetector = Instance.new("ClickDetector")
                    clickDetector.Parent = egg
                    
                    -- Add glow
                    local light = Instance.new("PointLight")
                    light.Color = egg.Color
                    light.Brightness = 3
                    light.Range = 15
                    light.Parent = egg
                    
                    egg.Parent = Workspace
                    
                    print("✨ Spawned rare egg: " .. egg.Name)
                end
            end
        end
    end)
end

function EggManager:ConvertToRare(egg)
    if not Config.Enabled then return end
    
    pcall(function()
        -- Get rare name
        local rareNames = RareEggNames[Config.EggRarity] or RareEggNames["Godly"]
        local newName = rareNames[math.random(1, #rareNames)]
        egg.Name = newName
        
        -- Make it visually impressive
        if egg:IsA("BasePart") then
            -- Ultimate rare colors
            local colors = {
                Color3.fromRGB(255, 215, 0),   -- Gold
                Color3.fromRGB(255, 0, 255),   -- Neon Pink
                Color3.fromRGB(0, 255, 255),   -- Neon Cyan
                Color3.fromRGB(255, 0, 0),     -- Red
                Color3.fromRGB(0, 255, 0),     -- Green
                Color3.fromRGB(255, 255, 0),   -- Yellow
                Color3.fromRGB(255, 100, 0),   -- Orange
                Color3.fromRGB(150, 0, 255),   -- Purple
                Color3.fromRGB(0, 255, 128),   -- Mint
                Color3.fromRGB(255, 50, 100),  -- Pink
            }
            
            local randomColor = colors[math.random(1, #colors)]
            egg.Color = randomColor
            egg.Material = Enum.Material.Neon
            egg.Reflectance = 0.5
            egg.Transparency = 0.1
            
            -- Multiple lights for ultimate glow
            for i = 1, 3 do
                local light = Instance.new("PointLight")
                light.Color = randomColor
                light.Brightness = 2 + math.random()
                light.Range = 10 + math.random(1, 5)
                light.Parent = egg
            end
            
            -- Add particle effect
            local particles = Instance.new("ParticleEmitter")
            particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
            particles.Rate = 50
            particles.Lifetime = NumberRange.new(0.5, 1)
            particles.SpreadAngle = Vector2.new(180, 180)
            particles.VelocityInheritance = 0
            particles.Color = ColorSequence.new(randomColor)
            particles.Transparency = NumberSequence.new(0, 1)
            particles.Size = NumberSequence.new(0.5, 1)
            particles.Parent = egg
        end
        
        -- Add value tag
        local valueTag = Instance.new("IntValue")
        valueTag.Name = "RarityValue"
        valueTag.Value = math.random(1000, 10000)
        valueTag.Parent = egg
        
        -- Add click detector
        if not egg:FindFirstChild("ClickDetector") then
            local clickDetector = Instance.new("ClickDetector")
            clickDetector.MaxActivationDistance = 100
            clickDetector.Parent = egg
        end
        
        print("🥚 CONVERTED TO: " .. newName .. " (Rarity: " .. Config.EggRarity .. ")")
    end)
end

function EggManager:CollectEgg(egg)
    pcall(function()
        if not Config.AutoCollect then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart or not humanoid then return end
        
        -- Teleport to egg with random offset
        if Config.TeleportToEgg and egg:IsA("BasePart") then
            local offset = Vector3.new(
                math.random(-2, 2),
                math.random(1, 3),
                math.random(-2, 2)
            )
            rootPart.CFrame = CFrame.new(egg.Position + offset)
            task.wait(0.3)
        end
        
        -- Multiple collection methods
        local collected = false
        
        -- ClickDetector
        local clickDetector = egg:FindFirstChild("ClickDetector")
        if clickDetector then
            clickDetector:FireClick(LocalPlayer)
            collected = true
        end
        
        -- Touch
        if not collected then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
            collected = true
        end
        
        -- RemoteEvent
        if not collected then
            local remoteEvent = ReplicatedStorage:FindFirstChild("CollectEgg")
            if remoteEvent and remoteEvent:IsA("RemoteEvent") then
                remoteEvent:FireServer(egg)
                collected = true
            end
        end
        
        -- ProximityPrompt
        if not collected then
            local proximityPrompt = egg:FindFirstChild("ProximityPrompt")
            if proximityPrompt and proximityPrompt:IsA("ProximityPrompt") then
                proximityPrompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
                collected = true
            end
        end
        
        if collected then
            print("✅ COLLECTED: " .. (egg.Name or "Unknown Egg"))
        end
    end)
end

function EggManager:ScanForEggs()
    local eggs = self:FindEggs()
    
    if #eggs == 0 then
        -- If no eggs found, try to spawn one
        self:ForceRareSpawn()
        return
    end
    
    for _, egg in ipairs(eggs) do
        if not eggsFound[egg] then
            eggsFound[egg] = true
            self:ConvertToRare(egg)
            self:CollectEgg(egg)
            task.wait(0.5) -- Delay between eggs
        end
    end
end

function EggManager:Start()
    if eggConnection then
        eggConnection:Disconnect()
        eggConnection = nil
    end
    
    eggsFound = {}
    
    -- Start anti-kick protection
    antiKickConnection = AntiKick:PreventKick()
    AntiKick:BypassTriggers()
    
    eggConnection = RunService.Heartbeat:Connect(function()
        if Config.Enabled then
            self:ScanForEggs()
        end
    end)
    
    -- Spawn eggs periodically
    spawnConnection = RunService.Stepped:Connect(function()
        if Config.Enabled and math.random() < 0.05 then -- 5% chance each step
            self:ForceRareSpawn()
        end
    end)
end

function EggManager:Stop()
    if eggConnection then
        eggConnection:Disconnect()
        eggConnection = nil
    end
    if collectConnection then
        collectConnection:Disconnect()
        collectConnection = nil
    end
    if spawnConnection then
        spawnConnection:Disconnect()
        spawnConnection = nil
    end
    if antiKickConnection then
        antiKickConnection:Disconnect()
        antiKickConnection = nil
    end
end

