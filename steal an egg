        toggleButton.Text = Config.Enabled and "⏹ STOP" or "▶ START"
        statusLabel.Text = Config.Enabled and "🟢 Status: ACTIVE" or "🔴 Status: OFF"
        statusLabel.TextColor3 = Config.Enabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
        
        if Config.Enabled then
            EggManager:Start()
            print("✨ Ultimate Egg Spawner ACTIVATED!")
            print("🛡️ Anti-Kick Protection: ENABLED")
        else
            EggManager:Stop()
            print("✨ Ultimate Egg Spawner DEACTIVATED!")
        end
    end)

    -- Close
    closeButton.MouseButton1Click:Connect(function()
        EggManager:Stop()
        screenGui:Destroy()
    end)

    -- Keybind
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode[Config.ToggleKey] then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    return screenGui
end

