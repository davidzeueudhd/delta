--[[
    MUTAGEN STYLE - MIT SICHTBAREM DESYNC (5,0 STUDS)
    - Character resettet
    - Andere sehen dich deutlich an anderer Position
    - Grüner Marker zeigt Fake Position
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ==============================
-- STEP 1: CHARACTER RESETTEN
-- ==============================
print("🔄 Reset: Character wird zurückgesetzt...")

-- Character töten (respawnen)
character.Humanoid.Health = 0

-- Warten, bis er neu gespawnt ist
local newChar = player.CharacterAdded:Wait()
character = newChar
rootPart = character:WaitForChild("HumanoidRootPart")

print("✅ Character neu gespawnt!")

-- ==============================
-- STEP 2: FAKE POSITION (5 STUDS)
-- ==============================
local fakePosition = rootPart.Position + Vector3.new(
    math.random(-500, 500) / 100,  -- 5,0 Studs
    math.random(-100, 100) / 100,
    math.random(-500, 500) / 100
)

-- ==============================
-- STEP 3: GRÜNER MARKER AN FAKE POSITION
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(6, 1, 6)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.2
    marker.Parent = Workspace
    
    -- Text anzeigen
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 4, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 FAKE POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 15
    glow.Brightness = 3
    
    game:GetService("Debris"):AddItem(marker, 30)
    return marker
end

-- Marker an FAKE Position setzen
createMarker(fakePosition, "🎯 FAKE POSITION (ANDERE SEHEN DICH HIER)")
print("🟢 Marker an FAKE Position gesetzt (5,0 Studs entfernt)!")

-- ==============================
-- STEP 4: STARKER DESYNC (5,0 STUDS)
-- ==============================
local desyncOffset = Vector3.new(0, 0, 0)
local targetOffset = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    -- Zufälligen Desync-Offset generieren (5,0 Studs)
    targetOffset = Vector3.new(
        math.random(-500, 500) / 100,
        math.random(-100, 100) / 100,
        math.random(-500, 500) / 100
    )
    
    -- Sanftes Gleiten
    desyncOffset = desyncOffset:Lerp(targetOffset, 0.15)
    
    -- Position für andere Spieler verändern
    rootPart.CFrame = rootPart.CFrame + desyncOffset
end)

-- ==============================
-- POSITIONEN SPEICHERN
-- ==============================
local MAX_POSITIONS = 20
local positions = {}
local counter = 0

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    if counter % 60 == 0 then
        table.insert(positions, {
            position = rootPart.Position,
            cframe = rootPart.CFrame
        })
        
        if #positions > MAX_POSITIONS then
            table.remove(positions, 1)
        end
    end
end)

-- ==============================
-- R TASTE = MARKER
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        if #positions < 20 then
            print("⚠️ Noch nicht genug Positionen (" .. #positions .. "/20)")
            return
        end
        
        local oldData = positions[1]
        if oldData then
            createMarker(oldData.position, "⏳ VOR 20 SEKUNDEN")
            print("🟢 Marker an Position von vor 20 Sekunden")
        end
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    desyncOffset = Vector3.new(0, 0, 0)
    print("🔄 Character respawned - Desync läuft weiter")
end)

print("🔥 MUTAGEN STYLE - 5,0 STUDS GELADEN!")
print("📌 Character wurde resetted!")
print("📌 FAKE POSITION wurde markiert (5,0 Studs entfernt)!")
print("📌 Andere sehen dich an der FAKE POSITION!")
print("📌 Drücke R = Marker an Position von vor 20 Sekunden")
print("📌 KEINE Veränderungen an Speed oder Stats!")
