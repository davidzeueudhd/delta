--[[
    REAL SERVER NUKER - KEYBIND K
    - Creates INFINITE falling parts
    - Each part spawns MORE parts
    - Character GLOWS BLUE when activated
    - Server dies within seconds
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local isNukerActive = false
local nukerConnection = nil
local glowObject = nil

-- ==============================
-- BLUE GLOW FUNCTION
-- ==============================
local function addBlueGlow()
    if glowObject then return end
    
    local glow = Instance.new("Highlight")
    glow.Parent = character
    glow.FillColor = Color3.fromRGB(0, 100, 255)
    glow.FillTransparency = 0.2
    glow.OutlineColor = Color3.fromRGB(0, 200, 255)
    glow.OutlineTransparency = 0.3
    glowObject = glow
    print("🔵 NUKER ON - Blue Glow Active")
end

local function removeBlueGlow()
    if glowObject then
        glowObject:Destroy()
        glowObject = nil
        print("⚪ NUKER OFF - Glow Removed")
    end
end

-- ==============================
-- THE NUKER (creates parts that create parts)
-- ==============================
local function spawnNuke()
    for i = 1, 500 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(10, 10, 10)
        part.Position = Vector3.new(
            math.random(-500, 500),
            1000,
            math.random(-500, 500)
        )
        part.Anchored = false
        part.CanCollide = true
        part.BrickColor = BrickColor.new("Bright red")
        part.Material = Enum.Material.Neon
        part.Parent = Workspace
        
        -- Make it EXPLODE into more parts
        task.spawn(function()
            wait(0.1)
            for j = 1, 10 do
                local childPart = Instance.new("Part")
                childPart.Size = Vector3.new(2, 2, 2)
                childPart.Position = part.Position + Vector3.new(
                    math.random(-10, 10),
                    math.random(-10, 10),
                    math.random(-10, 10)
                )
                childPart.Anchored = false
                childPart.CanCollide = true
                childPart.BrickColor = BrickColor.random()
                childPart.Material = Enum.Material.Neon
                childPart.Parent = Workspace
                Debris:AddItem(childPart, 3)
            end
        end)
        
        Debris:AddItem(part, 5)
    end
end

-- ==============================
-- TOGGLE NUKER
-- ==============================
local function toggleNuker()
    isNukerActive = not isNukerActive
    
    if isNukerActive then
        addBlueGlow()
        print("💀 NUKER ACTIVATED!")
        nukerConnection = RunService.Heartbeat:Connect(function()
            spawnNuke()
        end)
    else
        removeBlueGlow()
        print("🔴 NUKER DEACTIVATED")
        if nukerConnection then
            nukerConnection:Disconnect()
            nukerConnection = nil
        end
    end
end

-- ==============================
-- KEYBIND: K
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggleNuker()
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    if isNukerActive then
        addBlueGlow()
    end
end)

