--[[
    TELEPORTATION GUI - CLICK TO TELEPORT
    - Toggle: ON/OFF
    - Click anywhere on the screen to teleport
    - Works with Mouse
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer

local teleportEnabled = false
local gui = nil
local frame = nil

-- ==============================
-- CREATE GUI (ON/OFF TOGGLE)
-- ==============================
local function createGUI()
    gui = Instance.new("ScreenGui")
    gui.Name = "TeleportGUI"
    gui.Parent = player:WaitForChild("PlayerGui")
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false

    -- Main Frame
    frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 80)
    frame.Position = UDim2.new(0.5, -100, 0.5, -40)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
    frame.BackgroundTransparency = 0
    frame.BorderSizePixel = 3
    frame.BorderColor3 = Color3.fromRGB(0, 255, 255)
    frame.Active = true
    frame.Draggable = true
    frame.Parent = gui

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundTransparency = 1
    title.Text = "📍 TELEPORT"
    title.TextColor3 = Color3.fromRGB(0, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.Bold
    title.Parent = frame

    -- ON/OFF Button
    local toggleBtn = Instance.new("TextButton")
    toggleBtn.Size = UDim2.new(0.6, 0, 0, 35)
    toggleBtn.Position = UDim2.new(0.2, 0, 0, 35)
    toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    toggleBtn.Text = "🔴 OFF"
    toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleBtn.TextScaled = true
    toggleBtn.Font = Enum.Font.SourceSansBold
    toggleBtn.Parent = frame

    -- Toggle function
    toggleBtn.MouseButton1Click:Connect(function()
        teleportEnabled = not teleportEnabled
        if teleportEnabled then
            toggleBtn.Text = "🟢 ON"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
            print("🟢 Teleport ON - Click anywhere to teleport!")
        else
            toggleBtn.Text = "🔴 OFF"
            toggleBtn.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
            print("🔴 Teleport OFF")
        end
    end)

    return toggleBtn
end

-- ==============================
-- TELEPORT ON CLICK
-- ==============================
local function setupTeleport()
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not teleportEnabled then return end
        
        -- Check if mouse click
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            -- Get mouse position on screen
            local mouse = player:GetMouse()
            if not mouse then return end
            
            -- Get character and root part
            local character = player.Character
            if not character then return end
            local rootPart = character:FindFirstChild("HumanoidRootPart")
            if not rootPart then return end
            
            -- Get the position where the mouse clicked (3D world)
            local targetPos = mouse.Hit.Position
            if not targetPos then return end
            
            -- Check if clicked on GUI (prevent teleporting when clicking GUI)
            if gui and gui.Enabled then
                -- Simple check: if mouse is over GUI, don't teleport
                -- (We'll use a different approach: check if the click was on the GUI)
                local mouseTarget = mouse.Target
                if mouseTarget and mouseTarget:IsDescendantOf(gui) then
                    return
                end
            end
            
            -- Teleport to clicked position
            rootPart.CFrame = CFrame.new(targetPos)
            print("📍 Teleported to: " .. tostring(targetPos))
            
            -- Visual feedback (green flash)
            local flash = Instance.new("Part")
            flash.Size = Vector3.new(5, 1, 5)
            flash.Position = targetPos
            flash.Anchored = true
            flash.CanCollide = false
            flash.BrickColor = BrickColor.new("Bright green")
            flash.Material = Enum.Material.Neon
            flash.Transparency = 0.3
            flash.Parent = game:GetService("Workspace")
            game:GetService("Debris"):AddItem(flash, 0.5)
        end
    end)
end

-- ==============================
-- CREATE GUI AND SETUP
-- ==============================
createGUI()
setupTeleport()

print("📍 TELEPORT GUI GELADEN!")
print("📌 Klicke auf 'ON' um zu aktivieren")
print("📌 Klicke irgendwo auf den Boden um zu teleportieren")
