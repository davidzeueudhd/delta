loadstring([[
-- ============================================================
--  GUI: Fly + Click Teleport (with speed control)
-- ============================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
--  CONFIG
-- ============================================================
local Config = {
    FlyEnabled = false,
    FlySpeed = 50,           -- default speed
    TeleportEnabled = false,
}

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil

local function startFly(speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- Remove old fly parts
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    -- Create BodyVelocity to move the player
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root

    -- Update velocity each frame based on WASD input
    flyConnection = RunService.Heartbeat:Connect(function(dt)
        if not Config.FlyEnabled then return end
        if not root or not root.Parent then
            stopFly()
            return
        end

        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * speed
        end

        flyBodyVelocity.Velocity = moveDirection
    end)

    print("🛫 Fly ON (Speed: " .. speed .. ")")
end

local function stopFly()
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    print("🛬 Fly OFF")
end

-- Toggle Fly
local function toggleFly()
    Config.FlyEnabled = not Config.FlyEnabled
    if Config.FlyEnabled then
        startFly(Config.FlySpeed)
    else
        stopFly()
    end
end

-- Update speed while flying
local function updateFlySpeed(newSpeed)
    Config.FlySpeed = newSpeed
    if Config.FlyEnabled then
        -- Restart fly with new speed
        stopFly()
        startFly(newSpeed)
    end
end

-- ============================================================
--  CLICK TELEPORT SYSTEM
-- ============================================================
local teleportConnection = nil

local function startTeleport()
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end

    teleportConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not Config.TeleportEnabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

        local mouse = LocalPlayer:GetMouse()
        if not mouse then return end

        local target = mouse.Target
        local hitPosition = mouse.Hit.Position

        if not target then return end

        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        -- Teleport to the click position, offset up a bit to avoid falling through floor
        root.CFrame = CFrame.new(hitPosition + Vector3.new(0, 3, 0))
        print("📍 Teleported to: " .. tostring(hitPosition))
    end)

    print("🖱️ Click Teleport ON")
end

local function stopTeleport()
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
    print("🖱️ Click Teleport OFF")
end

local function toggleTeleport()
    Config.TeleportEnabled = not Config.TeleportEnabled
    if Config.TeleportEnabled then
        startTeleport()
    else
        stopTeleport()
    end
end

-- ============================================================
--  GUI CREATION
-- ============================================================
local function CreateGUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "FlyTeleportGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    -- Main Frame
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 320, 0, 220)
    frame.Position = UDim2.new(0.5, -160, 0.5, -110)
    frame.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    title.BackgroundTransparency = 0.3
    title.Text = "🛸 Fly + Click Teleport"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- Fly Toggle
    local flyLabel = Instance.new("TextLabel")
    flyLabel.Size = UDim2.new(0.45, 0, 0, 30)
    flyLabel.Position = UDim2.new(0.05, 0, 0, 50)
    flyLabel.BackgroundTransparency = 1
    flyLabel.Text = "🛫 Fly:"
    flyLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    flyLabel.TextScaled = true
    flyLabel.Font = Enum.Font.GothamMedium
    flyLabel.TextXAlignment = Enum.TextXAlignment.Left
    flyLabel.Parent = frame

    local flyBtn = Instance.new("TextButton")
    flyBtn.Size = UDim2.new(0.2, 0, 0, 28)
    flyBtn.Position = UDim2.new(0.55, 0, 0, 51)
    flyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    flyBtn.Text = "OFF"
    flyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    flyBtn.TextScaled = true
    flyBtn.Font = Enum.Font.GothamBold
    flyBtn.BorderSizePixel = 0
    flyBtn.Parent = frame

    local flyCorner = Instance.new("UICorner")
    flyCorner.CornerRadius = UDim.new(0, 6)
    flyCorner.Parent = flyBtn

    -- Fly Speed Slider
    local speedLabel = Instance.new("TextLabel")
    speedLabel.Size = UDim2.new(0.45, 0, 0, 25)
    speedLabel.Position = UDim2.new(0.05, 0, 0, 85)
    speedLabel.BackgroundTransparency = 1
    speedLabel.Text = "Speed: " .. Config.FlySpeed
    speedLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    speedLabel.TextScaled = true
    speedLabel.Font = Enum.Font.GothamMedium
    speedLabel.TextXAlignment = Enum.TextXAlignment.Left
    speedLabel.Parent = frame

    local speedSlider = Instance.new("Frame")
    speedSlider.Size = UDim2.new(0.4, 0, 0, 6)
    speedSlider.Position = UDim2.new(0.55, 0, 0, 95)
    speedSlider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    speedSlider.Parent = frame

    local sliderCorner = Instance.new("UICorner")
    sliderCorner.CornerRadius = UDim.new(0, 3)
    sliderCorner.Parent = speedSlider

    local speedFill = Instance.new("Frame")
    speedFill.Size = UDim2.new((Config.FlySpeed - 10) / 190, 0, 1, 0) -- range 10-200
    speedFill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    speedFill.Parent = speedSlider

    local fillCorner = Instance.new("UICorner")
    fillCorner.CornerRadius = UDim.new(0, 3)
    fillCorner.Parent = speedFill

    -- Teleport Toggle
    local teleLabel = Instance.new("TextLabel")
    teleLabel.Size = UDim2.new(0.45, 0, 0, 30)
    teleLabel.Position = UDim2.new(0.05, 0, 0, 120)
    teleLabel.BackgroundTransparency = 1
    teleLabel.Text = "🖱️ Click Teleport:"
    teleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    teleLabel.TextScaled = true
    teleLabel.Font = Enum.Font.GothamMedium
    teleLabel.TextXAlignment = Enum.TextXAlignment.Left
    teleLabel.Parent = frame

    local teleBtn = Instance.new("TextButton")
    teleBtn.Size = UDim2.new(0.2, 0, 0, 28)
    teleBtn.Position = UDim2.new(0.55, 0, 0, 121)
    teleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    teleBtn.Text = "OFF"
    teleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    teleBtn.TextScaled = true
    teleBtn.Font = Enum.Font.GothamBold
    teleBtn.BorderSizePixel = 0
    teleBtn.Parent = frame

    local teleCorner = Instance.new("UICorner")
    teleCorner.CornerRadius = UDim.new(0, 6)
    teleCorner.Parent = teleBtn

    -- Close Button
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 25, 0, 25)
    close.Position = UDim2.new(1, -35, 0, 8)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    close.Text = "✕"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.BorderSizePixel = 0
    close.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = close

    close.MouseButton1Click:Connect(function()
        -- Clean up fly and teleport when closing
        if Config.FlyEnabled then toggleFly() end
        if Config.TeleportEnabled then toggleTeleport() end
        screenGui:Destroy()
        print("❌ GUI closed")
    end)

    -- ============================================================
    --  BUTTON EVENTS
    -- ============================================================

    -- Fly Toggle
    flyBtn.MouseButton1Click:Connect(function()
        toggleFly()
        flyBtn.BackgroundColor3 = Config.FlyEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        flyBtn.Text = Config.FlyEnabled and "ON" or "OFF"
    end)

    -- Teleport Toggle
    teleBtn.MouseButton1Click:Connect(function()
        toggleTeleport()
        teleBtn.BackgroundColor3 = Config.TeleportEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        teleBtn.Text = Config.TeleportEnabled and "ON" or "OFF"
    end)

    -- Speed Slider (click and drag)
    local dragging = false
    local function updateSpeed(input)
        local mouseX = input.Position.X
        local sliderPos = speedSlider.AbsolutePosition.X
        local sliderWidth = speedSlider.AbsoluteSize.X
        local relativeX = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(10 + relativeX * 190) -- range 10-200
        speedLabel.Text = "Speed: " .. newSpeed
        speedFill.Size = UDim2.new(relativeX, 0, 1, 0)
        updateFlySpeed(newSpeed)
    end

    speedSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            updateSpeed(input)
        end
    end)

    speedSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSpeed(input)
        end
    end)

    -- Toggle GUI with R key
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)

    print("✅ GUI loaded! Press R to toggle.")
end

-- ============================================================
--  HANDLE CHARACTER RESPAWN
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function()
    -- If fly was on, restart it after respawn
    if Config.FlyEnabled then
        task.wait(0.5) -- wait for character to fully load
        startFly(Config.FlySpeed)
    end
end)

-- ============================================================
--  START
-- ============================================================
task.wait(0.5)
CreateGUI()
print("🛸 Fly + Click Teleport GUI ready!")
print("📌 R = toggle GUI")
]])()
