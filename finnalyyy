loadstring([[
-- ============================================================
--  STEAL AN EGG - ULTIMATE BYPASS SCRIPT
--  Features: Godmode, Anti-Guard, Auto Steal, Auto Return,
--  Egg Protection, Walkspeed, Fly, Teleport Points
-- ============================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
--  CONFIG
-- ============================================================
local Config = {
    Godmode = true,
    AntiGuard = true,
    AutoSteal = false,
    AutoReturn = true,
    EggProtection = true,
    FlyEnabled = false,
    WalkSpeed = 16,
}

-- ============================================================
--  GODMODE (Prevents death/ragdoll)
-- ============================================================
local function ApplyGodmode()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    humanoid.MaxHealth = math.huge
    humanoid.Health = math.huge
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    
    -- Prevent ragdoll from guards
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end
    end
end

-- ============================================================
--  ANTI-GUARD (Teleports you away when guard detects you)
-- ============================================================
local function AntiGuard()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Check for nearby guards (based on name detection)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            if name:find("guard") or name:find("dino") or name:find("trex") or name:find("dragon") or name:find("hellhound") then
                local guardPos = obj:IsA("BasePart") and obj.Position or nil
                if guardPos then
                    local dist = (guardPos - root.Position).Magnitude
                    if dist < 30 then -- If guard is too close
                        -- Teleport to base or safe location
                        local base = Workspace:FindFirstChild("Base")
                        if base and base:IsA("BasePart") then
                            root.CFrame = CFrame.new(base.Position + Vector3.new(0, 3, 0))
                        else
                            root.CFrame = CFrame.new(Vector3.new(0, 10, 0))
                        end
                        print("🛡️ Anti-Guard triggered! Teleported away.")
                        return
                    end
                end
            end
        end
    end
end

-- ============================================================
--  EGG PROTECTION (Prevents egg loss when hit)
-- ============================================================
local function ProtectEgg()
    local char = LocalPlayer.Character
    if not char then return end
    
    -- Find egg in character
    local egg = nil
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and (child.Name:lower():find("egg") or child.Name:lower():find("nest")) then
            egg = child
            break
        end
    end
    
    if egg then
        -- Prevent egg from being removed
        if not egg._protected then
            egg._protected = true
            local connection
            connection = egg.AncestryChanged:Connect(function()
                if egg and egg.Parent == nil then
                    -- Egg was dropped or removed - put it back
                    task.wait(0.1)
                    egg.Parent = char
                    print("🥚 Egg saved from being lost!")
                end
            end)
            egg._connection = connection
        end
    end
end

-- ============================================================
--  AUTO STEAL & RETURN
-- ============================================================
local function FindNearestEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            if name:find("egg") or name:find("nest") then
                -- Skip treadmills
                if name:find("treadmill") or name:find("laufband") then
                    goto continue
                end
                local dist = (obj.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = obj
                end
            end
            ::continue::
        end
    end
    
    return nearest, nearestDist
end

local function StealEgg()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local egg, dist = FindNearestEgg()
    if not egg then
        print("❌ No egg found nearby")
        return
    end
    
    print("🥚 Stealing egg: " .. egg.Name .. " (" .. math.floor(dist) .. " studs)")
    
    -- Teleport to egg
    root.CFrame = CFrame.new(egg.Position + Vector3.new(0, 2, 0))
    task.wait(0.3)
    
    -- Try to grab the egg
    local grabbed = false
    
    -- Method 1: ClickDetector
    local clickDetector = egg:FindFirstChild("ClickDetector")
    if clickDetector then
        clickDetector:FireClick(LocalPlayer)
        grabbed = true
        print("✅ Clicked egg")
    end
    
    -- Method 2: Touch
    if not grabbed then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                egg.Touched:Fire(part)
            end
        end
        grabbed = true
        print("✅ Touched egg")
    end
    
    -- Method 3: ProximityPrompt
    if not grabbed then
        local prompt = egg:FindFirstChild("ProximityPrompt")
        if prompt then
            prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            grabbed = true
            print("✅ Used ProximityPrompt")
        end
    end
    
    if grabbed then
        print("✅ Egg stolen successfully!")
    else
        print("⚠️ Could not grab egg, try manually")
    end
end

local function ReturnToBase()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Find base
    local base = Workspace:FindFirstChild("Base")
    if not base or not base:IsA("BasePart") then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("base") or obj.Name:lower():find("spawn")) then
                base = obj
                break
            end
        end
    end
    
    if base and base:IsA("BasePart") then
        root.CFrame = CFrame.new(base.Position + Vector3.new(0, 3, 0))
        print("🏠 Returned to base")
    else
        print("⚠️ Base not found")
    end
end

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil

local function StartFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyConnection then flyConnection:Disconnect() end
    
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root
    
    flyConnection = RunService.Heartbeat:Connect(function()
        if not Config.FlyEnabled then return end
        if not root or not root.Parent then
            StopFly()
            return
        end
        
        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * 50
        end
        
        flyBodyVelocity.Velocity = moveDirection
    end)
end

local function StopFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
end

-- ============================================================
--  WALKSPEED
-- ============================================================
local function ApplyWalkSpeed(speed)
    Config.WalkSpeed = speed
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then humanoid.WalkSpeed = speed end
    end
end

-- ============================================================
--  MAIN LOOP
-- ============================================================
RunService.Heartbeat:Connect(function()
    -- Godmode
    if Config.Godmode then
        ApplyGodmode()
    end
    
    -- Anti-Guard
    if Config.AntiGuard then
        AntiGuard()
    end
    
    -- Egg Protection
    if Config.EggProtection then
        ProtectEgg()
    end
    
    -- Auto Steal & Return
    if Config.AutoSteal then
        StealEgg()
        task.wait(0.5)
        if Config.AutoReturn then
            ReturnToBase()
            task.wait(0.5)
        end
    end
end)

-- ============================================================
--  CHARACTER RESPAWN HANDLER
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Config.Godmode then ApplyGodmode() end
    if Config.FlyEnabled then StartFly() end
    ApplyWalkSpeed(Config.WalkSpeed)
end)

-- ============================================================
--  GUI
-- ============================================================
local function CreateGUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "StealAnEggBypass"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 340, 0, 480)
    frame.Position = UDim2.new(0.5, -170, 0.5, -240)
    frame.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    title.BackgroundTransparency = 0.3
    title.Text = "🥚 STEAL AN EGG - BYPASS"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = frame
    
    -- ======== PROTECTION SECTION ========
    local cat1 = Instance.new("TextLabel")
    cat1.Size = UDim2.new(1, 0, 0, 22)
    cat1.Position = UDim2.new(0, 5, 0, 45)
    cat1.BackgroundTransparency = 1
    cat1.Text = "🛡️ PROTECTION"
    cat1.TextColor3 = Color3.fromRGB(200, 200, 220)
    cat1.TextScaled = true
    cat1.Font = Enum.Font.GothamBold
    cat1.TextXAlignment = Enum.TextXAlignment.Left
    cat1.Parent = frame
    
    -- Godmode Toggle
    local function CreateToggle(label, configKey, yPos, defaultColor)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.5, 0, 0, 26)
        lbl.Position = UDim2.new(0.05, 0, 0, yPos)
        lbl.BackgroundTransparency = 1
        lbl.Text = label
        lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
        lbl.TextScaled = true
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = frame
        
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.2, 0, 0, 26)
        btn.Position = UDim2.new(0.6, 0, 0, yPos + 1)
        btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        btn.Text = Config[configKey] and "ON" or "OFF"
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextScaled = true
        btn.Font = Enum.Font.GothamBold
        btn.BorderSizePixel = 0
        btn.Parent = frame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 6)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            Config[configKey] = not Config[configKey]
            btn.BackgroundColor3 = Config[configKey] and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
            btn.Text = Config[configKey] and "ON" or "OFF"
            if configKey == "FlyEnabled" then
                if Config.FlyEnabled then StartFly() else StopFly() end
            elseif configKey == "WalkSpeed" then
                -- Handled by slider
            end
        end)
        
        return btn
    end
    
    CreateToggle("🛡️ Godmode", "Godmode", 72)
    CreateToggle("👀 Anti-Guard", "AntiGuard", 103)
    CreateToggle("🥚 Egg Protect", "EggProtection", 134)
    
    -- ======== AUTO SECTION ========
    local cat2 = Instance.new("TextLabel")
    cat2.Size = UDim2.new(1, 0, 0, 22)
    cat2.Position = UDim2.new(0, 5, 0, 170)
    cat2.BackgroundTransparency = 1
    cat2.Text = "🤖 AUTO"
    cat2.TextColor3 = Color3.fromRGB(200, 200, 220)
    cat2.TextScaled = true
    cat2.Font = Enum.Font.GothamBold
    cat2.TextXAlignment = Enum.TextXAlignment.Left
    cat2.Parent = frame
    
    CreateToggle("🥚 Auto Steal", "AutoSteal", 197)
    CreateToggle("🏠 Auto Return", "AutoReturn", 228)
    
    -- ======== MOVEMENT SECTION ========
    local cat3 = Instance.new("TextLabel")
    cat3.Size = UDim2.new(1, 0, 0, 22)
    cat3.Position = UDim2.new(0, 5, 0, 268)
    cat3.BackgroundTransparency = 1
    cat3.Text = "✈️ MOVEMENT"
    cat3.TextColor3 = Color3.fromRGB(200, 200, 220)
    cat3.TextScaled = true
    cat3.Font = Enum.Font.GothamBold
    cat3.TextXAlignment = Enum.TextXAlignment.Left
    cat3.Parent = frame
    
    CreateToggle("🛫 Fly", "FlyEnabled", 295)
    
    -- Walkspeed Slider
    local wsLabel = Instance.new("TextLabel")
    wsLabel.Size = UDim2.new(0.45, 0, 0, 26)
    wsLabel.Position = UDim2.new(0.05, 0, 0, 326)
    wsLabel.BackgroundTransparency = 1
    wsLabel.Text = "Walkspeed: " .. Config.WalkSpeed
    wsLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    wsLabel.TextScaled = true
    wsLabel.Font = Enum.Font.GothamMedium
    wsLabel.TextXAlignment = Enum.TextXAlignment.Left
    wsLabel.Parent = frame
    
    local wsSlider = Instance.new("Frame")
    wsSlider.Size = UDim2.new(0.35, 0, 0, 5)
    wsSlider.Position = UDim2.new(0.55, 0, 0, 337)
    wsSlider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    wsSlider.Parent = frame
    
    local wsCorner = Instance.new("UICorner")
    wsCorner.CornerRadius = UDim.new(0, 3)
    wsCorner.Parent = wsSlider
    
    local wsFill = Instance.new("Frame")
    wsFill.Size = UDim2.new((Config.WalkSpeed - 10) / 90, 0, 1, 0)
    wsFill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    wsFill.Parent = wsSlider
    local wsFillCorner = Instance.new("UICorner")
    wsFillCorner.CornerRadius = UDim.new(0, 3)
    wsFillCorner.Parent = wsFill
    
    -- ======== MANUAL CONTROLS ========
    local cat4 = Instance.new("TextLabel")
    cat4.Size = UDim2.new(1, 0, 0, 22)
    cat4.Position = UDim2.new(0, 5, 0, 365)
    cat4.BackgroundTransparency = 1
    cat4.Text = "🎮 MANUAL CONTROLS"
    cat4.TextColor3 = Color3.fromRGB(200, 200, 220)
    cat4.TextScaled = true
    cat4.Font = Enum.Font.GothamBold
    cat4.TextXAlignment = Enum.TextXAlignment.Left
    cat4.Parent = frame
    
    local stealBtn = Instance.new("TextButton")
    stealBtn.Size = UDim2.new(0.38, 0, 0, 30)
    stealBtn.Position = UDim2.new(0.05, 0, 0, 392)
    stealBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    stealBtn.Text = "🥚 Steal Egg"
    stealBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    stealBtn.TextScaled = true
    stealBtn.Font = Enum.Font.GothamBold
    stealBtn.BorderSizePixel = 0
    stealBtn.Parent = frame
    local stealCorner = Instance.new("UICorner")
    stealCorner.CornerRadius = UDim.new(0, 6)
    stealCorner.Parent = stealBtn
    
    local returnBtn = Instance.new("TextButton")
    returnBtn.Size = UDim2.new(0.38, 0, 0, 30)
    returnBtn.Position = UDim2.new(0.57, 0, 0, 392)
    returnBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
    returnBtn.Text = "🏠 Return"
    returnBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    returnBtn.TextScaled = true
    returnBtn.Font = Enum.Font.GothamBold
    returnBtn.BorderSizePixel = 0
    returnBtn.Parent = frame
    local returnCorner = Instance.new("UICorner")
    returnCorner.CornerRadius = UDim.new(0, 6)
    returnCorner.Parent = returnBtn
    
    -- Close Button
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 25, 0, 25)
    close.Position = UDim2.new(1, -35, 0, 8)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    close.Text = "✕"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.BorderSizePixel = 0
    close.Parent = frame
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = close
    
    close.MouseButton1Click:Connect(function()
        if Config.FlyEnabled then StopFly() end
        screenGui:Destroy()
        print("❌ GUI closed")
    end)
    
    -- ======== SLIDER CONTROLS ========
    local wsDragging = false
    local function updateWsSlider(input)
        local mouseX = input.Position.X
        local sliderPos = wsSlider.AbsolutePosition.X
        local sliderWidth = wsSlider.AbsoluteSize.X
        local rel = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(10 + rel * 90)
        wsLabel.Text = "Walkspeed: " .. newSpeed
        wsFill.Size = UDim2.new(rel, 0, 1, 0)
        ApplyWalkSpeed(newSpeed)
    end
    
    wsSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = true
            updateWsSlider(input)
        end
    end)
    wsSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if wsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateWsSlider(input)
        end
    end)
    
    -- ======== MANUAL BUTTONS ========
    stealBtn.MouseButton1Click:Connect(function()
        StealEgg()
    end)
    
    returnBtn.MouseButton1Click:Connect(function()
        ReturnToBase()
    end)
    
    -- ======== TOGGLE GUI WITH R ========
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)
    
    print("✅ GUI loaded! Press R to toggle.")
end

-- ============================================================
--  START
-- ============================================================
task.wait(0.5)
CreateGUI()
ApplyWalkSpeed(Config.WalkSpeed)
print("🥚 STEAL AN EGG - ULTIMATE BYPASS LOADED!")
print("📌 R = toggle GUI")
]])()
