loadstring([[
-- ============================================================
--  GUI: Fly + WalkSpeed + Teleport Points + Click Teleport
-- ============================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
--  CONFIG
-- ============================================================
local Config = {
    FlyEnabled = false,
    WalkSpeed = 16,            -- default walkspeed
    TeleportEnabled = false,
}

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil

local function startFly(speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyConnection then flyConnection:Disconnect() end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root

    flyConnection = RunService.Heartbeat:Connect(function(dt)
        if not Config.FlyEnabled then return end
        if not root or not root.Parent then
            stopFly()
            return
        end

        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * 50 -- fly speed fixed at 50
        end

        flyBodyVelocity.Velocity = moveDirection
    end)

    print("🛫 Fly ON")
end

local function stopFly()
    if flyBodyVelocity then
        flyBodyVelocity:Destroy()
        flyBodyVelocity = nil
    end
    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end
    print("🛬 Fly OFF")
end

local function toggleFly()
    Config.FlyEnabled = not Config.FlyEnabled
    if Config.FlyEnabled then
        startFly(50)
    else
        stopFly()
    end
end

-- ============================================================
--  WALKSPEED SYSTEM
-- ============================================================
local function updateWalkSpeed(speed)
    Config.WalkSpeed = speed
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = speed
        end
    end
end

-- ============================================================
--  CLICK TELEPORT SYSTEM
-- ============================================================
local teleportConnection = nil

local function startTeleport()
    if teleportConnection then teleportConnection:Disconnect() end
    teleportConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not Config.TeleportEnabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

        local mouse = LocalPlayer:GetMouse()
        if not mouse then return end

        local hitPosition = mouse.Hit.Position
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        root.CFrame = CFrame.new(hitPosition + Vector3.new(0, 3, 0))
        print("📍 Teleported to: " .. tostring(hitPosition))
    end)
    print("🖱️ Click Teleport ON")
end

local function stopTeleport()
    if teleportConnection then
        teleportConnection:Disconnect()
        teleportConnection = nil
    end
    print("🖱️ Click Teleport OFF")
end

local function toggleTeleport()
    Config.TeleportEnabled = not Config.TeleportEnabled
    if Config.TeleportEnabled then
        startTeleport()
    else
        stopTeleport()
    end
end

-- ============================================================
--  TELEPORT POINTS SYSTEM
-- ============================================================
local teleportPoints = {}
local pointsList = {}

local function savePoint(name)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    teleportPoints[name] = root.Position
    print("📍 Point '" .. name .. "' saved at " .. tostring(root.Position))
    updatePointsList()
end

local function teleportToPoint(name)
    local pos = teleportPoints[name]
    if not pos then
        print("❌ Point '" .. name .. "' not found")
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    print("📍 Teleported to point '" .. name .. "'")
end

local function deletePoint(name)
    teleportPoints[name] = nil
    updatePointsList()
    print("🗑️ Point '" .. name .. "' deleted")
end

local function updatePointsList()
    -- This is called to refresh the GUI list; we'll rebuild the points frame each time
    -- We'll handle this in the GUI creation loop
end

-- ============================================================
--  GUI CREATION
-- ============================================================
