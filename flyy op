    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame

    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.Position = UDim2.new(0, 0, 0, 0)
    title.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    title.BackgroundTransparency = 0.3
    title.Text = "🛸 Fly + Teleport Points"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = frame

    -- Fly Toggle
    local flyLabel = Instance.new("TextLabel")
    flyLabel.Size = UDim2.new(0.45, 0, 0, 30)
    flyLabel.Position = UDim2.new(0.05, 0, 0, 50)
    flyLabel.BackgroundTransparency = 1
    flyLabel.Text = "🛫 Fly:"
    flyLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    flyLabel.TextScaled = true
    flyLabel.Font = Enum.Font.GothamMedium
    flyLabel.TextXAlignment = Enum.TextXAlignment.Left
    flyLabel.Parent = frame

    local flyBtn = Instance.new("TextButton")
    flyBtn.Size = UDim2.new(0.2, 0, 0, 28)
    flyBtn.Position = UDim2.new(0.55, 0, 0, 51)
    flyBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    flyBtn.Text = "OFF"
    flyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    flyBtn.TextScaled = true
    flyBtn.Font = Enum.Font.GothamBold
    flyBtn.BorderSizePixel = 0
    flyBtn.Parent = frame

    local flyCorner = Instance.new("UICorner")
    flyCorner.CornerRadius = UDim.new(0, 6)
    flyCorner.Parent = flyBtn

    -- Walkspeed Slider
    local wsLabel = Instance.new("TextLabel")
    wsLabel.Size = UDim2.new(0.45, 0, 0, 25)
    wsLabel.Position = UDim2.new(0.05, 0, 0, 85)
    wsLabel.BackgroundTransparency = 1
    wsLabel.Text = "Walkspeed: " .. Config.WalkSpeed
    wsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    wsLabel.TextScaled = true
    wsLabel.Font = Enum.Font.GothamMedium
    wsLabel.TextXAlignment = Enum.TextXAlignment.Left
    wsLabel.Parent = frame

    local wsSlider = Instance.new("Frame")
    wsSlider.Size = UDim2.new(0.4, 0, 0, 6)
    wsSlider.Position = UDim2.new(0.55, 0, 0, 95)
    wsSlider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    wsSlider.Parent = frame

    local wsCorner = Instance.new("UICorner")
    wsCorner.CornerRadius = UDim.new(0, 3)
    wsCorner.Parent = wsSlider

    local wsFill = Instance.new("Frame")
    wsFill.Size = UDim2.new((Config.WalkSpeed - 10) / 90, 0, 1, 0) -- range 10-100
    wsFill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    wsFill.Parent = wsSlider

    local wsFillCorner = Instance.new("UICorner")
    wsFillCorner.CornerRadius = UDim.new(0, 3)
    wsFillCorner.Parent = wsFill

    -- Teleport Click Toggle
    local teleLabel = Instance.new("TextLabel")
    teleLabel.Size = UDim2.new(0.45, 0, 0, 30)
    teleLabel.Position = UDim2.new(0.05, 0, 0, 120)
    teleLabel.BackgroundTransparency = 1
    teleLabel.Text = "🖱️ Click Teleport:"
    teleLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    teleLabel.TextScaled = true
    teleLabel.Font = Enum.Font.GothamMedium
    teleLabel.TextXAlignment = Enum.TextXAlignment.Left
    teleLabel.Parent = frame

    local teleBtn = Instance.new("TextButton")
    teleBtn.Size = UDim2.new(0.2, 0, 0, 28)
    teleBtn.Position = UDim2.new(0.55, 0, 0, 121)
    teleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    teleBtn.Text = "OFF"
    teleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    teleBtn.TextScaled = true
    teleBtn.Font = Enum.Font.GothamBold
    teleBtn.BorderSizePixel = 0
    teleBtn.Parent = frame

    local teleCorner = Instance.new("UICorner")
    teleCorner.CornerRadius = UDim.new(0, 6)
    teleCorner.Parent = teleBtn

    -- Teleport Points Section
    local pointsTitle = Instance.new("TextLabel")
    pointsTitle.Size = UDim2.new(1, 0, 0, 25)
    pointsTitle.Position = UDim2.new(0, 0, 0, 160)
    pointsTitle.BackgroundTransparency = 1
    pointsTitle.Text = "📍 Teleport Points"
    pointsTitle.TextColor3 = Color3.fromRGB(255, 180, 50)
    pointsTitle.TextScaled = true
    pointsTitle.Font = Enum.Font.GothamBold
    pointsTitle.Parent = frame

    -- Input for point name
    local pointNameBox = Instance.new("TextBox")
    pointNameBox.Size = UDim2.new(0.5, 0, 0, 28)
    pointNameBox.Position = UDim2.new(0.05, 0, 0, 190)
    pointNameBox.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
    pointNameBox.Text = "point name"
    pointNameBox.TextColor3 = Color3.fromRGB(200, 200, 200)
    pointNameBox.TextScaled = true
    pointNameBox.Font = Enum.Font.GothamMedium
    pointNameBox.BorderSizePixel = 0
    pointNameBox.Parent = frame

    local nameCorner = Instance.new("UICorner")
    nameCorner.CornerRadius = UDim.new(0, 6)
    nameCorner.Parent = pointNameBox

    -- Save Point Button
    local saveBtn = Instance.new("TextButton")
    saveBtn.Size = UDim2.new(0.3, 0, 0, 28)
    saveBtn.Position = UDim2.new(0.6, 0, 0, 190)
    saveBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    saveBtn.Text = "Save"
    saveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    saveBtn.TextScaled = true
    saveBtn.Font = Enum.Font.GothamBold
    saveBtn.BorderSizePixel = 0
    saveBtn.Parent = frame

    local saveCorner = Instance.new("UICorner")
    saveCorner.CornerRadius = UDim.new(0, 6)
    saveCorner.Parent = saveBtn

    -- Points List Frame (scrollable)
    local pointsFrame = Instance.new("Frame")
    pointsFrame.Size = UDim2.new(1, -10, 0, 160)
    pointsFrame.Position = UDim2.new(0, 5, 0, 230)
    pointsFrame.BackgroundColor3 = Color3.fromRGB(30, 32, 40)
    pointsFrame.BackgroundTransparency = 0.5
    pointsFrame.BorderSizePixel = 0
    pointsFrame.Parent = frame

    local pointsCorner = Instance.new("UICorner")
    pointsCorner.CornerRadius = UDim.new(0, 8)
    pointsCorner.Parent = pointsFrame

    local pointsListFrame = Instance.new("ScrollingFrame")
    pointsListFrame.Size = UDim2.new(1, 0, 1, 0)
    pointsListFrame.BackgroundTransparency = 1
    pointsListFrame.BorderSizePixel = 0
    pointsListFrame.ScrollBarThickness = 6
    pointsListFrame.ScrollBarImageColor3 = Color3.fromRGB(255, 180, 50)
    pointsListFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    pointsListFrame.Parent = pointsFrame

    -- Close Button
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 25, 0, 25)
    close.Position = UDim2.new(1, -35, 0, 8)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    close.Text = "✕"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.BorderSizePixel = 0
    close.Parent = frame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = close

    close.MouseButton1Click:Connect(function()
        if Config.FlyEnabled then toggleFly() end
        if Config.TeleportEnabled then toggleTeleport() end
        screenGui:Destroy()
        print("❌ GUI closed")
    end)

    -- ============================================================
    --  FUNCTIONS TO UPDATE POINTS LIST
    -- ============================================================
    local function refreshPointsList()
        -- Clear existing buttons
        for _, child in ipairs(pointsListFrame:GetChildren()) do
            if child:IsA("TextButton") then
                child:Destroy()
            end
        end

        local yPos = 0
        local pointNames = {}
        for name, _ in pairs(teleportPoints) do
            table.insert(pointNames, name)
        end
        table.sort(pointNames)

        for _, name in ipairs(pointNames) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 28)
            btn.Position = UDim2.new(0, 2, 0, yPos)
            btn.BackgroundColor3 = Color3.fromRGB(50, 52, 60)
            btn.Text = name
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextScaled = true
            btn.Font = Enum.Font.GothamMedium
            btn.BorderSizePixel = 0
            btn.Parent = pointsListFrame

            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = btn

            -- Click to teleport
            btn.MouseButton1Click:Connect(function()
                teleportToPoint(name)
            end)

            -- Right-click to delete (optional)
            btn.MouseButton2Click:Connect(function()
                deletePoint(name)
                refreshPointsList()
            end)

            yPos = yPos + 32
        end

        pointsListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
    end

    -- Save button
    saveBtn.MouseButton1Click:Connect(function()
        local name = pointNameBox.Text
        if name and name ~= "" and name ~= "point name" then
            savePoint(name)
            refreshPointsList()
        else
            print("❌ Please enter a valid point name")
        end
    end)

    -- Initial refresh
    refreshPointsList()

    -- ============================================================
    --  BUTTON EVENTS
    -- ============================================================
    flyBtn.MouseButton1Click:Connect(function()
        toggleFly()
        flyBtn.BackgroundColor3 = Config.FlyEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        flyBtn.Text = Config.FlyEnabled and "ON" or "OFF"
    end)

    teleBtn.MouseButton1Click:Connect(function()
        toggleTeleport()
        teleBtn.BackgroundColor3 = Config.TeleportEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        teleBtn.Text = Config.TeleportEnabled and "ON" or "OFF"
    end)

    -- Walkspeed Slider
    local wsDragging = false
    local function updateWalkSpeedFromSlider(input)
        local mouseX = input.Position.X
        local sliderPos = wsSlider.AbsolutePosition.X
        local sliderWidth = wsSlider.AbsoluteSize.X
        local relativeX = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(10 + relativeX * 90) -- range 10-100
        wsLabel.Text = "Walkspeed: " .. newSpeed
        wsFill.Size = UDim2.new(relativeX, 0, 1, 0)
        updateWalkSpeed(newSpeed)
    end

    wsSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = true
            updateWalkSpeedFromSlider(input)
        end
    end)

    wsSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = false
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if wsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateWalkSpeedFromSlider(input)
        end
    end)

    -- Toggle GUI with R
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)

    -- Refresh points list when points change (already done in save/delete)
    -- Also refresh when GUI opens? We'll update on save/delete.

    print("✅ GUI loaded! Press R to toggle.")
end

-- ============================================================
--  HANDLE CHARACTER RESPAWN
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function()
    if Config.FlyEnabled then
        task.wait(0.5)
        startFly(50)
    end
    -- Apply walkspeed on respawn
    task.wait(0.5)
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = Config.WalkSpeed
        end
    end
end)

-- ============================================================
--  START
-- ============================================================
task.wait(0.5)
CreateGUI()
print("🛸 Fly + Teleport Points GUI ready!")
print("📌 R = toggle GUI")
print("📍 Right-click a point name to delete it")
]])()
