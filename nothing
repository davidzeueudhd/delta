-- ==============================
-- GRÜNER MARKER (SICHTBAR!)
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(10, 2, 10)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.2
    marker.Parent = Workspace
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 300, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 FAKE POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 30
    glow.Brightness = 10
    
    game:GetService("Debris"):AddItem(marker, 30)
    print("🟢 Marker gesetzt an: " .. tostring(position))
    return marker
end

