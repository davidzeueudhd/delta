-- ==============================
-- DESYNC (1.000.000 STUDS)
-- ==============================
local offset = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    local target = Vector3.new(
        math.random(-100000000, 100000000) / 100,  -- 1.000.000 Studs
        math.random(-20000000, 20000000) / 100,
        math.random(-100000000, 100000000) / 100
    )
    
    offset = offset:Lerp(target, 0.05)
    rootPart.CFrame = rootPart.CFrame + offset
end)

