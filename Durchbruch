--[[
    TANK DESYNC - SEHR STARK
    - Desync: 2,0 Studs (sehr stark)
    - Frequenz: Alle 6 Frames
    - WalkSpeed: 35 (NORMAL)
    - Kein Jump (für Tank optimiert)
    - Grüne Marker: Alle 15 Bewegungen
    - WARNUNG: EXTREM RISKANT!
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local client = Players.LocalPlayer
local clientCharacter = client.Character or client.CharacterAdded:Wait()
local rootPart = clientCharacter:WaitForChild("HumanoidRootPart")

-- ==============================
-- GRÜNER MARKER
-- ==============================
local function createMarker(position)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(3, 0.5, 3)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.4
    marker.Parent = Workspace
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 8
    glow.Brightness = 1.5
    
    game:GetService("Debris"):AddItem(marker, 15)
    return marker
end

-- ==============================
-- DESYNC (2,0 Studs)
-- ==============================
local isRunning = true
local counter = 0
local originalPosition = rootPart.Position

createMarker(originalPosition)
print("🟢 Startposition markiert")

-- Desync-Loop (ALLE 6 FRAMES)
RunService.Heartbeat:Connect(function()
    if not isRunning then return end
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    
    -- NUR ALLE 6 FRAMES
    if counter % 6 == 0 then
        local currentPos = rootPart.Position
        local newPos = Vector3.new(
            currentPos.X + math.random(-200, 200) / 100,  -- 2,0 Studs
            currentPos.Y + math.random(-40, 40) / 100,
            currentPos.Z + math.random(-200, 200) / 100
        )
        
        -- Sanfte Rotation (für Tank)
        rootPart.CFrame = CFrame.new(newPos) * CFrame.Angles(
            math.rad(math.random(-3, 3) / 10),
            math.rad(math.random(-6, 6) / 10),
            math.rad(math.random(-3, 3) / 10)
        )
        
        -- Alle 15 Bewegungen neuer Marker
        if counter % 15 == 0 then
            createMarker(rootPart.Position)
            print("🟢 Neue Position markiert")
        end
    end
end)

-- ==============================
-- WALKSPEED (NORMAL)
-- ==============================
local humanoid = clientCharacter:WaitForChild("Humanoid")
humanoid.WalkSpeed = 35  -- NORMAL

-- KEIN JUMPPOWER (nicht nötig für Tank!)

-- ==============================
-- F-TASTE ZUM TOGGLEN
-- ==============================
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        isRunning = not isRunning
        if isRunning then
            print("🟢 Desync REAKTIVIERT")
            createMarker(rootPart.Position)
        else
            print("🔴 Desync PAUSIERT")
        end
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
client.CharacterAdded:Connect(function(newChar)
    clientCharacter = newChar
    rootPart = clientCharacter:WaitForChild("HumanoidRootPart")
    humanoid = clientCharacter:WaitForChild("Humanoid")
    humanoid.WalkSpeed = 35  -- NORMAL
    createMarker(rootPart.Position)
end)

print("💀 TANK DESYNC - SEHR STARK GELADEN!")
print("📌 Desync: 2,0 Studs (sehr stark)")
print("📌 Frequenz: Alle 6 Frames")
print("📌 WalkSpeed: 35 (NORMAL)")
print("📌 KEIN JUMP (für Tank optimiert)")
print("📌 Grüne Marker: Alle 15 Bewegungen")
print("📌 F = PAUSE/WEITER")
print("⚠️ EXTREM RISKANT - NUR AUF WEGWERF-ACCOUNTS!")
