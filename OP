function FlightSystem:Toggle()
    self.Enabled = not self.Enabled
    
    if self.Enabled then
        self:Activate()
    else
        self:Deactivate()
    end
end

function FlightSystem:Activate()
    local character = SYS.Plr.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    
    self.BodyGyro = Instance.new("BodyGyro")
    self.BodyGyro.P = 9e4
    self.BodyGyro.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    self.BodyGyro.CFrame = rootPart.CFrame
    self.BodyGyro.Parent = rootPart
    
    self.BodyVelocity = Instance.new("BodyVelocity")
    self.BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    self.BodyVelocity.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    self.BodyVelocity.Parent = rootPart
    
    humanoid.PlatformStand = true
    
    local inputConn
    inputConn = SYS.UIS.InputBegan:Connect(function(input)
        if input.KeyCode == self.Keys.Toggle then
            self:Toggle()
        end
    end)
    table.insert(self.Connections, inputConn)
    
    local flightLoop
    flightLoop = SYS.RS.RenderStepped:Connect(function()
        if not self.Enabled or not self.BodyVelocity then
            flightLoop:Disconnect()
            return
        end
        
        local velocity = Vector3.new(0, 0, 0)
        
        if SYS.UIS:IsKeyDown(self.Keys.Forward) then
            velocity = velocity + (self.BodyGyro.CFrame.LookVector * self.Speed)
        end
        if SYS.UIS:IsKeyDown(self.Keys.Backward) then
            velocity = velocity - (self.BodyGyro.CFrame.LookVector * self.Speed)
        end
        if SYS.UIS:IsKeyDown(self.Keys.Right) then
            velocity = velocity + (self.BodyGyro.CFrame.RightVector * self.Speed)
        end
        if SYS.UIS:IsKeyDown(self.Keys.Left) then
            velocity = velocity - (self.BodyGyro.CFrame.RightVector * self.Speed)
        end
        if SYS.UIS:IsKeyDown(self.Keys.Up) then
            velocity = velocity + (Vector3.new(0, 2, 0) * self.VerticalSpeed)
        end
        if SYS.UIS:IsKeyDown(self.Keys.Down) then
            velocity = velocity - (Vector3.new(0, 0.5, 0) * self.VerticalSpeed)
        end
        
        self.BodyVelocity.Velocity = velocity
    end)
    table.insert(self.Connections, flightLoop)
end

function FlightSystem:Deactivate()
    if self.BodyGyro then
        self.BodyGyro:Destroy()
        self.BodyGyro = nil
    end
    
    if self.BodyVelocity then
        self.BodyVelocity:Destroy()
        self.BodyVelocity = nil
    end
    
    local character = SYS.Plr.Character
    if character then
        local humanoid = character:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
        end
    end
    
    for _, conn in pairs(self.Connections) do
        conn:Disconnect()
    end
    self.Connections = {}
end

function FlightSystem:SetSpeed(newSpeed)
