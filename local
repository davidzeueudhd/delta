-- ============================
-- Logic
-- ============================
local scanInterval = DEFAULT_SCAN_INTERVAL
local running = false
local loopTask = nil

local function updateStatus(s)
    status.Text = "Status: " .. tostring(s)
end

local function scanAndPopulate()
    updateStatus("Scanning...")
    clearList()
    local eggs = gatherEggCandidates()
    updateStatus(string.format("Scan complete — %d found", #eggs))
    local count = 0
    for _, e in ipairs(eggs) do
        if count >= MAX_LIST_ITEMS then break end
        local name = e:GetFullName()
        addListItem(name, e)
        count = count + 1
    end
    if #eggs == 0 then
        addListItem("No eggs found", nil)
    end
    return eggs
end

local function autoCollectLoop()
    updateStatus("Running")
    while running do
        local eggs = gatherEggCandidates()
        if #eggs == 0 then
            updateStatus("Running — no eggs found")
            task.wait(scanInterval)
        else
            for _, egg in ipairs(eggs) do
                if not running then break end
                if egg and egg:IsDescendantOf(Workspace) then
                    updateStatus("Collecting: " .. tostring(egg:GetFullName()))
                    local ok, result = pcall(tryCollectEgg, egg)
                    if ok and result then
                        updateStatus("Collected: " .. tostring(egg:GetFullName()))
                    else
                        updateStatus("Failed/time out: " .. tostring(egg:GetFullName()))
                    end
                    task.wait(0.2)
                end
            end
        end
        if running then task.wait(scanInterval) end
    end
    updateStatus("Stopped")
end

-- Button events
startBtn.MouseButton1Click:Connect(function()
    if running then return end
    running = true
    scanAndPopulate()
    loopTask = task.spawn(autoCollectLoop)
end)

stopBtn.MouseButton1Click:Connect(function()
    running = false
end)

scanBtn.MouseButton1Click:Connect(function()
    scanAndPopulate()
end)

minusBtn.MouseButton1Click:Connect(function()
    scanInterval = math.max(0.1, scanInterval - 0.25)
    intLabel.Text = string.format("Scan Interval: %.2f s", scanInterval)
end)
plusBtn.MouseButton1Click:Connect(function()
    scanInterval = math.min(10, scanInterval + 0.25)
    intLabel.Text = string.format("Scan Interval: %.2f s", scanInterval)
end)

