-- ============================
-- CONFIG
-- ============================
local ADMIN_USERIDS = {
    LocalPlayer.UserId, -- default: allow current studio tester
    -- add other trusted UserIds here e.g. 12345678
}

local TELEPORT_OFFSET = Vector3.new(0, 3, 0) -- position above egg
local PER_EGG_TIMEOUT = 3                    -- seconds to wait per egg
local DEFAULT_SCAN_INTERVAL = 1.0            -- seconds between scans when running
local MAX_LIST_ITEMS = 100                   -- max eggs shown in GUI list

-- ============================
-- Utilities
-- ============================
local function isAdmin(userId)
    for _, id in ipairs(ADMIN_USERIDS) do
        if id == userId then return true end
    end
    return false
end

if not isAdmin(LocalPlayer.UserId) then
    warn("[AutoEgg GUI] Not an allowed admin. Script will not run for this player.")
    return
end

local function isEggPart(part)
    if not part or not part:IsA("BasePart") then return false end
    local name = (part.Name or ""):lower()
    if name == "egg" or name:find("egg") then
        return true
    end
    if part:FindFirstChild("Egg") or part:FindFirstChild("IsEgg") then
        return true
    end
    local prompt = part:FindFirstChildOfClass("ProximityPrompt")
    if prompt and ((prompt.Name or ""):lower():find("egg") or name:find("egg")) then
        return true
    end
    return false
end

local function gatherEggCandidates()
    local eggs = {}

    -- 1) CollectionService tagged eggs
    local ok, tagged = pcall(function() return CollectionService:GetTagged("Egg") end)
    if ok and tagged and #tagged > 0 then
        for _, inst in ipairs(tagged) do
            if inst then
                if inst:IsA("BasePart") then
                    table.insert(eggs, inst)
                elseif inst:IsA("Model") then
                    local p = inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
                    if p then table.insert(eggs, p) end
                end
            end
        end
    end

    -- 2) Workspace.Biomes.*.Eggs folder pattern
    local biomes = Workspace:FindFirstChild("Biomes")
    if biomes then
        for _, biome in ipairs(biomes:GetChildren()) do
            local folder = biome:FindFirstChild("Eggs") or biome:FindFirstChild("eggs")
            if folder then
                for _, desc in ipairs(folder:GetDescendants()) do
                    if desc:IsA("BasePart") then table.insert(eggs, desc) end
                end
            end
        end
    end

    -- 3) Global scan for parts named "egg" or containing ProximityPrompt with egg
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if inst:IsA("BasePart") and inst.Parent then
            if isEggPart(inst) then
                table.insert(eggs, inst)
            end
        end
    end

    -- Deduplicate by Instance
    local seen = {}
    local unique = {}
    for _, v in ipairs(eggs) do
        if v and v:IsDescendantOf(Workspace) then
            if not seen[v] then
                seen[v] = true
                table.insert(unique, v)
            end
        end
    end

    return unique
end

local function isCollected(egg)
    if not egg then return true end
    if not egg.Parent then return true end
    if not egg:IsDescendantOf(Workspace) then return true end
    -- If tagged and tag removed, treat as collected
    local ok, tagged = pcall(function() return CollectionService:GetTagged("Egg") end)
    if ok and tagged then
        for _, t in ipairs(tagged) do
            if t == egg then return false end
        end
        -- not found in tag list -> possibly collected
    end
    return false
end

local function safeTeleport(position)
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not root then return false end

    pcall(function()
        if humanoid then humanoid.PlatformStand = true end
        root.CFrame = CFrame.new(position)
        task.wait(0.05)
        if humanoid then humanoid.PlatformStand = false end
    end)
    return true
end

local function tryCollectEgg(egg)
    if not egg or not egg.Parent then return false end
    local pos = egg.Position + TELEPORT_OFFSET
    safeTeleport(pos)

    local start = os.clock()
    while os.clock() - start < PER_EGG_TIMEOUT do
        if isCollected(egg) then return true end
        task.wait(0.12)
    end

    -- try a higher teleport if not collected
    safeTeleport(egg.Position + Vector3.new(0, 6, 0))
    start = os.clock()
    while os.clock() - start < PER_EGG_TIMEOUT do
        if isCollected(egg) then return true end
        task.wait(0.12)
    end

    return isCollected(egg)
end

