-- Slider Logic
local dragging = false
local function updateSlider(mouseX)
    local relativeX = math.clamp((mouseX - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
    local value = math.round(relativeX * 80) + 10
    if value < 10 then value = 10 end
    if value > 90 then value = 90 end
    
    sliderFill.Size = UDim2.new((value - 10) / 80, 0, 1, 0)
    sliderButton.Position = UDim2.new((value - 10) / 80, -10, -0.5, 0)
    updateWalkSpeed(value)
end

sliderButton.MouseButton1Down:Connect(function()
    dragging = true
end)

sliderButton.MouseButton1Up:Connect(function()
    dragging = false
end)

sliderButton.MouseLeave:Connect(function()
    dragging = false
end)

game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input.Position.X)
    end
end)

