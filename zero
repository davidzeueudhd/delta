local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

print("🔥 MAXIMALER DESYNC STARTET...")

-- ==============================
-- RESET 1x
-- ==============================
print("🔄 Reset...")
character.Humanoid.Health = 0
local newChar = player.CharacterAdded:Wait()
character = newChar
rootPart = character:WaitForChild("HumanoidRootPart")
print("✅ Respawned!")

-- ==============================
-- GRÜNER MARKER (SUPER SICHTBAR)
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(10, 2, 10)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.1
    marker.Parent = Workspace
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 400, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 30
    glow.Brightness = 20
    
    game:GetService("Debris"):AddItem(marker, 30)
    return marker
end

-- ==============================
-- FAKE POSITION (500 STUDS)
-- ==============================
local fakeOffset = Vector3.new(500, 50, 500)
local fakePos = rootPart.Position + fakeOffset
createMarker(fakePos, "🎯 ANDERE SEHEN DICH HIER (500 STUDS)")

-- ==============================
-- POSITION SPEICHERN
-- ==============================
local realPosition = rootPart.Position

-- ==============================
-- HOOK 1: CFrame manipulieren
-- ==============================
local hookCFrame = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "CFrame" and self == rootPart then
        return CFrame.new(realPosition + fakeOffset)
    end
    return hookCFrame(self, key)
end)

-- ==============================
-- HOOK 2: Position manipulieren
-- ==============================
local hookPosition = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "Position" and self == rootPart then
        return realPosition + fakeOffset
    end
    return hookPosition(self, key)
end)

-- ==============================
-- ZUSÄTZLICHE POSITIONSVERSCHIEBUNG
-- ==============================
local desyncOffset = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    -- Echte Position speichern
    realPosition = rootPart.Position
    
    -- Zusätzliche sanfte Verschiebung (für andere sichtbar)
    local target = Vector3.new(
        math.random(-2000, 2000) / 100,
        math.random(-200, 200) / 100,
        math.random(-2000, 2000) / 100
    )
    desyncOffset = desyncOffset:Lerp(target, 0.2)
    rootPart.CFrame = rootPart.CFrame + desyncOffset
end)

