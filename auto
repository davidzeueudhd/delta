-- manual drag replacement
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local function clearList()
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
    end
end

local function populateList(parts)
    clearList()
    if #parts == 0 then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -12, 0, 28)
        lbl.Position = UDim2.new(0, 6, 0, 6)
        lbl.BackgroundTransparency = 1
        lbl.Text = "No eggs found"
        lbl.TextColor3 = Color3.fromRGB(200,200,200)
        lbl.Font = Enum.Font.Gotham
        lbl.Parent = scroll
        return
    end

    local charRoot = currentRoot
    local count = 0
    for _, p in ipairs(parts) do
        if count >= MAX_LIST_ITEMS then break end
        count = count + 1
        local dist = charRoot and math.floor((p.Position - charRoot.Position).Magnitude) or 0
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -12, 0, 30)
        btn.Position = UDim2.new(0, 6, 0, 6 + (count-1) * 36)
        btn.BackgroundColor3 = Color3.fromRGB(40,40,45)
        btn.TextColor3 = Color3.fromRGB(230,230,230)
        btn.Text = p.Name .. " (" .. tostring(dist) .. " studs)"
        btn.Font = Enum.Font.Gotham
        btn.Parent = scroll

        btn.MouseButton1Click:Connect(function()
            safeTeleportTo(p.Position + Vector3.new(0,5,0))
        end)
    end
end

-- AUTO COLLECT
local running = false
local autoTask = nil

local function updateStatus(txt)
    status.Text = "Status: " .. tostring(txt)
end

local function singleCollectPass()
    local parts = gatherEggParts()
    populateList(parts)
    if #parts == 0 then
        updateStatus("No eggs found")
        return
    end
    for _, part in ipairs(parts) do
        if not running then break end
        if not (part and part:IsDescendantOf(Workspace)) then
            -- skip
        else
            updateStatus("Collecting: " .. part.Name)
            local ok, collected = pcall(attemptCollectPart, part)
            if ok and collected then
                updateStatus("Collected: " .. part.Name)
            else
                updateStatus("Failed/Timed out: " .. part.Name)
            end
            task.wait(0.25)
        end
    end
end

local function startAuto()
    if running then return end
    running = true
    updateStatus("Running")
    autoTask = task.spawn(function()
        while running do
            singleCollectPass()
            if running then task.wait(AUTO_SCAN_INTERVAL) end
        end
        updateStatus("Stopped")
    end)
end

local function stopAuto()
    running = false
end

-- EVENTS
startBtn.MouseButton1Click:Connect(function() startAuto() end)
stopBtn.MouseButton1Click:Connect(function() stopAuto() end)
refreshBtn.MouseButton1Click:Connect(function()
    populateList(gatherEggParts())
    updateStatus("Refreshed")
end)

-- periodic GUI refresh
task.spawn(function()
    while gui.Parent do
        if frame.Visible then
            populateList(gatherEggParts())
        end
        task.wait(GUI_REFRESH_INTERVAL)
    end
end)

