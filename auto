-- Auto Egg Collector (LocalScript, public)
-- Place: StarterPlayer > StarterPlayerScripts (Studio/testing use in places you own)
-- Features: GUI, Auto-Steal toggle, returns player to previous spot, handles respawn.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = workspace

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then return end

-- CONFIG
local TELEPORT_OFFSET = Vector3.new(0, 3, 0)   -- safe offset above egg
local PER_EGG_TIMEOUT = 3                      -- seconds to wait for server collection
local AUTO_SCAN_INTERVAL = 1.0                 -- seconds between auto scan passes
local GUI_REFRESH_INTERVAL = 8                 -- seconds to refresh GUI list
local MAX_LIST_ITEMS = 200
local RETURN_AFTER_EACH = true                 -- return to original place after each egg attempt
local MOVE_TO_FALLBACK = true                  -- if teleport doesn't work, try Humanoid:MoveTo

-- UTILITIES
local function resolveToPart(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst end
    if inst:IsA("Model") then
        if inst.PrimaryPart and inst.PrimaryPart:IsA("BasePart") then return inst.PrimaryPart end
        return inst:FindFirstChildWhichIsA("BasePart")
    end
    return nil
end

local function isEggCandidate(inst)
    if not inst then return false end
    local name = (inst.Name or ""):lower()
    if name:find("egg") or name:find("nest") then
        if name:find("treadmill") or name:find("laufband") then return false end
        return true
    end
    local ok, has = pcall(function() return CollectionService:HasTag(inst, "Egg") end)
    if ok and has then return true end
    if inst:FindFirstChild("IsEgg") or inst:FindFirstChild("Egg") then return true end
    if inst:FindFirstChildOfClass("ProximityPrompt") and name:find("egg") then return true end
    return false
end

local function gatherEggParts()
    local list = {}

    -- CollectionService tag "Egg"
    local ok, tagged = pcall(function() return CollectionService:GetTagged("Egg") end)
    if ok and tagged then
        for _, v in ipairs(tagged) do
            local p = resolveToPart(v)
            if p and p:IsDescendantOf(Workspace) then table.insert(list, p) end
        end
    end

    -- Workspace.Biomes.*.Eggs pattern
    local biomes = Workspace:FindFirstChild("Biomes")
    if biomes then
        for _, biome in ipairs(biomes:GetChildren()) do
            local folder = biome:FindFirstChild("Eggs") or biome:FindFirstChild("eggs")
            if folder then
                for _, desc in ipairs(folder:GetDescendants()) do
                    if desc:IsA("BasePart") then table.insert(list, desc)
                    elseif desc:IsA("Model") then
                        local p = resolveToPart(desc)
                        if p then table.insert(list, p) end
                    end
                end
            end
        end
    end

    -- Global name-based scan
    for _, inst in ipairs(Workspace:GetDescendants()) do
        if (inst:IsA("BasePart") or inst:IsA("Model")) and inst.Parent then
            if isEggCandidate(inst) then
                local p = resolveToPart(inst)
                if p and p:IsDescendantOf(Workspace) then table.insert(list, p) end
            end
        end
    end

    -- dedupe
    local seen = {}
    local unique = {}
    for _, p in ipairs(list) do
        if p and p:IsDescendantOf(Workspace) and not seen[p] then
            seen[p] = true
            table.insert(unique, p)
        end
    end

    return unique
end

local function isCollected(part)
    if not part then return true end
    if not part.Parent then return true end
    if not part:IsDescendantOf(Workspace) then return true end
    local ok, tagged = pcall(function() return CollectionService:GetTagged("Egg") end)
    if ok and tagged then
        for _, t in ipairs(tagged) do
            if t == part or t == part.Parent then return false end
        end
        -- not in tag list -> likely collected
    end
    return false
end

-- track character
local currentCharacter = LocalPlayer.Character
local currentRoot = currentCharacter and currentCharacter:FindFirstChild("HumanoidRootPart")
local currentHumanoid = currentCharacter and currentCharacter:FindFirstChildWhichIsA("Humanoid")
local characterChanged = false

LocalPlayer.CharacterAdded:Connect(function(ch)
    currentCharacter = ch
    currentRoot = ch:WaitForChild("HumanoidRootPart", 5)
    currentHumanoid = ch:FindFirstChildWhichIsA("Humanoid")
    characterChanged = true
    task.wait(0.2)
    characterChanged = false
end)

-- Safe teleport that tries to avoid server movement-detection side-effects
local function safeTeleportTo(pos)
    if not currentCharacter or not currentRoot then return false end
    pcall(function()
        -- Do NOT toggle PlatformStand here; that can cause character state issues and lead to reset on some servers.
        -- Try to zero velocity then set CFrame quickly.
        if currentRoot and currentRoot:IsA("BasePart") then
            pcall(function() currentRoot.Velocity = Vector3.new(0,0,0) end)
            currentRoot.CFrame = CFrame.new(pos)
            task.wait(0.06)
        end
    end)
    return true
end

local function attemptCollectPart(part)
    if not part or not part.Parent then return false end
    if not currentCharacter or not currentRoot then return false end

    -- save return location and character reference
    local beforeCFrame = currentRoot and currentRoot.CFrame or nil
    local savedCharacter = currentCharacter

    -- 1) Prefer MoveTo (walk) first to avoid teleport detection. If not allowed or it fails, fall back to teleport.
    if MOVE_TO_FALLBACK and currentHumanoid and part.Position then
        local ok, err = pcall(function()
            currentHumanoid:MoveTo(part.Position + Vector3.new(0, 1, 0))
        end)
        if ok then
            local movedStart = os.clock()
            local reached = false
            local movedConn
            movedConn = currentHumanoid.MoveToFinished:Connect(function(reachedArg)
                reached = reachedArg
            end)
            while os.clock() - movedStart < PER_EGG_TIMEOUT do
                if isCollected(part) then
                    if movedConn then movedConn:Disconnect() end
                    if RETURN_AFTER_EACH and beforeCFrame and currentRoot and currentCharacter == savedCharacter then
                        pcall(safeTeleportTo, beforeCFrame.p)
                    end
                    return true
                end
                if reached then break end
                if characterChanged then break end
                task.wait(0.12)
            end
            if movedConn then movedConn:Disconnect() end
        end
    end

    -- 2) Teleport just above the part (use as fallback)
    pcall(safeTeleportTo, part.Position + TELEPORT_OFFSET)
    local start = os.clock()
    while os.clock() - start < PER_EGG_TIMEOUT do
        if isCollected(part) then
            if RETURN_AFTER_EACH and beforeCFrame and currentRoot and currentCharacter == savedCharacter then
                pcall(safeTeleportTo, beforeCFrame.p)
            end
            return true
        end
        -- if character respawned, abort
        if characterChanged then break end
        task.wait(0.12)
    end

    -- 3) Try teleport slightly higher and give server more time
    pcall(safeTeleportTo, part.Position + Vector3.new(0, 6, 0))
    start = os.clock()
    while os.clock() - start < PER_EGG_TIMEOUT do
        if isCollected(part) then
            if RETURN_AFTER_EACH and beforeCFrame and currentRoot and currentCharacter == savedCharacter then
                pcall(safeTeleportTo, beforeCFrame.p)
            end
            return true
        end
        if characterChanged then break end
        task.wait(0.12)
    end

    -- restore original position if still present and same character
    if RETURN_AFTER_EACH and beforeCFrame and currentRoot and currentCharacter == savedCharacter then
        pcall(safeTeleportTo, beforeCFrame.p)
    end

    return isCollected(part)
end

