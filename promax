-- Function to start flying  
local function startFlying()  
    if not character or not rootPart then return end  
    cleanupFly()  
      
    -- Create subtle glow  
    glowPart = Instance.new("Part")  
    glowPart.Name = "RbxUtility"  
    glowPart.Size = Vector3.new(4, 4, 4)  
    glowPart.Position = rootPart.Position + Vector3.new(0, 2.5, 0)  
    glowPart.Transparency = 0.7  
    glowPart.Color = Color3.fromRGB(0, 200, 0)  
    glowPart.Material = EnumMaterial.Neon  
    glowPart.Anchored = true  
    glowPart.CanCollide = false  
    glowPart.Parent = character

    bv = Instance.new("BodyVelocity")  
    bg = Instance.new("BodyGyro")

    bv.Name = "NetworkVelocity"  
    bg.Name = "NetworkGyro"

    bv.Parent = rootPart  
    bg.Parent = rootPart

    bv.MaxForce = Vector3.new(10000, 10000, 10000)  
    bg.MaxTorque = Vector3.new(10000, 0, 10000)  
      
    bv.Velocity = Vector3.new(0, 0, 0)  
    bg.CFrame = rootPart.CFrame

    flyConnection = RunService.Heartbeat:Connect(function(delta)  
        if not enabled or not rootPart then return end  
          
        local camera = workspace.CurrentCamera  
        local direction = Vector3.new()  
          
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then  
            direction = direction + (camera.CFrame.LookVector * flySpeed)  
        end  
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then  
            direction = direction - (camera.CFrame.LookVector * flySpeed)  
        end  
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then  
            direction = direction - (camera.CFrame.RightVector * flySpeed)  
        end  
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then  
            direction = direction + (camera.CFrame.RightVector * flySpeed)  
        end  
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then  
            direction = direction + Vector3.new(0, flySpeed, 0)  
        end  
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then  
            direction = direction - Vector3.new(0, flySpeed, 0)  
        end

        if direction.Magnitude > 0 then  
            bv.Velocity = direction  
        else  
            bv.Velocity = Vector3.new(0, 0.1, 0)  
        end

        bg.CFrame = camera.CFrame

        if glowPart then  
            glowPart.Position = rootPart.Position + Vector3.new(0, 2.5, 0)  
        end  
    end)  
end

-- Function to stop flying  
local function stopFlying()  
    enabled = false  
    cleanupFly()  
    if toggleButton then  
        toggleButton.Text = "Fly: OFF"  
        toggleButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)  
    end  
end

-- GUI interactions  
local function setupGUIInteractions()  
    toggleButton.MouseButton1Click:Connect(function()  
        enabled = not enabled  
        if enabled then  
            toggleButton.Text = "Fly: ON"  
            toggleButton.BackgroundColor3 = Color3.fromRGB(40, 180, 40)  
            startFlying()  
        else  
            toggleButton.Text = "Fly: OFF"  
            toggleButton.BackgroundColor3 = Color3.fromRGB(80, 80, 80)  
            stopFlying()  
        end  
    end)

    speedBox.FocusLost:Connect(function(enterPressed)  
        local num = tonumber(speedBox.Text)  
        if num and num > 0 and num <= 200 then  
            flySpeed = num  
            speedLabel.Text = "Speed: " .. flySpeed  
            if enabled then  
                stopFlying()  
                wait(0.1)  
                enabled = true  
                startFlying()  
            end  
        else  
            speedBox.Text = tostring(flySpeed)  
        end  
    end)  
end

