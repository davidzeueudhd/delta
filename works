    teleBtn.MouseButton1Click:Connect(function()
        toggleClickTeleport()
        teleBtn.BackgroundColor3 = Config.TeleportEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
