        local sliderPos = wsSlider.AbsolutePosition.X
        local sliderWidth = wsSlider.AbsoluteSize.X
        local rel = math.clamp((mouseX - sliderPos) / sliderWidth, 0, 1)
        local newSpeed = math.round(10 + rel * 90)
        wsLabel.Text = "Walkspeed: " .. newSpeed
        wsFill.Size = UDim2.new(rel, 0, 1, 0)
        applyWalkSpeed(newSpeed)
    end

    wsSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = true
            updateWsSlider(input)
        end
    end)
    wsSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if wsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateWsSlider(input)
        end
    end)

    -- Toggle GUI with R
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)

    refreshPointsList()
    print("✅ GUI loaded! Press R to toggle.")
end

