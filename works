    FlyEnabled = false,
    WalkSpeed = 16,
    TeleportEnabled = false,
}

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if flyBodyVelocity then flyBodyVelocity:Destroy() end
    if flyConnection then flyConnection:Disconnect() end

    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.Parent = root

    flyConnection = RunService.Heartbeat:Connect(function()
        if not Config.FlyEnabled then return end
        if not root or not root.Parent then stopFly(); return end

        local moveDirection = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * 50
        end

        flyBodyVelocity.Velocity = moveDirection
    end)
end

local function stopFly()
    if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
    if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
end

local function toggleFly()
    Config.FlyEnabled = not Config.FlyEnabled
    if Config.FlyEnabled then startFly() else stopFly() end
end

-- ============================================================
--  WALKSPEED
-- ============================================================
local function applyWalkSpeed(speed)
    Config.WalkSpeed = speed
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then humanoid.WalkSpeed = speed end
    end
end

-- ============================================================
--  CLICK TELEPORT
-- ============================================================
local teleportConnection = nil

local function startClickTeleport()
    if teleportConnection then teleportConnection:Disconnect() end
    teleportConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if not Config.TeleportEnabled then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end

        local mouse = LocalPlayer:GetMouse()
        if not mouse then return end
        local hit = mouse.Hit.Position
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        root.CFrame = CFrame.new(hit + Vector3.new(0, 3, 0))
        print("📍 Click-teleported to", hit)
    end)
end

local function stopClickTeleport()
    if teleportConnection then teleportConnection:Disconnect(); teleportConnection = nil end
end

local function toggleClickTeleport()
    Config.TeleportEnabled = not Config.TeleportEnabled
    if Config.TeleportEnabled then startClickTeleport() else stopClickTeleport() end
end

-- ============================================================
--  RETURN POINT
-- ============================================================
local returnPoint = nil

local function setReturnPoint()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    returnPoint = root.Position
    print("📍 Return point set at", returnPoint)
end

local function teleportToReturn()
    if not returnPoint then
        print("⚠️ No return point set!")
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(returnPoint + Vector3.new(0, 2, 0))
    print("🏠 Returned to point")
end

-- ============================================================
--  TELEPORT POINTS (named)
-- ============================================================
local teleportPoints = {}

local function saveNamedPoint(name)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    teleportPoints[name] = root.Position
    print("📍 Saved point '" .. name .. "'")
    refreshPointsList()
end

local function teleportToNamed(name)
    local pos = teleportPoints[name]
    if not pos then
        print("❌ Point '" .. name .. "' not found")
        return
    end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
    print("📍 Teleported to '" .. name .. "'")
end

local function deleteNamedPoint(name)
    teleportPoints[name] = nil
    refreshPointsList()
    print("🗑️ Deleted point '" .. name .. "'")
end

