    -- ============================================================
    --  REFRESH POINTS LIST
    -- ============================================================
    function refreshPointsList()
        for _, child in ipairs(pointsListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        local yPos = 0
        local names = {}
        for name, _ in pairs(teleportPoints) do table.insert(names, name) end
        table.sort(names)
        for _, name in ipairs(names) do
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -5, 0, 28)
            btn.Position = UDim2.new(0, 2, 0, yPos)
            btn.BackgroundColor3 = Color3.fromRGB(50, 52, 60)
            btn.Text = name
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.TextScaled = true
            btn.Font = Enum.Font.GothamMedium
            btn.BorderSizePixel = 0
            btn.Parent = pointsListFrame
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = btn

            btn.MouseButton1Click:Connect(function()
                teleportToNamed(name)
            end)
            btn.MouseButton2Click:Connect(function()
                deleteNamedPoint(name)
            end)
            yPos = yPos + 32
        end
        pointsListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
    end

