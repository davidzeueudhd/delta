-- ==============================
-- DESYNC LOGIK (AN/AUS STEUERBAR)
-- ==============================
local isEnabled = false
local desyncThread = nil

local function startDesync()
    if desyncThread then return end
    isEnabled = true
    
    desyncThread = coroutine.create(function()
        local oldpos = nil
        local oldvel = nil
        local debounce = 0
        local sleepnet = true
        
        while isEnabled do
            if not clientCharacter or not clientCharacter:FindFirstChild("HumanoidRootPart") then
                clientCharacter = client.Character
                if not clientCharacter then
                    RunService.Heartbeat:Wait()
                    break
                end
                clientCharacter = client.Character
            end
            
            local rootPart = clientCharacter.HumanoidRootPart
            debounce = debounce + 1
            oldpos = rootPart.CFrame
            oldvel = rootPart.Velocity
            
            if not sleepnet then
                rootPart.CFrame = rootPart.CFrame + Vector3.new(555, 0, 5)
            end
            
            pcall(function()
                sethiddenproperty(rootPart, "NetworkIsSleeping", sleepnet)
            end)
            rootPart.CFrame = oldpos
            
            RunService.RenderStepped:Wait()
            
            if debounce >= 3 then
                sleepnet = false
                debounce = 0
            else
                sleepnet = true
            end
            
            RunService.Heartbeat:Wait()
        end
    end)
    
    coroutine.resume(desyncThread)
end

local function stopDesync()
    isEnabled = false
    desyncThread = nil
    
    -- Reset character to prevent stuck state
    if clientCharacter and clientCharacter:FindFirstChild("HumanoidRootPart") then
        local rootPart = clientCharacter.HumanoidRootPart
        pcall(function()
            sethiddenproperty(rootPart, "NetworkIsSleeping", true)
        end)
    end
    
    print("🔴 Desync GESTOPPT")
end

