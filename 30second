--[[
    30 SEKUNDEN VERZÖGERUNG - OHNE RESET
    - Kein Reset → Hooks bleiben stabil
    - Speichert Positionen sofort
    - Andere sehen dich 30 Sek. versetzt
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

print("⏳ 30 SEKUNDEN VERZÖGERUNG - OHNE RESET STARTET...")

-- ==============================
-- POSITIONSSPEICHER (30 Sekunden)
-- ==============================
local MAX_POSITIONS = 30
local positions = {}
local counter = 0
local realPosition = rootPart.Position

-- Alle 1 Sekunde Position speichern
RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    if counter % 60 == 0 then
        table.insert(positions, {
            position = rootPart.Position,
            cframe = rootPart.CFrame
        })
        
        if #positions > MAX_POSITIONS then
            table.remove(positions, 1)
        end
        
        realPosition = rootPart.Position
    end
end)

-- ==============================
-- GRÜNER MARKER (Fake Position)
-- ==============================
local function createMarker(position, text)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(10, 2, 10)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.1
    marker.Parent = Workspace
    
    local billboard = Instance.new("BillboardGui")
    billboard.Size = UDim2.new(0, 400, 0, 60)
    billboard.StudsOffset = Vector3.new(0, 5, 0)
    billboard.Parent = marker
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text or "📍 POSITION"
    label.TextColor3 = Color3.fromRGB(0, 255, 0)
    label.TextScaled = true
    label.Font = Enum.Font.Bold
    label.Parent = billboard
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 30
    glow.Brightness = 20
    
    game:GetService("Debris"):AddItem(marker, 35)
    return marker
end

-- ==============================
-- HOOK 1: CFrame manipulieren
-- ==============================
local hookCFrame = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "CFrame" and self == rootPart then
        if #positions >= 30 then
            local oldData = positions[1]
            if oldData then
                return oldData.cframe
            end
        end
        return CFrame.new(realPosition)
    end
    return hookCFrame(self, key)
end)

-- ==============================
-- HOOK 2: Position manipulieren
-- ==============================
local hookPosition = hookmetamethod(game, "__index", function(self, key)
    if not checkcaller() and key == "Position" and self == rootPart then
        if #positions >= 30 then
            local oldData = positions[1]
            if oldData then
                return oldData.position
            end
        end
        return realPosition
    end
    return hookPosition(self, key)
end)

-- ==============================
-- FAKE MARKER (nach 30 Sek.)
-- ==============================
local showFakeMarker = false

RunService.Heartbeat:Connect(function()
    if #positions >= 30 and not showFakeMarker then
        local oldData = positions[1]
        if oldData then
            createMarker(oldData.position, "⏳ ANDERE SEHEN DICH HIER (30 SEK. ALT)")
            showFakeMarker = true
            print("🟢 Marker an 30-Sekunden-alter Position!")
        end
    end
end)

-- ==============================
-- R-TASTE: MARKER
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        if #positions >= 30 then
            local oldData = positions[1]
            if oldData then
                createMarker(oldData.position, "⏳ VOR 30 SEKUNDEN")
                print("🟢 Marker an 30-Sekunden-alter Position!")
            end
        else
            print("⚠️ Noch nicht genug Positionen (" .. #positions .. "/30)")
        end
    end
end)

