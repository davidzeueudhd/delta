-- Teleport + GUI helper (replaces previous teleport helper)
-- This file exposes helper functions to _G and creates a loadstring GUI that interacts
-- with the main auto-collector script. Place this alongside your main script so the
-- GUI can call the main functions via _G.

-- NOTE: This file assumes the following functions/vars exist in the main script's
-- environment (they are not defined here):
-- gatherEggParts, safeTeleportTo, attemptCollectPart, startAuto, stopAuto,
-- populateList, updateStatus, running, PER_EGG_TIMEOUT, RETURN_AFTER_EACH,
-- MOVE_TO_FALLBACK

-- Expose helpers so the GUI code inside loadstring can call them:
_G.gatherEggParts = gatherEggParts
_G.safeTeleportTo = safeTeleportTo
_G.attemptCollectPart = attemptCollectPart
_G.startAuto = startAuto
_G.stopAuto = stopAuto
_G.populateList = populateList
_G.updateStatus = updateStatus
_G.isRunning = function() return running end
_G.getPER_EGG_TIMEOUT = function() return PER_EGG_TIMEOUT end
_G.setPER_EGG_TIMEOUT = function(v) PER_EGG_TIMEOUT = tonumber(v) or PER_EGG_TIMEOUT end
_G.getRETURN_AFTER_EACH = function() return RETURN_AFTER_EACH end
_G.setRETURN_AFTER_EACH = function(v) RETURN_AFTER_EACH = not not v end
_G.getMOVE_TO_FALLBACK = function() return MOVE_TO_FALLBACK end
_G.setMOVE_TO_FALLBACK = function(v) MOVE_TO_FALLBACK = not not v end

-- GUI code as a string to be run with loadstring
local guiCode = [[
-- GUI code (executed via loadstring). It uses _G.* helpers above.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Clean up any previous GUI
local existing = PlayerGui:FindFirstChild("AutoEggGUI")
if existing then existing:Destroy() end

local gui = Instance.new("ScreenGui")
gui.Name = "AutoEggGUI"
gui.ResetOnSpawn = false
gui.Parent = PlayerGui

local function makeFrame()
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 420, 0, 420)
    frame.Position = UDim2.new(0, 20, 0, 60)
    frame.BackgroundColor3 = Color3.fromRGB(30,30,35)
    frame.BorderSizePixel = 0
    frame.Name = "MainFrame"
    frame.Parent = gui

    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0,10); corner.Parent = frame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -12, 0, 28)
    title.Position = UDim2.new(0, 6, 0, 6)
    title.BackgroundTransparency = 1
    title.Text = "Auto Egg Collector (Loadstring GUI)"
    title.TextColor3 = Color3.fromRGB(230,230,230)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = frame

    local status = Instance.new("TextLabel")
    status.Name = "StatusLabel"
    status.Size = UDim2.new(1, -12, 0, 20)
    status.Position = UDim2.new(0, 6, 0, 36)
    status.BackgroundTransparency = 1
    status.Text = "Status: Stopped"
    status.TextColor3 = Color3.fromRGB(200,200,200)
    status.Font = Enum.Font.Gotham
    status.TextSize = 14
    status.TextXAlignment = Enum.TextXAlignment.Left
    status.Parent = frame

    local startBtn = Instance.new("TextButton")
    startBtn.Size = UDim2.new(0, 110, 0, 32)
    startBtn.Position = UDim2.new(0, 8, 0, 64)
    startBtn.BackgroundColor3 = Color3.fromRGB(50,180,60)
    startBtn.Text = "Start"
    startBtn.Font = Enum.Font.GothamBold
    startBtn.Parent = frame

    local stopBtn = Instance.new("TextButton")
    stopBtn.Size = UDim2.new(0, 110, 0, 32)
    stopBtn.Position = UDim2.new(0, 126, 0, 64)
    stopBtn.BackgroundColor3 = Color3.fromRGB(200,60,60)
    stopBtn.Text = "Stop"
    stopBtn.Font = Enum.Font.GothamBold
    stopBtn.Parent = frame

    local refreshBtn = Instance.new("TextButton")
    refreshBtn.Size = UDim2.new(0, 110, 0, 32)
    refreshBtn.Position = UDim2.new(0, 244, 0, 64)
    refreshBtn.BackgroundColor3 = Color3.fromRGB(80,120,200)
    refreshBtn.Text = "Scan Now"
    refreshBtn.Font = Enum.Font.GothamBold
    refreshBtn.Parent = frame

    -- toggles
    local toggleFrame = Instance.new("Frame"); toggleFrame.Size = UDim2.new(1, -12, 0, 40); toggleFrame.Position = UDim2.new(0,6,0,102); toggleFrame.BackgroundTransparency = 1; toggleFrame.Parent = frame
    local function makeToggle(name, x, getter, setter)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 160, 1, 0)
        lbl.Position = UDim2.new(0, x, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = name
        lbl.TextColor3 = Color3.fromRGB(200,200,200)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = toggleFrame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 60, 0, 24)
        btn.Position = UDim2.new(0, x + 162, 0, 8)
        btn.Text = getter() and "ON" or "OFF"
        btn.BackgroundColor3 = getter() and Color3.fromRGB(80,200,100) or Color3.fromRGB(160,160,160)
        btn.Font = Enum.Font.GothamBold
        btn.Parent = toggleFrame

        btn.MouseButton1Click:Connect(function()
            setter(not getter())
            btn.Text = getter() and "ON" or "OFF"
            btn.BackgroundColor3 = getter() and Color3.fromRGB(80,200,100) or Color3.fromRGB(160,160,160)
        end)
    end

    makeToggle("Return After Each", 0, _G.getRETURN_AFTER_EACH, _G.setRETURN_AFTER_EACH)
    makeToggle("Use MoveTo (walk)", 220, _G.getMOVE_TO_FALLBACK, _G.setMOVE_TO_FALLBACK)

    -- timeout controls
    local timeoutLabel = Instance.new("TextLabel")
    timeoutLabel.Size = UDim2.new(0, 180, 0, 28)
    timeoutLabel.Position = UDim2.new(0, 6, 0, 150)
    timeoutLabel.BackgroundTransparency = 1
    timeoutLabel.Text = "Per-egg timeout (sec): " .. tostring(_G.getPER_EGG_TIMEOUT())
    timeoutLabel.TextColor3 = Color3.fromRGB(200,200,200)
    timeoutLabel.Font = Enum.Font.Gotham
    timeoutLabel.TextSize = 14
    timeoutLabel.TextXAlignment = Enum.TextXAlignment.Left
    timeoutLabel.Parent = frame

    local decBtn = Instance.new("TextButton")
    decBtn.Size = UDim2.new(0, 32, 0, 24)
    decBtn.Position = UDim2.new(0, 190, 0, 150)
    decBtn.Text = "-"
    decBtn.Font = Enum.Font.GothamBold
    decBtn.Parent = frame

    local incBtn = Instance.new("TextButton")
    incBtn.Size = UDim2.new(0, 32, 0, 24)
    incBtn.Position = UDim2.new(0, 226, 0, 150)
    incBtn.Text = "+"
    incBtn.Font = Enum.Font.GothamBold
    incBtn.Parent = frame

    local function refreshTimeoutLabel()
        timeoutLabel.Text = "Per-egg timeout (sec): " .. tostring(_G.getPER_EGG_TIMEOUT())
    end
    decBtn.MouseButton1Click:Connect(function()
        _G.setPER_EGG_TIMEOUT(math.max(1, _G.getPER_EGG_TIMEOUT() - 1))
        refreshTimeoutLabel()
    end)
    incBtn.MouseButton1Click:Connect(function()
        _G.setPER_EGG_TIMEOUT(_G.getPER_EGG_TIMEOUT() + 1)
        refreshTimeoutLabel()
    end)

    -- list
    local listFrame = Instance.new("Frame")
    listFrame.Size = UDim2.new(1, -12, 0, 200)
    listFrame.Position = UDim2.new(0, 6, 0, 190)
    listFrame.BackgroundColor3 = Color3.fromRGB(28,30,35)
    listFrame.BorderSizePixel = 0
    listFrame.Parent = frame
    local listCorner = Instance.new("UICorner"); listCorner.CornerRadius = UDim.new(0,8); listCorner.Parent = listFrame

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1,0,1,0)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 8
    scroll.Parent = listFrame

    local uiList = Instance.new("UIListLayout"); uiList.Parent = scroll; uiList.SortOrder = Enum.SortOrder.LayoutOrder; uiList.Padding = UDim.new(0,6)

    -- helper to populate from main script's gatherEggParts
    local function populate()
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("TextButton") or c:IsA("TextLabel") then c:Destroy() end
        end
        local parts = {}
        local ok, res = pcall(function() return _G.gatherEggParts() end)
        if ok and res then parts = res end
        if #parts == 0 then
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -12, 0, 28)
            lbl.Position = UDim2.new(0, 6, 0, 6)
            lbl.BackgroundTransparency = 1
            lbl.Text = "No eggs found"
            lbl.TextColor3 = Color3.fromRGB(200,200,200)
            lbl.Font = Enum.Font.Gotham
            lbl.Parent = scroll
            return
        end
        local charRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local count = 0
        for _, p in ipairs(parts) do
            count = count + 1
            local dist = charRoot and math.floor((p.Position - charRoot.Position).Magnitude) or 0
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -12, 0, 30)
            btn.Position = UDim2.new(0, 6, 0, 6 + (count-1) * 36)
            btn.BackgroundColor3 = Color3.fromRGB(40,40,45)
            btn.TextColor3 = Color3.fromRGB(230,230,230)
            btn.Text = p.Name .. " (" .. tostring(dist) .. " studs)"
            btn.Font = Enum.Font.Gotham
            btn.Parent = scroll

            local tpBtn = Instance.new("TextButton")
            tpBtn.Size = UDim2.new(0, 60, 0, 24)
            tpBtn.Position = UDim2.new(1, -72, 0, 3 + (count-1) * 36)
            tpBtn.AnchorPoint = Vector2.new(0,0)
            tpBtn.Text = "TP"
            tpBtn.BackgroundColor3 = Color3.fromRGB(80,120,200)
            tpBtn.Font = Enum.Font.GothamBold
            tpBtn.Parent = listFrame

            tpBtn.MouseButton1Click:Connect(function()
                pcall(function() _G.safeTeleportTo(p.Position + Vector3.new(0,5,0)) end)
            end)

            btn.MouseButton1Click:Connect(function()
                -- try to walk first using main script's logic via MoveTo by calling startAuto temporarily? Instead just teleport for manual click
                pcall(function() _G.safeTeleportTo(p.Position + Vector3.new(0,5,0)) end)
            end)
        end
    end

    -- button actions
    startBtn.MouseButton1Click:Connect(function()
        pcall(function() _G.startAuto() end)
    end)
    stopBtn.MouseButton1Click:Connect(function()
        pcall(function() _G.stopAuto() end)
    end)
    refreshBtn.MouseButton1Click:Connect(function()
        populate()
        local statusLbl = frame:FindFirstChild("StatusLabel")
        if statusLbl then statusLbl.Text = "Status: Refreshed" end
    end)

    -- expose update UI function for status update from main script
    local function refreshStatusFromMain()
        local statusLbl = frame:FindFirstChild("StatusLabel")
        if statusLbl then
            local ok, s = pcall(function() return _G and _G.updateStatus and _G.updateStatus end)
            -- main script calls updateStatus as usual; this GUI will be refreshed periodically below
        end
    end

    -- allow dragging
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return {
        frame = frame,
        populate = populate,
        refreshTimeoutLabel = refreshTimeoutLabel,
        statusLabel = status
    }
end

local widgets = makeFrame()
widgets.populate()

-- periodic refresh
spawn(function()
    while gui.Parent do
        pcall(function()
            widgets.populate()
            -- update status label if main script sets one via _G.updateStatus by reading the label text from the main script's value (we rely on updateStatus being called there)
            local ok, s = pcall(function() return nil end)
        end)
        wait(6)
    end
end)

-- toggle show/hide with R
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.R then
        local f = gui:FindFirstChild("MainFrame")
        if f then f.Visible = not f.Visible end
    end
end)
]]

-- Run the GUI string
local success, err = pcall(function() loadstring(guiCode)() end)
if not success then
    warn("[AutoEgg GUI] loadstring failed:", err)
end
