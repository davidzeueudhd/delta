--[[
    Script Name: Auto-Egg Collector (Public)
    Description: Scans for eggs, shows them in a GUI, teleports to selected egg,
    and auto-collects. No admin restrictions – works for everyone.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
--  CONFIG
-- ============================================================
local CONFIG = {
    AutoCollect = true,
    CollectTimeout = 3, -- seconds to wait before teleporting back / next action
}

-- ============================================================
--  EGG FINDER
-- ============================================================
local function FindEggs()
    local eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") or obj:IsA("Model") then
            local name = (obj.Name or ""):lower()
            if name:find("egg") or name:find("nest") then
                -- exclude treadmills
                if not name:find("treadmill") and not name:find("laufband") then
                    table.insert(eggs, obj)
                end
            end
        end
    end
    return eggs
end

-- ============================================================
--  TELEPORT FUNCTION
-- ============================================================
local function TeleportTo(part)
    if not part or not part:IsA("BasePart") then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    root.CFrame = CFrame.new(part.Position + Vector3.new(0, 2, 0))
end

-- ============================================================
--  COLLECT EGG
-- ============================================================
local function CollectEgg(egg)
    if not egg then return false end
    local grabbed = false
    
    -- Method 1: ClickDetector
    local clickDetector = egg:FindFirstChild("ClickDetector")
    if clickDetector then
        clickDetector:FireClick(LocalPlayer)
        grabbed = true
        print("✅ Clicked egg")
    end
    
    -- Method 2: Touch
    if not grabbed then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
            grabbed = true
            print("✅ Touched egg")
        end
    end
    
    -- Method 3: ProximityPrompt
    if not grabbed then
        local prompt = egg:FindFirstChild("ProximityPrompt")
        if prompt then
            prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            grabbed = true
            print("✅ Used ProximityPrompt")
        end
    end
    
    return grabbed
end

-- ============================================================
--  GUI
-- ============================================================
