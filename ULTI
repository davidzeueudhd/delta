--[[
    EXTREMER TEST: 50 STUDS DESYNC
    - Resetet den Character 1x
    - Zeigt grünen Marker an Fake Position (50 Studs entfernt)
    - Desync mit 50 Studs (extrem sichtbar)
    - WARNUNG: FAST GARANTIERTER BANN!
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

print("🔥 EXTREMER TEST - 50 STUDS STARTET...")

-- ==============================
-- RESET 1x
-- ==============================
print("🔄 Reset...")
character.Humanoid.Health = 0
local newChar = player.CharacterAdded:Wait()
character = newChar
rootPart = character:WaitForChild("HumanoidRootPart")
print("✅ Respawned!")

-- ==============================
-- FAKE POSITION (50 STUDS)
-- ==============================
local fakePos = rootPart.Position + Vector3.new(50, 5, 50)

-- ==============================
-- GRÜNER MARKER (GROSS)
-- ==============================
local marker = Instance.new("Part")
marker.Size = Vector3.new(10, 2, 10)
marker.Position = fakePos
marker.Anchored = true
marker.CanCollide = false
marker.BrickColor = BrickColor.new("Bright green")
marker.Material = Enum.Material.Neon
marker.Transparency = 0.1
marker.Parent = Workspace

-- Text anzeigen
local billboard = Instance.new("BillboardGui")
billboard.Size = UDim2.new(0, 300, 0, 50)
billboard.StudsOffset = Vector3.new(0, 5, 0)
billboard.Parent = marker

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 1, 0)
label.BackgroundTransparency = 1
label.Text = "🎯 50 STUDS FAKE POSITION"
label.TextColor3 = Color3.fromRGB(0, 255, 0)
label.TextScaled = true
label.Font = Enum.Font.Bold
label.Parent = billboard

local glow = Instance.new("PointLight")
glow.Parent = marker
glow.Color = Color3.fromRGB(0, 255, 0)
glow.Range = 30
glow.Brightness = 10

print("🟢 Marker an FAKE Position: " .. tostring(fakePos))

-- ==============================
-- DESYNC (50 STUDS)
-- ==============================
local offset = Vector3.new(0, 0, 0)

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    local target = Vector3.new(
        math.random(-5000, 5000) / 100,  -- 50 Studs
        math.random(-1000, 1000) / 100,
        math.random(-5000, 5000) / 100
    )
    
    offset = offset:Lerp(target, 0.05)
    rootPart.CFrame = rootPart.CFrame + offset
end)

print("💀 50 STUDS DESYNC LÄUFT!")
print("📌 Andere sollten dich 50 Studs versetzt sehen!")
print("⚠️ EXTREM RISKANT - NUR AUF WEGWERF-ACCOUNTS!")
print("⚠️ FAST GARANTIERTER BANN!")
