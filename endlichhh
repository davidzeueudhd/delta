--[[
    DESYNC - BEWEGBAR + ANDERE SEHEN DICH WOANDERS
    - Du kannst dich normal bewegen
    - Andere sehen dich an anderer Position
    - Kein Speed
    - Kein Toggle
    - R-Taste = Marker
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ==============================
-- DESYNC (NUR FÜR ANDERE SICHTBAR)
-- ==============================
local desyncOffset = Vector3.new(0, 0, 0)
local targetOffset = Vector3.new(0, 0, 0)

-- Sanftes Gleiten zum Ziel-Offset
RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    -- Neues Ziel-Offset (zufällig)
    targetOffset = Vector3.new(
        math.random(-200, 200) / 100,  -- 2,0 Studs
        math.random(-40, 40) / 100,
        math.random(-200, 200) / 100
    )
    
    -- Sanftes Gleiten zum Ziel (nicht ruckartig)
    desyncOffset = desyncOffset:Lerp(targetOffset, 0.1)
    
    -- Position für andere Spieler verändern (ohne deine Bewegung zu blockieren)
    rootPart.CFrame = rootPart.CFrame + desyncOffset
end)

-- ==============================
-- POSITIONEN SPEICHERN
-- ==============================
local MAX_POSITIONS = 20
local positions = {}
local counter = 0

RunService.Heartbeat:Connect(function()
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    if counter % 60 == 0 then
        table.insert(positions, {
            position = rootPart.Position,
            cframe = rootPart.CFrame
        })
        
        if #positions > MAX_POSITIONS then
            table.remove(positions, 1)
        end
    end
end)

-- ==============================
-- GRÜNER MARKER
-- ==============================
local function createMarker(position)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(5, 1, 5)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.3
    marker.Parent = Workspace
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 10
    glow.Brightness = 2
    
    game:GetService("Debris"):AddItem(marker, 10)
    return marker
end

-- ==============================
-- R TASTE = MARKER
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.R then
        if #positions < 20 then
            print("⚠️ Noch nicht genug Positionen (" .. #positions .. "/20)")
            return
        end
        
        local oldData = positions[1]
        if oldData then
            createMarker(oldData.position)
            print("🟢 Marker an Position von vor 20 Sekunden")
        end
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    desyncOffset = Vector3.new(0, 0, 0)
    print("🔄 Character respawned - Bereit")
end)

print("🎯 DESYNC GELADEN - DU KANNST DICH BEWEGEN!")
print("📌 Andere sehen dich an anderer Position")
print("📌 Drücke R = Marker an Position von vor 20 Sekunden")
print("📌 KEINE Veränderungen an Speed oder Stats!")
