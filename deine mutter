-- ============================================================
-- HELPERS
-- ============================================================
local function GetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function TeleportTo(pos)
    local root = GetRoot()
    if not root then return false end
    root.CFrame = CFrame.new(pos)
    return true
end

-- ============================================================
-- CORE FUNCTION: Gather all stealable eggs
-- ============================================================
local function gatherEggParts()
    local eggList = {}
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            
            -- Must contain "egg" or "nest" in name
            if name:find("egg") or name:find("nest") then
                -- CRITICAL: Must have ClickDetector to be stealable
                if obj:FindFirstChild("ClickDetector") then
                    table.insert(eggList, obj)
                end
            end
        end
    end
    
    return eggList
end

-- ============================================================
-- FIND BEST EGG (by rarity + proximity scoring)
-- ============================================================
local function FindBestEgg()
    local root = GetRoot()
    if not root then return nil end
    
    local eggs = gatherEggParts()
    if #eggs == 0 then return nil end
    
    local bestEgg = nil
    local bestScore = -math.huge
    
    local rarityValues = {
        ["secret"] = 1000,
        ["eternal"] = 900,
        ["divine"] = 850,
        ["godly"] = 700,
        ["mythic"] = 600,
        ["cosmic"] = 500,
        ["rainbow"] = 450,
        ["golden"] = 400,
        ["legendary"] = 350,
        ["epic"] = 250,
        ["rare"] = 150,
        ["uncommon"] = 50,
        ["common"] = 10,
    }
    
    for _, egg in ipairs(eggs) do
        local score = 0
        local name = egg.Name:lower()
        
        -- Rarity scoring
        for rarity, points in pairs(rarityValues) do
            if name:find(rarity) then
                score = score + points
                break
            end
        end
        
        -- Distance penalty (closer = better)
        local dist = (egg.Position - root.Position).Magnitude
        score = score - (dist / 50)
        
        if score > bestScore then
            bestScore = score
            bestEgg = egg
        end
    end
    
    return bestEgg, bestScore
end

-- ============================================================
-- GRAB EGG (with multiple fallback methods)
-- ============================================================
local function GrabEgg(egg)
    if not egg or not egg:IsA("BasePart") then return false end
    local grabbed = false
    
    -- Method 1: ClickDetector (primary method for Steal an Egg)
    local clickDetector = egg:FindFirstChild("ClickDetector")
    if clickDetector then
        clickDetector:FireClick(LocalPlayer)
        grabbed = true
        print("✅ Grabbed via ClickDetector")
    end
    
    -- Method 2: ProximityPrompt (fallback)
    if not grabbed then
        local prompt = egg:FindFirstChild("ProximityPrompt")
        if prompt then
            prompt:InputHoldStart(LocalPlayer, Enum.UserInputType.MouseButton1)
            task.wait(0.2)
            prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            grabbed = true
            print("✅ Grabbed via ProximityPrompt")
        end
    end
    
    -- Method 3: RemoteEvent (fallback)
    if not grabbed then
        local replicatedStorage = game:GetService("ReplicatedStorage")
        local remote = replicatedStorage:FindFirstChild("CollectEgg") or replicatedStorage:FindFirstChild("GrabEgg")
        if remote then
            remote:FireServer(egg)
            grabbed = true
            print("✅ Grabbed via RemoteEvent")
        end
    end
    
    return grabbed
end

-- ============================================================
-- SET BASE
-- ============================================================
local function SetBase()
    local root = GetRoot()
    if not root then return end
    
    currentBase = root.Position
    
    if baseMarker then baseMarker:Destroy() end
    
    local marker = Instance.new("Part")
    marker.Name = "BaseMarker"
    marker.Size = Vector3.new(6, 1, 6)
    marker.Position = currentBase
    marker.Anchored = true
    marker.CanCollide = false
    marker.Transparency = 0.2
    marker.Color = Color3.fromRGB(0, 255, 100)
    marker.Material = Enum.Material.Neon
    marker.Parent = Workspace
    
    local glow = Instance.new("PointLight")
    glow.Color = Color3.fromRGB(0, 255, 100)
    glow.Brightness = 5
    glow.Range = 25
    glow.Parent = marker
    
    baseMarker = marker
    print("🏠 Base set!")
end

local function TeleportToBase()
    if not currentBase then
        print("❌ Base not set!")
        return false
    end
    return TeleportTo(currentBase + Vector3.new(0, 2, 0))
end

-- ============================================================
-- STEAL & RETURN CYCLE
-- ============================================================
local function StealBestEgg()
    local egg, score = FindBestEgg()
    if not egg then
        print("❌ No egg found!")
        return false
    end
    
    print("🚀 Teleporting to: " .. egg.Name .. " (Score: " .. math.floor(score) .. ")")
    TeleportTo(egg.Position + Vector3.new(0, 3, 0))
    task.wait(0.3)
    
    print("🔄 Attempting to grab...")
    local grabbed = false
    for attempt = 1, CONFIG.GrabAttempts do
        if GrabEgg(egg) then
            grabbed = true
            break
        end
        task.wait(CONFIG.ClickDelay)
    end
    
    if not grabbed then
        print("⚠️ Manual click may be needed!")
    end
    
    print("⏳ Waiting " .. CONFIG.AutoReturnDelay .. "s...")
    task.wait(CONFIG.AutoReturnDelay)
    
    if currentBase then
        TeleportToBase()
        print("🏠 Returned to base!")
    end
    
    return grabbed
end

-- ============================================================
-- AUTO MODE
-- ============================================================
local autoConnection = nil

local function StartAutoMode()
    if autoConnection then autoConnection:Disconnect() end
    autoMode = true
    running = false
    print("🔄 AUTO MODE ACTIVE!")
    
    autoConnection = RunService.Heartbeat:Connect(function()
        if not autoMode or running then return end
        running = true
        StealBestEgg()
        running = false
    end)
end

local function StopAutoMode()
    autoMode = false
    if autoConnection then
        autoConnection:Disconnect()
        autoConnection = nil
    end
    print("⏹️ AUTO MODE OFF!")
end

-- ============================================================
-- STATUS UPDATE
-- ============================================================
local function updateStatus(msg)
    print("Status: " .. msg)
end

local function populateList()
    return gatherEggParts()
end

