--[[
    TANK DESYNC - 5 STUDS CLEAN
    - Desync: 5,0 Studs (stark, aber clean)
    - Sanfte Tween-Übergänge (flüssig)
    - WalkSpeed: 35 (NORMAL)
    - Kein Jump (für Tank optimiert)
    - Grüne Marker: Alle 15 Bewegungen
    - F = PAUSE/WEITER
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local client = Players.LocalPlayer
local clientCharacter = client.Character or client.CharacterAdded:Wait()
local rootPart = clientCharacter:WaitForChild("HumanoidRootPart")

-- ==============================
-- GRÜNER MARKER
-- ==============================
local function createMarker(position)
    local marker = Instance.new("Part")
    marker.Size = Vector3.new(3, 0.5, 3)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.BrickColor = BrickColor.new("Bright green")
    marker.Material = Enum.Material.Neon
    marker.Transparency = 0.4
    marker.Parent = Workspace
    
    local glow = Instance.new("PointLight")
    glow.Parent = marker
    glow.Color = Color3.fromRGB(0, 255, 0)
    glow.Range = 8
    glow.Brightness = 1.5
    
    game:GetService("Debris"):AddItem(marker, 15)
    return marker
end

-- ==============================
-- CLEAN DESYNC (5 STUDS MIT TWEEN)
-- ==============================
local isRunning = true
local counter = 0
local originalPosition = rootPart.Position

createMarker(originalPosition)
print("🟢 Startposition markiert")

-- Desync-Loop mit Tween (clean!)
RunService.Heartbeat:Connect(function()
    if not isRunning then return end
    if not rootPart or not rootPart.Parent then return end
    
    counter = counter + 1
    
    -- ALLE 6 FRAMES
    if counter % 6 == 0 then
        local currentPos = rootPart.Position
        
        -- Zielposition mit 5 Studs Versatz
        local targetPos = Vector3.new(
            currentPos.X + math.random(-500, 500) / 100,  -- 5,0 Studs
            currentPos.Y + math.random(-100, 100) / 100,
            currentPos.Z + math.random(-500, 500) / 100
        )
        
        -- SMOOTH TWEEN (clean & flüssig)
        local tweenInfo = TweenInfo.new(
            0.15,  -- Dauer (kurz, aber weich)
            Enum.EasingStyle.Quad,  -- Sanftes Start/Ende
            Enum.EasingDirection.InOut
        )
        
        local tween = TweenService:Create(rootPart, tweenInfo, {
            CFrame = CFrame.new(targetPos) * CFrame.Angles(
                math.rad(math.random(-2, 2) / 10),
                math.rad(math.random(-4, 4) / 10),
                math.rad(math.random(-2, 2) / 10)
            )
        })
        tween:Play()
        
        -- Grüne Marker (alle 15 Bewegungen)
        if counter % 15 == 0 then
            createMarker(rootPart.Position)
            print("🟢 Neue Position markiert")
        end
    end
end)

-- ==============================
-- WALKSPEED (NORMAL)
-- ==============================
local humanoid = clientCharacter:WaitForChild("Humanoid")
humanoid.WalkSpeed = 35  -- NORMAL

-- ==============================
-- F-TASTE ZUM TOGGLEN
-- ==============================
local UserInputService = game:GetService("UserInputService")
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.F then
        isRunning = not isRunning
        if isRunning then
            print("🟢 Desync REAKTIVIERT")
            createMarker(rootPart.Position)
        else
            print("🔴 Desync PAUSIERT")
        end
    end
end)

-- ==============================
-- CHARACTER RESET
-- ==============================
client.CharacterAdded:Connect(function(newChar)
    clientCharacter = newChar
    rootPart = clientCharacter:WaitForChild("HumanoidRootPart")
    humanoid = clientCharacter:WaitForChild("Humanoid")
    humanoid.WalkSpeed = 35
    createMarker(rootPart.Position)
end)

print("✨ TANK DESYNC - 5 STUDS CLEAN GELADEN!")
print("📌 Desync: 5,0 Studs (stark, aber clean)")
print("📌 Tween: Sanfte Übergänge (flüssig)")
print("📌 WalkSpeed: 35 (NORMAL)")
print("📌 KEIN JUMP (für Tank optimiert)")
print("📌 F = PAUSE/WEITER")
print("⚠️ EXTREM RISKANT - NUR AUF WEGWERF-ACCOUNTS!")
