--[[
    ZERSTÖRUNGS-LAGGER - 1.000.000 TEILE
    - Keybind: K
    - Erstellt 1.000.000 Teile auf einmal
    - Garantierter Server-Crash!
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local isLaggerActive = false
local laggerConnection = nil

-- ==============================
-- ZERSTÖRUNGS-FUNKTION (1.000.000 Teile)
-- ==============================
local function lagServer()
    -- Erstelle 1.000.000 Teile auf einmal
    for i = 1, 1000000 do
        local part = Instance.new("Part")
        part.Size = Vector3.new(1, 1, 1)
        part.Position = Vector3.new(
            math.random(-1000, 1000),
            math.random(-500, 500),
            math.random(-1000, 1000)
        )
        part.Anchored = false
        part.CanCollide = true
        part.Transparency = 0.5
        part.BrickColor = BrickColor.random()
        part.Material = Enum.Material.Neon
        part.Parent = Workspace
        
        -- Nach 5 Sekunden löschen (wenn überhaupt so lange)
        Debris:AddItem(part, 5)
    end
end

-- ==============================
-- LAGGER STARTEN / STOPPEN (K)
-- ==============================
local function toggleLagger()
    isLaggerActive = not isLaggerActive
    
    if isLaggerActive then
        print("💀 ZERSTÖRUNGS-LAGGER AKTIVIERT (1.000.000 Teile)")
        laggerConnection = RunService.Heartbeat:Connect(function()
            lagServer()
        end)
    else
        print("🔴 ZERSTÖRUNGS-LAGGER DEAKTIVIERT")
        if laggerConnection then
            laggerConnection:Disconnect()
            laggerConnection = nil
        end
    end
end

-- ==============================
-- KEYBIND: K
-- ==============================
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.K then
        toggleLagger()
    end
end)

print("💀 ZERSTÖRUNGS-LAGGER GELADEN!")
print("📌 Drücke K = AN/AUS")
print("📌 1.000.000 Teile pro Sekunde")
print("⚠️ GARANTIERTER CRASH + BANN!")
