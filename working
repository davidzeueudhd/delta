-- ============================================================
--  ANTI-DETECTION (best-effort and safe; wrapped in pcall)
--  NOTE: these techniques depend on exploit environment availability.
-- ============================================================
local function setupAntiDetection()
    -- Safely try to override FireServer on suspicious remotes (pcall to avoid errors)
    local function tryBlockRemote(remote)
        if not remote or not remote.Name then return end
        -- Only attempt to override if the instance actually exposes a FireServer member
        pcall(function()
            if typeof(remote.FireServer) == "function" then
                local ok, old = pcall(function() return remote.FireServer end)
                if ok and old then
                    -- wrap in pcall to avoid runtime errors if assignment is blocked
                    pcall(function()
                        remote.FireServer = function(...)
                            local name = remote.Name and remote.Name:lower() or ""
                            if name:find("antihack") or name:find("anticheat") or name:find("report") then
                                return -- swallow calls to known anti-cheat/telemetry remotes
                            end
                            return old(...)
                        end
                    end)
                end
            end
        end)
    end

    local function scanAndBlock(parent)
        for _, child in ipairs(parent:GetChildren()) do
            tryBlockRemote(child)
            if child:IsA("Folder") or child:IsA("Model") then
                scanAndBlock(child)
            end
        end
    end

    pcall(function()
        local replicatedStorage = game:GetService("ReplicatedStorage")
        if replicatedStorage then
            scanAndBlock(replicatedStorage)
        end
    end)

    -- Metatable/namecall hooking: do this only if safe functions exist.
    if type(getrawmetatable) == "function" and type(getnamecallmethod) == "function" then
        local ok, mt = pcall(getrawmetatable, game)
        if ok and type(mt) == "table" then
            local oldNamecall = mt.__namecall
            -- Try to make metatable writable if setreadonly exists in this environment
            if type(setreadonly) == "function" then
                pcall(setreadonly, mt, false)
            end

            mt.__namecall = newcclosure and newcclosure(function(self, ...)
                local method = ""
                pcall(function() method = tostring(getnamecallmethod()) end)
                if method:lower():find("walkspeed") then
                    -- Return default value to avoid detection when scripts inspect WalkSpeed (best-effort)
                    return 16
                end
                if oldNamecall then
                    return oldNamecall(self, ...)
                end
            end) or function(self, ...)
                local method = ""
                pcall(function() method = tostring(getnamecallmethod()) end)
                if method:lower():find("walkspeed") then
                    return 16
                end
                if oldNamecall then
                    return oldNamecall(self, ...)
                end
            end

            if type(setreadonly) == "function" then
                pcall(setreadonly, mt, true)
            end
        end
    end
end

-- ============================================================
--  FLY SYSTEM
-- ============================================================
local flyConnection = nil
local flyBodyVelocity = nil
local flyBodyGyro = nil

local function stopFly()
    if flyBodyVelocity then
        pcall(function() flyBodyVelocity:Destroy() end)
        flyBodyVelocity = nil
    end
    if flyBodyGyro then
        pcall(function() flyBodyGyro:Destroy() end)
        flyBodyGyro = nil
    end
    if flyConnection then
        pcall(function() flyConnection:Disconnect() end)
        flyConnection = nil
    end
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    stopFly()

    -- Create BodyVelocity & BodyGyro (wrapped in pcall)
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(4e4, 4e4, 4e4)
    flyBodyVelocity.Velocity = Vector3.new(0, 0, 0)
    flyBodyVelocity.P = 1250
    flyBodyVelocity.Parent = root

    flyBodyGyro = Instance.new("BodyGyro")
    flyBodyGyro.MaxTorque = Vector3.new(4e4, 4e4, 4e4)
    flyBodyGyro.P = 3000
    flyBodyGyro.Parent = root

    flyConnection = RunService.Heartbeat:Connect(function()
        if not Settings.FlyEnabled then return end
        if not root or not root.Parent then
            stopFly()
            return
        end

        local moveDirection = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - root.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + root.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            moveDirection = moveDirection - Vector3.new(0, 1, 0)
        end

        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit * math.clamp(Settings.FlySpeed or 50, 1, 1000)
        end

        if flyBodyVelocity and flyBodyGyro then
            flyBodyVelocity.Velocity = moveDirection
            flyBodyGyro.CFrame = root.CFrame
        end
    end)
end

local function toggleFly()
    Settings.FlyEnabled = not Settings.FlyEnabled
    if Settings.FlyEnabled then
        startFly()
    else
        stopFly()
    end
end

-- ============================================================
--  NOCLIP SYSTEM
-- ============================================================
local function toggleNoclip()
    Settings.NoclipEnabled = not Settings.NoclipEnabled
    local char = LocalPlayer.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function() part.CanCollide = not Settings.NoclipEnabled end)
            end
        end
    end
end

-- ============================================================
--  WALKSPEED SYSTEM
-- ============================================================
local function applyWalkSpeed(speed)
    Settings.WalkSpeed = speed
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            pcall(function() humanoid.WalkSpeed = math.clamp(speed or 16, 0, 1000) end)
        end
    end
end

-- ============================================================
--  CHARACTER RESPAWN HANDLER
-- ============================================================
LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Settings.FlyEnabled then startFly() end
    if Settings.NoclipEnabled then
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.CanCollide = false end)
                end
            end
        end
    end
    applyWalkSpeed(Settings.WalkSpeed)
end)

