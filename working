        flyBtn.BackgroundColor3 = Settings.FlyEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        flyBtn.Text = Settings.FlyEnabled and "ON" or "OFF"
    end)

    noclipBtn.MouseButton1Click:Connect(function()
        toggleNoclip()
        noclipBtn.BackgroundColor3 = Settings.NoclipEnabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(200, 50, 50)
        noclipBtn.Text = Settings.NoclipEnabled and "ON" or "OFF"
    end)

    -- Generic helper to compute relative slider value
    local function sliderRelFromAbs(frameRef, absX)
        local sliderPos = frameRef.AbsolutePosition.X
        local sliderWidth = frameRef.AbsoluteSize.X
        if sliderWidth <= 0 then return 0 end
        local rel = math.clamp((absX - sliderPos) / sliderWidth, 0, 1)
        return rel
    end

    -- Fly speed logic
    local speedDragging = false
    local function updateSpeedFromInput(pos)
        local rel = sliderRelFromAbs(speedSlider, pos.X)
        local newSpeed = math.round(10 + rel * 190) -- 10..200
        newSpeed = math.clamp(newSpeed, 10, 200)
        speedLabel.Text = "Fly Speed: " .. tostring(newSpeed)
        speedFill.Size = UDim2.new(rel, 0, 1, 0)
        Settings.FlySpeed = newSpeed
    end

    speedSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            speedDragging = true
            updateSpeedFromInput(input.Position)
        end
    end)
    speedSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            speedDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if speedDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateSpeedFromInput(input.Position)
        end
    end)

    -- Walk speed logic
    local wsDragging = false
    local function updateWsFromInput(pos)
        local rel = sliderRelFromAbs(wsSlider, pos.X)
        local newSpeed = math.round(16 + rel * 184) -- 16..200
        newSpeed = math.clamp(newSpeed, 16, 200)
        wsLabel.Text = "WalkSpeed: " .. tostring(newSpeed)
        wsFill.Size = UDim2.new(rel, 0, 1, 0)
        applyWalkSpeed(newSpeed)
    end

    wsSlider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = true
            updateWsFromInput(input.Position)
        end
    end)
    wsSlider.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            wsDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if wsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            updateWsFromInput(input.Position)
        end
    end)

    -- Hide on close instead of destroying
    close.MouseButton1Click:Connect(function()
        frame.Visible = false
    end)

    -- Toggle GUI with R (global listener)
    local rConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)
    table.insert(guiConnections, rConn)

    -- Implement dragging (replacement for deprecated Draggable)
    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    local dragConn = UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    table.insert(guiConnections, dragConn)

    print("✅ Movement Controller GUI loaded! Press R to toggle.")
end

