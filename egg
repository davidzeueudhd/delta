--[[
    Script Name: 🥚 EGG SPAWNER
    Type: LocalScript
    Description: Spawns eggs directly into your inventory
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ========== EGG NAMES ==========
local EggNames = {
    "Egg",
    "GoldenEgg",
    "DragonEgg",
    "PhoenixEgg",
    "UnicornEgg",
    "MythicalEgg",
    "GodlyEgg",
    "RainbowEgg",
    "DarkEgg",
    "CrystalEgg",
    "DivineEgg",
    "CosmicEgg",
    "CelestialEgg",
    "LegendaryEgg",
    "AncientEgg",
}

-- ========== FIND INVENTORY ==========
local function FindInventory()
    local locations = {
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer:FindFirstChild("Inventory"),
        LocalPlayer:FindFirstChild("StarterGear"),
        LocalPlayer:FindFirstChild("Items"),
        workspace:FindFirstChild("Inventory"),
    }
    for _, loc in ipairs(locations) do
        if loc then return loc end
    end
    return LocalPlayer
end

-- ========== SPAWN EGG ==========
local function SpawnEgg()
    local eggName = EggNames[math.random(1, #EggNames)]
    print("🥚 Spawning: " .. eggName)
    
    local success = false
    
    -- METHOD 1: Try remote events
    local remotes = {}
    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if child:IsA("RemoteEvent") then
            table.insert(remotes, child)
        end
    end
    
    for _, remote in ipairs(remotes) do
        local name = (remote.Name or ""):lower()
        if name:find("give") or name:find("add") or name:find("spawn") or name:find("egg") then
            pcall(function()
                remote:FireServer(eggName, 1)
                remote:FireServer(eggName, LocalPlayer, 1)
                remote:FireServer({Name = eggName, Amount = 1})
                remote:FireServer(eggName, "Backpack")
                success = true
                print("✅ Spawned via remote: " .. remote.Name)
            end)
            if success then break end
        end
    end
    
    -- METHOD 2: Clone existing egg
    if not success then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Tool") or obj:IsA("Model") then
                local name = (obj.Name or ""):lower()
                if name:find("egg") then
                    local clone = obj:Clone()
                    clone.Parent = FindInventory()
                    print("✅ Cloned: " .. clone.Name)
                    success = true
                    break
                end
            end
        end
    end
    
    -- METHOD 3: Create new egg tool
    if not success then
        local tool = Instance.new("Tool")
        tool.Name = eggName
        tool.RequiresHandle = false
        
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(2, 3, 2)
        handle.Shape = Enum.PartType.Ball
        handle.Color = Color3.fromRGB(255, 215, 0)
        handle.Material = Enum.Material.Neon
        handle.Anchored = false
        handle.CanCollide = false
        handle.Parent = tool
        
        tool.Parent = FindInventory()
        print("✅ Created: " .. tool.Name)
        success = true
    end
    
    return success
end

