-- ======================================================
-- 🥚 SIMPLE TELEPORT SCRIPT - WORKING
-- ======================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ========== GET PLAYER ROOT ==========
local function GetRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

-- ========== TELEPORT TO POSITION ==========
local function TeleportTo(position)
    local root = GetRoot()
    if not root then
        print("❌ No character found!")
        return false
    end
    root.CFrame = CFrame.new(position)
    return true
end

-- ========== FIND EGGS ==========
local function FindEggs()
    local eggs = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            if name:find("egg") or name:find("nest") then
                table.insert(eggs, obj)
            end
        end
    end
    return eggs
end

-- ========== FIND BEST EGG ==========
local function GetBestEgg()
    local root = GetRoot()
    if not root then return nil end
    
    local eggs = FindEggs()
    local best = nil
    local bestScore = -math.huge
    
    for _, egg in ipairs(eggs) do
        if egg:IsA("BasePart") then
            local dist = (egg.Position - root.Position).Magnitude
            local value = 0
            local valueTag = egg:FindFirstChild("Value")
            if valueTag and valueTag:IsA("IntValue") then
                value = valueTag.Value
            end
            local score = value - dist * 0.5
            if score > bestScore then
                bestScore = score
                best = egg
            end
        end
    end
    
    return best
end

-- ========== TELEPORT TO BEST EGG ==========
local function TeleportToBestEgg()
    local egg = GetBestEgg()
    if not egg then
        print("❌ No eggs found!")
        return
    end
    
    print("🥚 Teleporting to: " .. egg.Name)
    local success = TeleportTo(egg.Position + Vector3.new(0, 2, 0))
    
    if success then
        print("✅ Teleported to egg!")
        print("📍 Now manually click the egg to grab it.")
    end
end

-- ========== TELEPORT TO BASE ==========
local MyBasePosition = nil

local function SetBase()
    local root = GetRoot()
    if not root then
        print("❌ No character!")
        return
    end
    MyBasePosition = root.Position
    print("🏠 Base set at: " .. tostring(MyBasePosition))
end

local function TeleportToBase()
    if not MyBasePosition then
        print("❌ Base not set! Click 'SET BASE' first.")
        return
    end
    TeleportTo(MyBasePosition + Vector3.new(0, 2, 0))
    print("🏠 Teleported to base!")
end

