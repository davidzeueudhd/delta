print("🚀 SCRIPT STARTED!")

-- Check if script is running
local LocalPlayer = game:GetService("Players").LocalPlayer
print("✅ Player: " .. LocalPlayer.Name)

-- Check if we can create a part
local testPart = Instance.new("Part")
testPart.Name = "DEBUG_PART"
testPart.Size = Vector3.new(5, 5, 5)
testPart.Anchored = true
testPart.Position = Vector3.new(0, 50, 0)
testPart.Color = Color3.fromRGB(255, 0, 0)
testPart.Parent = workspace
print("✅ Red part created at 0, 50, 0! Look for it!")

-- Try to spawn an egg
local tool = Instance.new("Tool")
tool.Name = "SpawnedEgg"
tool.RequiresHandle = false

local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(2, 3, 2)
handle.Shape = Enum.PartType.Ball
handle.Color = Color3.fromRGB(255, 215, 0)
handle.Material = Enum.Material.Neon
handle.Parent = tool

local backpack = LocalPlayer:FindFirstChild("Backpack")
local inventory = LocalPlayer:FindFirstChild("Inventory")

if backpack then
    tool.Parent = backpack
    print("✅ EGG IN BACKPACK!")
elseif inventory then
    tool.Parent = inventory
    print("✅ EGG IN INVENTORY!")
else
    tool.Parent = LocalPlayer
    print("✅ EGG ADDED TO PLAYER!")
end

print("🎯 SCRIPT FINISHED! Look for:")
print("  - Red part at position 0, 50, 0")
print("  - Egg in your inventory/backpack")
