    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.BorderSizePixel = 0
    close.Parent = frame
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = close
    
    -- Button Functions
    tpBtn.MouseButton1Click:Connect(function()
        status.Text = "⏳ Finding best egg..."
        status.TextColor3 = Color3.fromRGB(255, 200, 0)
        TeleportToBestEgg()
        status.Text = "✅ Done!"
        status.TextColor3 = Color3.fromRGB(0, 255, 100)
        task.wait(2)
        status.Text = "🟢 Ready"
    end)
    
    grabBtn.MouseButton1Click:Connect(function()
        local egg, _ = GetBestEgg()
        if egg and egg:IsA("BasePart") then
            local clickDetector = egg:FindFirstChild("ClickDetector")
            if clickDetector and clickDetector:IsA("ClickDetector") then
                clickDetector:FireClick(LocalPlayer)
                print("⚡ Instantly grabbed egg!")
                status.Text = "✅ Grabbed!"
                status.TextColor3 = Color3.fromRGB(0, 255, 100)
                task.wait(2)
                status.Text = "🟢 Ready"
            end
        else
            print("❌ No egg found!")
        end
    end)
    
    setBaseBtn.MouseButton1Click:Connect(function()
        SetBase()
        status.Text = "✅ Base Set!"
        status.TextColor3 = Color3.fromRGB(0, 255, 100)
        task.wait(2)
        status.Text = "🟢 Ready"
    end)
    
    tpBaseBtn.MouseButton1Click:Connect(function()
