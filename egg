    foundLabel.TextScaled = true
    foundLabel.Font = Enum.Font.GothamMedium
    foundLabel.Parent = mainFrame

    -- Start/Stop Button
    local toggleButton = Instance.new("TextButton")
    toggleButton.Size = UDim2.new(0, 120, 0, 40)
    toggleButton.Position = UDim2.new(0.5, -60, 0, 145)
    toggleButton.BackgroundColor3 = Color3.fromRGB(255, 80, 80)
    toggleButton.Text = "START"
    toggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    toggleButton.TextScaled = true
    toggleButton.Font = Enum.Font.GothamBold
    toggleButton.BorderSizePixel = 0
    toggleButton.Parent = mainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = toggleButton

    -- Close Button
    local closeButton = Instance.new("TextButton")
    closeButton.Size = UDim2.new(0, 25, 0, 25)
    closeButton.Position = UDim2.new(1, -35, 0, 8)
    closeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    closeButton.Text = "✕"
    closeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    closeButton.TextScaled = true
    closeButton.Font = Enum.Font.GothamBold
    closeButton.BorderSizePixel = 0
    closeButton.Parent = mainFrame

    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = closeButton

    -- Button functions
    local eggCount = 0
    
    toggleButton.MouseButton1Click:Connect(function()
        Config.Enabled = not Config.Enabled
        toggleButton.BackgroundColor3 = Config.Enabled and Color3.fromRGB(0, 200, 100) or Color3.fromRGB(255, 80, 80)
        toggleButton.Text = Config.Enabled and "STOP" or "START"
        statusLabel.Text = Config.Enabled and "🟢 Status: ACTIVE" or "🔴 Status: OFF"
        statusLabel.TextColor3 = Config.Enabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 80, 80)
        
        if Config.Enabled then
            EggStealer:Start()
        else
            EggStealer:Stop()
        end
    end)

    closeButton.MouseButton1Click:Connect(function()
        EggStealer:Stop()
        screenGui:Destroy()
    end)

    -- Update egg count
    game:GetService("RunService").Heartbeat:Connect(function()
        if Config.Enabled then
            local eggs = EggStealer:FindEggs()
            eggCount = #eggs
            foundLabel.Text = "Eggs Found: " .. eggCount
        end
    end)

    -- Keybind
    game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode[Config.ToggleKey] then
            mainFrame.Visible = not mainFrame.Visible
        end
    end)

    return screenGui
end

-- ========== INIT ==========
task.wait(0.5)
local gui = CreateMenu()

print("🥚 Egg Stealer LOADED!")
print("📌 Press 'R' to toggle menu")
print("⚡ Click START to steal eggs!")

-- Clean up
RunService.Heartbeat:Connect(function()
    if not LocalPlayer.Parent then
        EggStealer:Stop()
    end
    if gui and not gui.Parent then
        local parent = LocalPlayer:FindFirstChild("PlayerGui")
        if parent then gui.Parent = parent end
    end
end)
