-- ========== STEALTH SYSTEM (UNDETECTED) ==========
local Stealth = {}

-- Technique 1: Random delays between actions (looks human)
function Stealth:RandomDelay(min, max)
    local delay = math.random(min * 100, max * 100) / 100
    task.wait(delay)
end

-- Technique 2: Randomize action order
function Stealth:RandomizeActions(actions)
    for i = #actions, 2, -1 do
        local j = math.random(i)
        actions[i], actions[j] = actions[j], actions[i]
    end
    return actions
end

-- Technique 3: Don't override functions (detectable)
function Stealth:NoOverrides()
    -- Intentionally empty - we don't override anything
    -- Overriding functions is easily detected
end

-- Technique 4: Use existing events instead of creating new ones
function Stealth:UseExistingEvents()
    -- We'll use Heartbeat which is normal for games
    return RunService.Heartbeat
end

-- Technique 5: Randomize collection methods
function Stealth:RandomCollectionMethod()
    local methods = {
        "ClickDetector",
        "Touch",
        "RemoteEvent",
        "ProximityPrompt"
    }
    return methods[math.random(1, #methods)]
end

