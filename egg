-- ========== EGG FINDER ==========
local EggFinder = {}
local eggList = {}
local selectedEgg = nil

function EggFinder:FindAllEggs()
    local eggs = {}
    local seen = {}
    
    pcall(function()
        -- Search Workspace
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Model") then
                local name = (part.Name or ""):lower()
                local isEgg = false
                
                for _, eggName in ipairs(EggNames) do
                    if name:find(eggName:lower()) then
                        isEgg = true
                        break
                    end
                end
                
                if not isEgg and name:find("egg") then
                    isEgg = true
                end
                
                if isEgg and not seen[part] then
                    seen[part] = true
                    table.insert(eggs, part)
                end
            end
        end
        
        -- Search ReplicatedStorage
        for _, part in ipairs(ReplicatedStorage:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Model") then
                local name = (part.Name or ""):lower()
                if name:find("egg") and not seen[part] then
                    seen[part] = true
                    table.insert(eggs, part)
                end
            end
        end
    end)
    
    return eggs
end

function EggFinder:GetEggInfo(egg)
    local info = {
        Object = egg,
        Name = egg.Name or "Unknown Egg",
        Position = egg:IsA("BasePart") and egg.Position or Vector3.new(0, 0, 0),
        Distance = 0,
        Rarity = "Unknown",
        Color = Color3.fromRGB(200, 200, 200),
    }
    
    -- Get distance
    local character = LocalPlayer.Character
    if character then
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if rootPart and egg:IsA("BasePart") then
            info.Distance = (egg.Position - rootPart.Position).Magnitude
        end
    end
    
    -- Guess rarity from name
    local name = info.Name:lower()
    if name:find("godly") or name:find("divine") or name:find("cosmic") or name:find("celestial") then
        info.Rarity = "🌟 GODLY"
        info.Color = Color3.fromRGB(255, 215, 0)
    elseif name:find("mythical") or name:find("rainbow") or name:find("prismatic") then
        info.Rarity = "🌈 MYTHICAL"
        info.Color = Color3.fromRGB(255, 0, 255)
    elseif name:find("legendary") or name:find("dragon") or name:find("phoenix") or name:find("unicorn") then
        info.Rarity = "🔥 LEGENDARY"
        info.Color = Color3.fromRGB(255, 100, 0)
    elseif name:find("golden") or name:find("crystal") or name:find("ancient") then
        info.Rarity = "💎 RARE"
        info.Color = Color3.fromRGB(0, 200, 255)
    elseif name:find("mystery") or name:find("event") or name:find("special") then
        info.Rarity = "🎁 EVENT"
        info.Color = Color3.fromRGB(255, 50, 200)
    elseif name:find("egg") then
        info.Rarity = "🥚 NORMAL"
        info.Color = Color3.fromRGB(200, 200, 200)
    end
    
    return info
end

-- ========== EGG STEALER ==========
local EggStealer = {}

function EggStealer:TeleportAndSteal(egg)
    if not Config.Enabled or not egg then return end
    
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Smooth teleport to egg
        if Config.TeleportToEgg and egg:IsA("BasePart") then
            local targetPos = egg.Position + Vector3.new(0, 2, 0)
            rootPart.CFrame = CFrame.new(targetPos)
            task.wait(0.1)
        end
        
        -- Collect egg
        local collected = false
        
        -- ClickDetector
        local clickDetector = egg:FindFirstChild("ClickDetector")
        if clickDetector then
            clickDetector:FireClick(LocalPlayer)
            collected = true
            print("✅ Clicked: " .. egg.Name)
        end
        
        -- Touch
        if not collected then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
            collected = true
            print("✅ Touched: " .. egg.Name)
        end
        
        -- ProximityPrompt
        if not collected then
            local prompt = egg:FindFirstChild("ProximityPrompt")
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
                collected = true
                print("✅ Used Prompt: " .. egg.Name)
            end
        end
        
        -- RemoteEvent
        if not collected then
            local remoteEvent = ReplicatedStorage:FindFirstChild("CollectEgg")
            if remoteEvent and remoteEvent:IsA("RemoteEvent") then
                remoteEvent:FireServer(egg)
                collected = true
                print("✅ Fired Remote: " .. egg.Name)
            end
        end
        
        if not collected then
            print("⚠️ Teleported to " .. egg.Name .. " but couldn't collect")
        end
    end)
end

