-- ========== REAL INVENTORY SYSTEM FINDER ==========
local InventorySystem = {}

function InventorySystem:FindDataStore()
    -- Search for game's data system
    local dataSystems = {
        ReplicatedStorage:FindFirstChild("Data"),
        ReplicatedStorage:FindFirstChild("Inventory"),
        ReplicatedStorage:FindFirstChild("Items"),
        ReplicatedStorage:FindFirstChild("GameData"),
        ServerStorage:FindFirstChild("Data"),
        ServerStorage:FindFirstChild("Inventory"),
        LocalPlayer:FindFirstChild("Data"),
        LocalPlayer:FindFirstChild("Inventory"),
    }
    
    for _, system in ipairs(dataSystems) do
        if system then
            return system
        end
    end
    return nil
end

function InventorySystem:FindGiveItemRemote()
    -- Search for remote events that give items
    local remoteNames = {
        "GiveItem", "AddItem", "SpawnItem", "GetItem",
        "CollectItem", "ClaimItem", "AddToInventory",
        "GiveEgg", "SpawnEgg", "CollectEgg", "ClaimEgg"
    }
    
    for _, name in ipairs(remoteNames) do
        local remote = ReplicatedStorage:FindFirstChild(name)
        if remote and remote:IsA("RemoteEvent") then
            return remote
        end
    end
    
    -- Search all remotes
    for _, child in ipairs(ReplicatedStorage:GetChildren()) do
        if child:IsA("RemoteEvent") then
            local name = (child.Name or ""):lower()
            if name:find("give") or name:find("add") or name:find("spawn") or name:find("collect") or name:find("claim") then
                return child
            end
        end
    end
    
    return nil
end

function InventorySystem:FindInventory()
    -- Check common inventory locations
    local locations = {
        LocalPlayer:FindFirstChild("Inventory"),
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer:FindFirstChild("Items"),
        LocalPlayer:FindFirstChild("Collection"),
        LocalPlayer:FindFirstChild("PlayerGui"):FindFirstChild("Inventory"),
        workspace:FindFirstChild("Inventory"),
    }
    
    for _, location in ipairs(locations) do
        if location then
            return location
        end
    end
    
    -- Search for folders with item-like contents
    for _, child in ipairs(LocalPlayer:GetChildren()) do
        if child:IsA("Folder") or child:IsA("Model") then
            local name = (child.Name or ""):lower()
            if name:find("inventory") or name:find("items") or name:find("collection") or name:find("backpack") then
                return child
            end
        end
    end
    
    return nil
end

-- ========== REAL EGG SPAWNER ==========
local EggSpawner = {}

function EggSpawner:SpawnRealEgg()
    if not Config.Enabled then return end
    
    local eggData = EggData[Config.EggRarity] or EggData["Godly"]
    local success = false
    
    pcall(function()
        -- Method 1: Remote Event
        local remote = InventorySystem:FindGiveItemRemote()
        if remote then
            print("📡 Found remote: " .. remote.Name)
            
            -- Try different remote arguments
            local attempts = {
                {eggData.ID, 1},
                {eggData.Name, 1},
                {eggData.ID, Config.SpawnAmount},
                {eggData.Name, Config.SpawnAmount},
                {eggData.ID, LocalPlayer, 1},
                {eggData.Name, LocalPlayer, 1},
                {eggData},
                {eggData.ID},
                {eggData.Name},
                {tonumber(eggData.ID) or 1},
            }
            
            for _, args in ipairs(attempts) do
                pcall(function()
                    remote:FireServer(unpack(args))
                    success = true
                    print("✅ Fired remote: " .. remote.Name)
                end)
                if success then break end
            end
        end
        
        -- Method 2: Find and clone existing egg
        if not success then
            -- Search for egg templates
            local eggTemplates = {}
            local locations = {ReplicatedStorage, ServerStorage, workspace, game:GetService("Lighting")}
            
            for _, location in ipairs(locations) do
                if location then
                    for _, child in ipairs(location:GetDescendants()) do
                        if child:IsA("Tool") or child:IsA("Model") then
                            local name = (child.Name or ""):lower()
                            for _, eggName in ipairs({"egg", "godly", "legendary", "mythical", "rainbow", "celestial"}) do
                                if name:find(eggName) then
                                    table.insert(eggTemplates, child)
                                    break
                                end
                            end
                        end
                    end
                end
            end
            
            if #eggTemplates > 0 then
                local template = eggTemplates[math.random(1, #eggTemplates)]
                local newEgg = template:Clone()
                newEgg.Name = eggData.Name
                newEgg.Parent = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer
                success = true
                print("✅ Cloned egg: " .. newEgg.Name)
            end
        end
        
        -- Method 3: Create proper tool
        if not success then
            local tool = Instance.new("Tool")
            tool.Name = eggData.Name
            tool.RequiresHandle = false
            
            -- Add handle for visual
            local handle = Instance.new("Part")
            handle.Name = "Handle"
            handle.Size = Vector3.new(2, 3, 2)
            handle.Shape = Enum.PartType.Ball
            handle.Color = eggData.Color
            handle.Material = Enum.Material.Neon
            handle.Transparency = 0.2
            handle.Anchored = false
            handle.CanCollide = false
            handle.Parent = tool
            
            -- Add glow
            local light = Instance.new("PointLight")
            light.Color = eggData.Color
            light.Brightness = 3
            light.Range = 15
            light.Parent = handle
            
            -- Add value tag (for trading systems)
            local value = Instance.new("IntValue")
            value.Name = "Value"
            value.Value = eggData.Value
            value.Parent = tool
            
            local rarity = Instance.new("StringValue")
            rarity.Name = "Rarity"
            rarity.Value = eggData.Rarity
            rarity.Parent = tool
            
            -- Try to add to inventory
            local inventory = InventorySystem:FindInventory()
            if inventory then
                tool.Parent = inventory
            else
                tool.Parent = LocalPlayer:FindFirstChild("Backpack") or LocalPlayer
            end
            
            success = true
            print("✅ Created tool: " .. tool.Name)
        end
        
        if success then
            print("🥚 " .. eggData.Name .. " spawned successfully!")
        else
            print("❌ Could not spawn egg. Trying alternative methods...")
            -- Method 4: Fire all remotes with common names
            local commonRemotes = {"GiveItem", "AddItem", "SpawnItem", "GetItem", "CollectItem"}
            for _, remoteName in ipairs(commonRemotes) do
                local remote = ReplicatedStorage:FindFirstChild(remoteName)
                if remote and remote:IsA("RemoteEvent") then
                    pcall(function()
                        remote:FireServer(eggData.ID, 1)
                        success = true
                        print("✅ Spawned via " .. remoteName)
                    end)
                    if success then break end
                end
            end
        end
    end)
    
    return success
end

function EggSpawner:SpawnMultiple(amount)
    if not amount then amount = Config.SpawnAmount end
    
    local spawned = 0
    for i = 1, amount do
        if self:SpawnRealEgg() then
            spawned = spawned + 1
        end
        task.wait(0.3)
    end
    
    print("✅ Spawned " .. spawned .. " " .. Config.EggRarity .. " eggs!")
    return spawned
end

-- ========== INVENTORY CHECKER ==========
function EggSpawner:CheckInventory()
    local inventory = InventorySystem:FindInventory()
    if not inventory then
        print("❌ Could not find inventory")
        return
    end
    
    local eggs = {}
    for _, child in ipairs(inventory:GetChildren()) do
        local name = (child.Name or ""):lower()
        if name:find("egg") then
            table.insert(eggs, child.Name)
        end
    end
    
    if #eggs > 0 then
        print("📋 Eggs in inventory:")
        for _, egg in ipairs(eggs) do
            print("  🥚 " .. egg)
        end
    else
        print("📋 No eggs found in inventory")
    end
    
    return eggs
end

