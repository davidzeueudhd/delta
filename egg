    grabBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    grabBtn.Text = "⚡ GRAB"
    grabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    grabBtn.TextScaled = true
    grabBtn.Font = Enum.Font.GothamBold
    grabBtn.BorderSizePixel = 0
    grabBtn.Parent = frame
    
    local grabCorner = Instance.new("UICorner")
    grabCorner.CornerRadius = UDim.new(0, 8)
    grabCorner.Parent = grabBtn
    
    -- Set Base Button
    local setBaseBtn = Instance.new("TextButton")
    setBaseBtn.Size = UDim2.new(0.38, 0, 0, 30)
    setBaseBtn.Position = UDim2.new(0.56, 0, 0, 120)
    setBaseBtn.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
    setBaseBtn.Text = "🏠 SET BASE"
    setBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    setBaseBtn.TextScaled = true
    setBaseBtn.Font = Enum.Font.GothamBold
    setBaseBtn.BorderSizePixel = 0
    setBaseBtn.Parent = frame
    
    local baseCorner = Instance.new("UICorner")
    baseCorner.CornerRadius = UDim.new(0, 8)
    baseCorner.Parent = setBaseBtn
    
    -- Teleport to Base Button
    local tpBaseBtn = Instance.new("TextButton")
    tpBaseBtn.Size = UDim2.new(0.8, 0, 0, 35)
    tpBaseBtn.Position = UDim2.new(0.1, 0, 0, 162)
    tpBaseBtn.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
    tpBaseBtn.Text = "🏠 TP TO BASE"
    tpBaseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    tpBaseBtn.TextScaled = true
    tpBaseBtn.Font = Enum.Font.GothamBold
    tpBaseBtn.BorderSizePixel = 0
    tpBaseBtn.Parent = frame
    
    local tpBaseCorner = Instance.new("UICorner")
    tpBaseCorner.CornerRadius = UDim.new(0, 10)
    tpBaseCorner.Parent = tpBaseBtn
    
    -- Close
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 25, 0, 25)
    close.Position = UDim2.new(1, -35, 0, 6)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
