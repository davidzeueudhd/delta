-- ========== STEALTH EGG STEALER ==========
local EggStealer = {}
local stolenEggs = {}
local stealConnection = nil
local actionCounter = 0

function EggStealer:FindEggs()
    local eggs = {}
    
    -- Search ONLY in workspace (normal behavior)
    pcall(function()
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Model") then
                local name = (part.Name or ""):lower()
                -- Only check common egg names (not suspicious)
                local eggKeywords = {"egg", "easter", "hatch", "collect", "golden"}
                
                for _, keyword in ipairs(eggKeywords) do
                    if name:find(keyword) then
                        table.insert(eggs, part)
                        break
                    end
                end
            end
        end
    end)
    
    return eggs
end

function EggStealer:StealthSteal(egg)
    if not Config.Enabled then return end
    
    actionCounter = actionCounter + 1
    
    -- Random delay between actions (looks human)
    Stealth:RandomDelay(0.3, 1.5)
    
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Only teleport if enabled and with random offset
        if Config.TeleportToEgg and egg:IsA("BasePart") then
            local offset = Vector3.new(
                math.random(-1, 1),
                math.random(1, 2),
                math.random(-1, 1)
            )
            -- Gradual teleport (less detectable)
            local targetPos = egg.Position + offset
            local currentPos = rootPart.Position
            local steps = 5
            
            for i = 1, steps do
                local progress = i / steps
                local newPos = currentPos:Lerp(targetPos, progress)
                rootPart.CFrame = CFrame.new(newPos)
                Stealth:RandomDelay(0.05, 0.15)
            end
        end
        
        -- Randomize collection method
        local method = Stealth:RandomCollectionMethod()
        
        if method == "ClickDetector" then
            local clickDetector = egg:FindFirstChild("ClickDetector")
            if clickDetector then
                clickDetector:FireClick(LocalPlayer)
            end
        elseif method == "Touch" then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
        elseif method == "RemoteEvent" then
            local remoteEvent = ReplicatedStorage:FindFirstChild("CollectEgg")
            if remoteEvent and remoteEvent:IsA("RemoteEvent") then
                remoteEvent:FireServer(egg)
            end
        elseif method == "ProximityPrompt" then
            local prompt = egg:FindFirstChild("ProximityPrompt")
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            end
        end
        
        -- Only convert to rare sometimes (less suspicious)
        if math.random() < 0.7 then -- 70% chance
            local rareNames = RareEggNames[Config.EggRarity] or RareEggNames["Godly"]
            local newName = rareNames[math.random(1, #rareNames)]
            egg.Name = newName
            
            -- Only change color sometimes
            if math.random() < 0.5 and egg:IsA("BasePart") then
                local colors = {
                    Color3.fromRGB(255, 215, 0),
                    Color3.fromRGB(255, 0, 255),
                    Color3.fromRGB(0, 255, 255),
                }
                egg.Color = colors[math.random(1, #colors)]
            end
        end
        
        -- Random success message (spam less)
        if math.random() < 0.1 then -- 10% chance
            print("🥚 Found something!")
        end
    end)
end

function EggStealer:StealAllEggs()
    -- Only run every few frames (less detectable)
    if actionCounter % 3 ~= 0 then return end
    
    local eggs = self:FindEggs()
    
    if #eggs == 0 then
        -- Spawn eggs rarely (less suspicious)
        if math.random() < 0.02 then -- 2% chance
            self:SpawnEgg()
        end
        return
    end
    
    -- Only steal 1-2 eggs at a time (looks human)
    local stealCount = math.random(1, math.min(2, #eggs))
    local shuffledEggs = {}
    for _, egg in ipairs(eggs) do
        table.insert(shuffledEggs, egg)
    end
    
    -- Shuffle eggs
    for i = #shuffledEggs, 2, -1 do
        local j = math.random(i)
        shuffledEggs[i], shuffledEggs[j] = shuffledEggs[j], shuffledEggs[i]
    end
    
    for i = 1, stealCount do
        local egg = shuffledEggs[i]
        if egg and not stolenEggs[egg] then
            stolenEggs[egg] = true
            self:StealthSteal(egg)
            -- Random delay between steals
            Stealth:RandomDelay(0.5, 2.0)
        end
    end
    
    -- Clean up old eggs from memory
    if #stolenEggs > 100 then
        local count = 0
        for key, _ in pairs(stolenEggs) do
            if count > 50 then break end
            stolenEggs[key] = nil
            count = count + 1
        end
    end
end

function EggStealer:SpawnEgg()
    pcall(function()
        local spawnPoints = {}
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.Name:lower():find("spawn") then
                table.insert(spawnPoints, part)
            end
        end
        
        if #spawnPoints > 0 then
            local spawnPoint = spawnPoints[math.random(1, #spawnPoints)]
            local egg = Instance.new("Part")
            egg.Size = Vector3.new(2, 3, 2)
            egg.Shape = Enum.PartType.Ball
            egg.CFrame = spawnPoint.CFrame + Vector3.new(0, 2, 0)
            egg.Anchored = true
            egg.CanCollide = false
            
            local rareNames = RareEggNames[Config.EggRarity] or RareEggNames["Godly"]
            egg.Name = rareNames[math.random(1, #rareNames)]
            egg.Color = Color3.fromRGB(255, 215, 0)
            
            -- Only add click detector sometimes
            if math.random() < 0.7 then
                local clickDetector = Instance.new("ClickDetector")
                clickDetector.MaxActivationDistance = 50
                clickDetector.Parent = egg
            end
            
            egg.Parent = Workspace
        end
    end)
end

function EggStealer:Start()
    if stealConnection then
        stealConnection:Disconnect()
        stealConnection = nil
    end
    
    stolenEggs = {}
    actionCounter = 0
    
    -- Use Heartbeat (normal for games)
    stealConnection = RunService.Heartbeat:Connect(function()
        if Config.Enabled then
            self:StealAllEggs()
        end
    end)
    
    print("🥚 Steal An Egg - STEALTH MODE ACTIVATED!")
end

function EggStealer:Stop()
    if stealConnection then
        stealConnection:Disconnect()
        stealConnection = nil
    end
    print("🥚 Steal An Egg - DEACTIVATED")
end

