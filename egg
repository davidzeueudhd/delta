--[[
    Script Name: 🥚 Egg Stealer - FIXED
    Type: LocalScript
    Compatible With: Delta Executor
    Description: Only targets actual eggs, no random teleports
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- ========== CONFIGURATION ==========
local Config = {
    Enabled = false,
    AutoCollect = true,
    TeleportToEgg = true,
    ToggleKey = "R",
}

-- ========== EGG STEALER ==========
local EggStealer = {}
local stolenEggs = {}
local stealConnection = nil

-- Function to find ONLY actual eggs
function EggStealer:FindEggs()
    local eggs = {}
    
    pcall(function()
        for _, part in ipairs(Workspace:GetDescendants()) do
            if part:IsA("BasePart") or part:IsA("Model") then
                local name = (part.Name or ""):lower()
                
                -- Only look for EXACT egg names
                local exactEggNames = {
                    "egg", "easteregg", "goldenegg", "dragonegg", 
                    "phoenixegg", "unicornegg", "mythicalegg", "godlyegg",
                    "rainbowegg", "darkegg", "crystalegg", "divineegg",
                    "cosmicegg", "celestialegg", "hatchegg", "petegg"
                }
                
                for _, eggName in ipairs(exactEggNames) do
                    if name:find(eggName) then
                        table.insert(eggs, part)
                        break
                    end
                end
            end
        end
    end)
    
    return eggs
end

-- Collect egg function
function EggStealer:CollectEgg(egg)
    if not Config.Enabled then return end
    
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        
        -- Teleport to egg
        if Config.TeleportToEgg and egg:IsA("BasePart") then
            rootPart.CFrame = CFrame.new(egg.Position + Vector3.new(0, 2, 0))
            task.wait(0.2)
        end
        
        -- Try to collect
        local collected = false
        
        -- Method 1: ClickDetector
        local clickDetector = egg:FindFirstChild("ClickDetector")
        if clickDetector then
            clickDetector:FireClick(LocalPlayer)
            collected = true
        end
        
        -- Method 2: Touch
        if not collected then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    egg.Touched:Fire(part)
                end
            end
            collected = true
        end
        
        -- Method 3: ProximityPrompt
        if not collected then
            local prompt = egg:FindFirstChild("ProximityPrompt")
            if prompt and prompt:IsA("ProximityPrompt") then
                prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
                collected = true
            end
        end
        
        if collected then
            print("🥚 Collected egg: " .. (egg.Name or "Egg"))
        end
    end)
end

-- Scan for eggs
function EggStealer:Scan()
    local eggs = self:FindEggs()
    
    if #eggs == 0 then
        return
    end
    
    for _, egg in ipairs(eggs) do
        if not stolenEggs[egg] then
            stolenEggs[egg] = true
            self:CollectEgg(egg)
            task.wait(0.5)
        end
    end
end

function EggStealer:Start()
    if stealConnection then
        stealConnection:Disconnect()
        stealConnection = nil
    end
    
    stolenEggs = {}
    
    stealConnection = RunService.Heartbeat:Connect(function()
        if Config.Enabled then
            self:Scan()
        end
    end)
    
    print("🥚 Egg Stealer ACTIVATED!")
end

function EggStealer:Stop()
    if stealConnection then
        stealConnection:Disconnect()
        stealConnection = nil
    end
    print("🥚 Egg Stealer DEACTIVATED")
end

