-- ========== INVENTORY FINDER ==========
local Inventory = {}

function Inventory:FindInventory()
    -- Search common inventory locations
    local locations = {
        LocalPlayer,
        LocalPlayer:FindFirstChild("PlayerGui"),
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer:FindFirstChild("StarterGear"),
        LocalPlayer:FindFirstChild("Inventory"),
        game:GetService("Players"),
        ReplicatedStorage,
        workspace,
    }
    
    for _, location in ipairs(locations) do
        if location then
            -- Check for common inventory names
            local inventoryNames = {"Inventory", "Items", "Backpack", "Gear", "Tools", "Collection"}
            for _, name in ipairs(inventoryNames) do
                local inv = location:FindFirstChild(name)
                if inv then
                    return inv
                end
            end
            
            -- Check if location itself is inventory
            if location:IsA("Folder") or location:IsA("Model") then
                local name = (location.Name or ""):lower()
                for _, invName in ipairs({"inventory", "items", "backpack", "gear"}) do
                    if name:find(invName) then
                        return location
                    end
                end
            end
        end
    end
    
    -- Fallback: create inventory folder
    local newInv = Instance.new("Folder")
    newInv.Name = "Inventory"
    newInv.Parent = LocalPlayer
    return newInv
end

function Inventory:GetEgg(name)
    -- Check if egg already exists
    local inventory = self:FindInventory()
    if not inventory then return nil end
    
    for _, child in ipairs(inventory:GetChildren()) do
        if child.Name == name then
            return child
        end
    end
    return nil
end

-- ========== EGG SPAWNER ==========
local EggSpawner = {}

function EggSpawner:SpawnEgg()
    if not Config.Enabled then return end
    
    pcall(function()
        -- Get random egg name from selected type
        local eggs = EggTypes[Config.EggType] or EggTypes["Godly"]
        local eggName = eggs[math.random(1, #eggs)]
        
        -- Find inventory
        local inventory = Inventory:FindInventory()
        if not inventory then
            print("❌ Could not find inventory!")
            return
        end
        
        -- Check if egg already exists
        local existing = Inventory:GetEgg(eggName)
        if existing then
            print("❌ " .. eggName .. " already in inventory!")
            return
        end
        
        -- Create the egg
        local egg = Instance.new("Tool")
        egg.Name = eggName
        egg.RequiresHandle = false
        
        -- Add handle for visual
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(2, 3, 2)
        handle.Shape = Enum.PartType.Ball
        handle.Color = Color3.fromRGB(255, 215, 0)
        handle.Material = Enum.Material.Neon
        handle.Transparency = 0.2
        handle.Anchored = false
        handle.CanCollide = false
        handle.Parent = egg
        
        -- Add glow
        local light = Instance.new("PointLight")
        light.Color = handle.Color
        light.Brightness = 2
        light.Range = 10
        light.Parent = handle
        
        -- Add particles (for cool effect)
        local particles = Instance.new("ParticleEmitter")
        particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
        particles.Rate = 20
        particles.Lifetime = NumberRange.new(0.5, 1)
        particles.SpreadAngle = Vector2.new(180, 180)
        particles.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0))
        particles.Transparency = NumberSequence.new(0, 1)
        particles.Size = NumberSequence.new(0.5, 1)
        particles.Parent = handle
        
        -- Add click script
        local clickScript = Instance.new("Script")
        clickScript.Name = "ClickScript"
        clickScript.Parent = egg
        
        clickScript.Source = [[
            local tool = script.Parent
            local player = game.Players.LocalPlayer
            
            tool.Activated:Connect(function()
                print("🍳 Clicked on " .. tool.Name)
                -- You can add custom click behavior here
            end)
        ]]
        
        -- Check if it's a tool (pet/egg) or item
        local isTool = true
        
        -- Try to add to inventory
        egg.Parent = inventory
        
        print("✅ Spawned: " .. eggName .. " in inventory!")
        
        -- If inventory is a tool, equip it
        if inventory:IsA("Backpack") or inventory.Name == "Backpack" then
            local character = LocalPlayer.Character
            if character then
                egg.Parent = character
                print("✅ Equipped: " .. eggName)
            end
        end
        
        -- Attempt remote event for spawning
        local remoteEvent = ReplicatedStorage:FindFirstChild("GiveItem")
        if remoteEvent and remoteEvent:IsA("RemoteEvent") then
            remoteEvent:FireServer(eggName, 1)
            print("✅ Remote spawned: " .. eggName)
        end
        
        -- Another remote
        local remoteEvent2 = ReplicatedStorage:FindFirstChild("SpawnEgg")
        if remoteEvent2 and remoteEvent2:IsA("RemoteEvent") then
            remoteEvent2:FireServer(eggName)
            print("✅ Remote2 spawned: " .. eggName)
        end
        
        return egg
    end)
end

function EggSpawner:SpawnMultiple(amount)
    if not amount then amount = Config.SpawnAmount end
    
    for i = 1, amount do
        self:SpawnEgg()
        task.wait(0.3)
    end
end

