    status.BackgroundTransparency = 1
    status.Text = "🟢 Ready"
    status.TextColor3 = Color3.fromRGB(0, 255, 100)
    status.TextScaled = true
    status.Font = Enum.Font.GothamBold
    status.Parent = frame
    
    -- Spawn Button
    local spawnBtn = Instance.new("TextButton")
