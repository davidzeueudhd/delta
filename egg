-- TEST SCRIPT - Run this first to see if anything works

print("🔍 TEST STARTING...")

-- Test 1: Check if script is running
print("✅ Script is running!")

-- Test 2: Check player
local LocalPlayer = game:GetService("Players").LocalPlayer
print("✅ Player: " .. LocalPlayer.Name)

-- Test 3: Check workspace for eggs
local eggs = {}
for _, obj in ipairs(workspace:GetDescendants()) do
    local name = (obj.Name or ""):lower()
    if name:find("egg") then
        table.insert(eggs, obj)
    end
end
print("✅ Eggs found: " .. #eggs)

-- Test 4: Check if we can create a part
local testPart = Instance.new("Part")
testPart.Name = "TestPart"
testPart.Size = Vector3.new(1, 1, 1)
testPart.Anchored = true
testPart.Position = Vector3.new(0, 10, 0)
testPart.Parent = workspace
print("✅ Created test part at 0, 10, 0")

-- Test 5: Try to create a tool (egg)
local testTool = Instance.new("Tool")
testTool.Name = "TestEgg"
testTool.RequiresHandle = false

local handle = Instance.new("Part")
handle.Name = "Handle"
handle.Size = Vector3.new(1, 1, 1)
handle.Color = Color3.fromRGB(255, 215, 0)
handle.Material = Enum.Material.Neon
handle.Parent = testTool

-- Try different inventory locations
local backpack = LocalPlayer:FindFirstChild("Backpack")
local inventory = LocalPlayer:FindFirstChild("Inventory")
local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

if backpack then
    testTool.Parent = backpack
    print("✅ Test egg added to Backpack!")
elseif inventory then
    testTool.Parent = inventory
    print("✅ Test egg added to Inventory!")
elseif playerGui then
    testTool.Parent = playerGui
    print("✅ Test egg added to PlayerGui!")
else
    testTool.Parent = LocalPlayer
    print("✅ Test egg added to LocalPlayer!")
end

print("🔍 TEST COMPLETE!")
print("📌 Check your inventory for 'TestEgg'")
print("📌 Check workspace for 'TestPart' at position 0, 10, 0")
