-- ========== FIND REMOTES ==========
local function FindRemotes()
    local remotes = {}
    
    -- Search all services for remote events
    local services = {
        ReplicatedStorage,
        Workspace,
        game:GetService("Lighting"),
        game:GetService("ServerScriptService"),
        LocalPlayer,
    }
    
    for _, service in ipairs(services) do
        pcall(function()
            for _, child in ipairs(service:GetDescendants()) do
                if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                    table.insert(remotes, child)
                end
            end
        end)
    end
    
    return remotes
end

-- ========== FIND INVENTORY ==========
local function FindInventory()
    -- Check common locations
    local locations = {
        LocalPlayer:FindFirstChild("Backpack"),
        LocalPlayer:FindFirstChild("Inventory"),
        LocalPlayer:FindFirstChild("StarterGear"),
        LocalPlayer:FindFirstChild("Items"),
        LocalPlayer:FindFirstChild("Collection"),
        workspace:FindFirstChild("Inventory"),
    }
    
    for _, loc in ipairs(locations) do
        if loc then
            return loc
        end
    end
    
    -- Check if LocalPlayer itself is the inventory
    if LocalPlayer:IsA("Model") then
        return LocalPlayer
    end
    
    -- Create folder as last resort
    local folder = Instance.new("Folder")
    folder.Name = "Inventory"
    folder.Parent = LocalPlayer
    return folder
end

-- ========== SPAWN EGG ==========
local function SpawnEgg()
    local eggData = EggData[Config.EggRarity] or EggData["Godly"]
    local success = false
    local spawned = nil
    
    print("🥚 Attempting to spawn: " .. eggData.Name)
    
    -- METHOD 1: Find and fire remote events
    local remotes = FindRemotes()
    local remoteKeywords = {
        "Give", "Add", "Spawn", "Get", "Collect", "Claim",
        "Egg", "Item", "Inventory", "Gift"
    }
    
    for _, remote in ipairs(remotes) do
        local name = (remote.Name or ""):lower()
        local shouldTry = false
        
        for _, keyword in ipairs(remoteKeywords) do
            if name:find(keyword:lower()) then
                shouldTry = true
                break
            end
        end
        
        if shouldTry and remote:IsA("RemoteEvent") then
            -- Try different argument patterns
            local patterns = {
                {eggData.ID, 1},
                {eggData.ID, LocalPlayer, 1},
                {eggData.Name, 1},
                {eggData.Name, LocalPlayer, 1},
                {eggData.ID, 1, "Inventory"},
                {eggData.ID, LocalPlayer, "Backpack"},
                {eggData.Name, 1, "Backpack"},
                {tonumber(eggData.ID) or 1, 1},
                {eggData},
                {eggData.ID, 1, LocalPlayer},
                {"Egg", eggData.ID, 1},
                {LocalPlayer, eggData.ID, 1},
                {eggData.Name, eggData.Rarity, 1},
                {eggData.ID, eggData.Value},
                {eggData.Name, eggData.Value},
            }
            
            for _, args in ipairs(patterns) do
                pcall(function()
                    remote:FireServer(unpack(args))
                    success = true
                    print("✅ Fired remote: " .. remote.Name)
                end)
                if success then break end
            end
            
            if success then break end
        end
    end
    
    -- METHOD 2: Try cloning existing egg
    if not success then
        local eggTemplates = {}
        local searchLocations = {ReplicatedStorage, ServerStorage, Workspace, game:GetService("Lighting")}
        
        for _, loc in ipairs(searchLocations) do
            pcall(function()
                for _, child in ipairs(loc:GetDescendants()) do
                    if child:IsA("Tool") or child:IsA("Model") then
                        local name = (child.Name or ""):lower()
                        local eggKeywords = {"egg", "godly", "legendary", "mythical", "rainbow", "celestial"}
                        for _, keyword in ipairs(eggKeywords) do
                            if name:find(keyword) then
                                table.insert(eggTemplates, child)
                                break
                            end
                        end
                    end
                end
            end)
        end
        
        if #eggTemplates > 0 then
            local template = eggTemplates[math.random(1, #eggTemplates)]
            local newEgg = template:Clone()
            newEgg.Name = eggData.Name
            newEgg.Parent = FindInventory()
            success = true
            spawned = newEgg
            print("✅ Cloned egg: " .. newEgg.Name)
        end
    end
    
    -- METHOD 3: Create new egg tool
    if not success then
        local tool = Instance.new("Tool")
        tool.Name = eggData.Name
        tool.RequiresHandle = false
        
        -- Handle
        local handle = Instance.new("Part")
        handle.Name = "Handle"
        handle.Size = Vector3.new(2, 3, 2)
        handle.Shape = Enum.PartType.Ball
        handle.Color = eggData.Color
        handle.Material = Enum.Material.Neon
        handle.Transparency = 0.1
        handle.Anchored = false
        handle.CanCollide = false
        handle.Parent = tool
        
        -- Glow
        local light = Instance.new("PointLight")
        light.Color = eggData.Color
        light.Brightness = 3
        light.Range = 15
        light.Parent = handle
        
        -- Tags
        local value = Instance.new("IntValue")
        value.Name = "Value"
        value.Value = eggData.Value
        value.Parent = tool
        
        local rarity = Instance.new("StringValue")
        rarity.Name = "Rarity"
        rarity.Value = eggData.Rarity
        rarity.Parent = tool
        
        local id = Instance.new("StringValue")
        id.Name = "EggID"
        id.Value = eggData.ID
        id.Parent = tool
        
        -- Inventory
        local inventory = FindInventory()
        tool.Parent = inventory
        success = true
        spawned = tool
        print("✅ Created tool: " .. tool.Name)
    end
    
    -- METHOD 4: Try all remotes with common names
    if not success then
        local commonNames = {
            "GiveItem", "AddItem", "SpawnItem", "GetItem",
            "CollectItem", "ClaimItem", "GiveEgg", "SpawnEgg",
            "CollectEgg", "ClaimEgg", "AddEgg", "GetEgg"
        }
        
        for _, name in ipairs(commonNames) do
            local remote = ReplicatedStorage:FindFirstChild(name)
            if remote and remote:IsA("RemoteEvent") then
                pcall(function()
                    remote:FireServer(eggData.ID, 1)
                    success = true
                    print("✅ Spawned via " .. name)
                end)
                if success then break end
            end
        end
    end
    
    -- METHOD 5: Fire all remotes with "egg" in name
    if not success then
        for _, remote in ipairs(remotes) do
            local name = (remote.Name or ""):lower()
            if name:find("egg") and remote:IsA("RemoteEvent") then
                pcall(function()
                    remote:FireServer(eggData.ID, 1, LocalPlayer)
                    success = true
                    print("✅ Spawned via " .. remote.Name)
                end)
                if success then break end
            end
        end
    end
    
    if success then
        print("✅ " .. eggData.Name .. " spawned successfully!")
        return true
    else
        print("❌ Could not spawn " .. eggData.Name)
        return false
    end
end

-- ========== CHECK INVENTORY ==========
local function CheckInventory()
    local inventory = FindInventory()
    if not inventory then
        print("❌ Could not find inventory")
        return {}
    end
    
    local eggs = {}
    for _, child in ipairs(inventory:GetChildren()) do
        local name = (child.Name or ""):lower()
        if name:find("egg") then
            table.insert(eggs, child.Name)
        end
    end
    
    if #eggs > 0 then
        print("📋 Eggs in inventory:")
        for _, egg in ipairs(eggs) do
            print("  🥚 " .. egg)
        end
    else
        print("📋 No eggs found in inventory")
    end
    
    return eggs
end

