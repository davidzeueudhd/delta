loadstring([[
print("🥚 EGG STEALER LOADED!")

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- ============================================================
-- FIND NEAREST EGG
-- ============================================================

local function FindNearestEgg()
    local char = LocalPlayer.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local nearest = nil
    local nearestDist = math.huge
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = (obj.Name or ""):lower()
            if name:find("egg") then
                local dist = (obj.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearestDist = dist
                    nearest = obj
                end
            end
        end
    end
    
    return nearest, nearestDist
end

-- ============================================================
-- TELEPORT & GRAB
-- ============================================================

local function TeleportAndGrab()
    local egg, dist = FindNearestEgg()
    
    if not egg then
        print("❌ No egg found!")
        return
    end
    
    print("🥚 Found egg: " .. egg.Name .. " (" .. math.floor(dist) .. " studs)")
    
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Teleport to egg
    root.CFrame = CFrame.new(egg.Position + Vector3.new(0, 2, 0))
    task.wait(0.2)
    
    -- Try to grab
    local grabbed = false
    
    local clickDetector = egg:FindFirstChild("ClickDetector")
    if clickDetector then
        clickDetector:FireClick(LocalPlayer)
        grabbed = true
        print("✅ Clicked!")
    end
    
    if not grabbed then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                egg.Touched:Fire(part)
            end
        end
        grabbed = true
        print("✅ Touched!")
    end
    
    if not grabbed then
        local prompt = egg:FindFirstChild("ProximityPrompt")
        if prompt then
            prompt:InputHoldEnd(LocalPlayer, Enum.UserInputType.MouseButton1)
            grabbed = true
            print("✅ Prompt!")
        end
    end
    
    if grabbed then
        print("✅ EGG GRABBED!")
    else
        print("⚠️ Click the egg manually!")
    end
end

-- ============================================================
-- GUI
-- ============================================================

local function CreateGUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "EggStealer"
    screenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 280, 0, 160)
    frame.Position = UDim2.new(0.5, -140, 0.5, -80)
    frame.BackgroundColor3 = Color3.fromRGB(20, 25, 35)
    frame.BackgroundTransparency = 0.1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screenGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = frame
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundColor3 = Color3.fromRGB(255, 180, 50)
    title.BackgroundTransparency = 0.3
    title.Text = "🥚 EGG STEALER"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.GothamBold
    title.Parent = frame
    
    -- Status
    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 25)
    status.Position = UDim2.new(0, 0, 0, 45)
    status.BackgroundTransparency = 1
    status.Text = "🟢 Ready"
    status.TextColor3 = Color3.fromRGB(0, 255, 100)
    status.TextScaled = true
    status.Font = Enum.Font.GothamBold
    status.Parent = frame
    
    -- STEAL Button
    local stealBtn = Instance.new("TextButton")
    stealBtn.Size = UDim2.new(0.8, 0, 0, 45)
    stealBtn.Position = UDim2.new(0.1, 0, 0, 85)
    stealBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
    stealBtn.Text = "🥚 STEAL EGG"
    stealBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    stealBtn.TextScaled = true
    stealBtn.Font = Enum.Font.GothamBold
    stealBtn.BorderSizePixel = 0
    stealBtn.Parent = frame
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = stealBtn
    
    -- Close Button
    local close = Instance.new("TextButton")
    close.Size = UDim2.new(0, 25, 0, 25)
    close.Position = UDim2.new(1, -35, 0, 6)
    close.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    close.Text = "✕"
    close.TextColor3 = Color3.fromRGB(255, 255, 255)
    close.TextScaled = true
    close.Font = Enum.Font.GothamBold
    close.BorderSizePixel = 0
    close.Parent = frame
    
    local closeCorner = Instance.new("UICorner")
    closeCorner.CornerRadius = UDim.new(0, 8)
    closeCorner.Parent = close
    
    -- Button Functions
    stealBtn.MouseButton1Click:Connect(function()
        status.Text = "⏳ Stealing..."
        status.TextColor3 = Color3.fromRGB(255, 200, 0)
        TeleportAndGrab()
        status.Text = "✅ Done!"
        status.TextColor3 = Color3.fromRGB(0, 255, 100)
        task.wait(2)
        status.Text = "🟢 Ready"
    end)
    
    close.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        print("❌ GUI closed!")
    end)
    
    -- Toggle with R
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.R then
            frame.Visible = not frame.Visible
        end
    end)
end

task.wait(0.5)
CreateGUI()

print("🥚 EGG STEALER READY!")
print("📌 Press R to toggle GUI")
print("🥚 Click 'STEAL EGG' to steal the nearest egg!")
]])()
